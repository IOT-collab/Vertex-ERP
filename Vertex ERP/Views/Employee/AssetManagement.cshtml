@model dynamic
@{
    ViewData["Title"] = "Asset Management";
    Layout = "_Layout";

    var totalIssuedAssets = Model?.TotalIssuedAssets ?? "";
    var totalLaptops = Model?.TotalLaptops ?? "";
    var totalAccessories = Model?.TotalAccessories ?? "";
    var pendingRepairCount = Model?.PendingRepairCount ?? "";
    var assetList = Model?.AssetList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<!-- FontAwesome Icons CDN Link -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/AssetManagement.css" />

<div class="asset-container">
    <!-- Header Section with Mobile-Optimized Back Arrow -->
    <header class="page-header">
        <div class="header-title-group">
            <button type="button" class="btn-back" onclick="goBack()" aria-label="Go Back" title="Go Back">
                <i class="fas fa-arrow-left"></i>
            </button>

            <div class="icon-avatar">
                <i class="fas fa-laptop-house"></i>
            </div>
            <div class="header-text-content">
                <h1>Asset Management</h1>
                <p>Track and manage company hardware, laptops, and peripheral accessories assigned to employees.</p>
            </div>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="fas fa-search search-icon"></i>
                <input type="text" placeholder="Search asset tag, employee..." class="form-control-search" />
            </div>
            <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("IssueAsset", "Asset")'">
                <i class="fas fa-plus"></i> <span>Issue New Asset</span>
            </button>
        </div>
    </header>

    <!-- Top KPI Metrics -->
    <section class="metrics-grid">
        <div class="metric-card">
            <div class="metric-info">
                <span class="label">Total Issued Assets</span>
                <span class="value">@totalIssuedAssets</span>
            </div>
            <div class="metric-icon icon-blue">
                <i class="fas fa-boxes-stacked"></i>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="label">Laptops & Workstations</span>
                <span class="value">@totalLaptops <small>Units</small></span>
            </div>
            <div class="metric-icon icon-purple">
                <i class="fas fa-laptop"></i>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="label">Accessories (Mouse/Keyboard/Audio)</span>
                <span class="value">@totalAccessories <small>Items</small></span>
            </div>
            <div class="metric-icon icon-emerald">
                <i class="fas fa-keyboard"></i>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-info">
                <span class="label">Pending Return / Repair</span>
                <span class="value text-amber">@pendingRepairCount</span>
            </div>
            <div class="metric-icon icon-amber">
                <i class="fas fa-tools"></i>
            </div>
        </div>
    </section>

    <!-- Main Content Table Card -->
    <main class="glass-card">
        <div class="card-header flex-between">
            <div>
                <h2>Issued Hardware & Accessories Inventory</h2>
                <p class="subtitle">Live record of hardware allocated across active employees</p>
            </div>
            <div class="filter-actions">
                <select class="select-clean">
                    <option value="">All Category</option>
                    <option value="Laptop">Laptops</option>
                    <option value="Monitors">Monitors</option>
                    <option value="Peripherals">Accessories (Mouse/Keyboard)</option>
                </select>
                <button type="button" class="btn btn-outline btn-sm">
                    <i class="fas fa-filter"></i> <span>Filter</span>
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="asset-table">
                    <thead>
                        <tr>
                            <th>Asset Details</th>
                            <th>Category</th>
                            <th>Assigned To</th>
                            <th>Asset Tag / Serial No.</th>
                            <th>Issue Date</th>
                            <th>Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (assetList != null && assetList.Any())
                        {
                            foreach (var item in assetList)
                            {
                                <tr>
                                    <td>
                                        <div class="asset-item-info">
                                            <div class="asset-icon-box @item.IconBgClass">
                                                <i class="@item.IconClass"></i>
                                            </div>
                                            <div>
                                                <strong class="asset-name">@item.AssetName</strong>
                                                <small class="text-muted">@item.AssetSubtitle</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="category-chip">@item.Category</span></td>
                                    <td>
                                        <div class="emp-profile">
                                            <div class="emp-avatar">@item.EmployeeInitials</div>
                                            <div>
                                                <div class="emp-name">@item.EmployeeName</div>
                                                <small class="text-muted">@item.EmployeeRole</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="asset-tag">@item.AssetTag</code></td>
                                    <td>@item.IssueDate</td>
                                    <td>
                                        <span class="status-badge @item.StatusClass">
                                            <i class="@item.StatusIcon"></i> @item.StatusText
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <button type="button" class="icon-btn" title="View Details" onclick="viewAsset('@item.Id')"><i class="fas fa-eye"></i></button>
                                        <button type="button" class="icon-btn" title="Return/Revoke" onclick="returnAsset('@item.Id')"><i class="fas fa-undo-alt"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state-row">
                                    <i class="fas fa-folder-open"></i>
                                    <span>No asset inventory records found.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<!-- Safe Back Navigation & Action Scripts -->
<script>
    function goBack() {
        if (window.history.length > 1 && document.referrer !== "") {
            window.history.back();
        } else {
            window.location.href = '@Url.Action("Index", "Employee")';
        }
    }

    function viewAsset(id) {
        // Handle view detail action logic here
    }

    function returnAsset(id) {
        // Handle return / revoke asset action logic here
    }
</script>