@model dynamic
@{
    ViewData["Title"] = Model?.Title ?? "Employee Documents";
    Layout = "_Layout";

    // Dynamic metrics & statistics with fallbacks
    var totalDocuments = Model?.TotalDocuments ?? 0;
    var pendingReview = Model?.PendingReview ?? 0;
    var expiringSoon = Model?.ExpiringSoon ?? 0;
    var verifiedRate = Model?.VerifiedRate ?? "0%";

    // List of dynamic documents from backend
    IEnumerable<dynamic> documentsList = Model?.Documents ?? new List<dynamic>();

    // Action URLs
    var uploadUrl = Model?.UploadUrl ?? Url.Action("UploadDocument", "HR");
    var getDocumentUrl = Model?.GetDocumentUrl ?? Url.Action("ViewDocument", "HR");
}
<link href="~/css/empdocuments.css" rel="stylesheet" />

<!-- FontAwesome CDN for modern icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="emp-docs-container">
    <!-- Top Header -->
    <div class="header-section">
        <div class="header-left">
            <button class="btn-back" id="btnBack" onclick="goBack()" title="Go Back" aria-label="Go Back">
                <i class="fa-solid fa-arrow-left"></i>
            </button>
            <div>
                <h1 class="page-title">Employee Documents</h1>
                <p class="page-subtitle">Manage, verify, and store employee records & compliance files</p>
            </div>
        </div>
        <a href="@uploadUrl" class="btn-primary">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span>Upload Document</span>
        </a>
    </div>

    <!-- Stats Cards Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-content">
                <div>
                    <span class="stat-title">Total Documents</span>
                    <h3 class="stat-value">@totalDocuments</h3>
                </div>
                <div class="stat-icon icon-blue">
                    <i class="fa-solid fa-folder-closed"></i>
                </div>
            </div>
            <p class="stat-meta text-emerald"><i class="fa-solid fa-arrow-up"></i> Active Repository</p>
        </div>

        <div class="stat-card">
            <div class="stat-content">
                <div>
                    <span class="stat-title">Pending Review</span>
                    <h3 class="stat-value">@pendingReview</h3>
                </div>
                <div class="stat-icon icon-amber">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
            <p class="stat-meta text-amber">Requires verification</p>
        </div>

        <div class="stat-card">
            <div class="stat-content">
                <div>
                    <span class="stat-title">Expiring Soon</span>
                    <h3 class="stat-value">@expiringSoon</h3>
                </div>
                <div class="stat-icon icon-orange">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
            <p class="stat-meta text-orange">Action required &lt;30 days</p>
        </div>

        <div class="stat-card">
            <div class="stat-content">
                <div>
                    <span class="stat-title">Verified Rate</span>
                    <h3 class="stat-value">@verifiedRate</h3>
                </div>
                <div class="stat-icon icon-green">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
            </div>
            <p class="stat-meta text-emerald">Compliance compliant</p>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-panel">
        <!-- Filter Controls Bar -->
        <div class="controls-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="searchInput" placeholder="Search by document, employee or ID..." onkeyup="filterTable()" />
            </div>

            <div class="filter-group">
                <select class="custom-select" id="categoryFilter" onchange="filterTable()">
                    <option value="All">All Categories</option>
                    <option value="Contracts">Contracts & Agreements</option>
                    <option value="KYC">KYC & Identification</option>
                    <option value="Tax">Tax & Financial</option>
                    <option value="Certifications">Certifications</option>
                </select>

                <select class="custom-select" id="statusFilter" onchange="filterTable()">
                    <option value="All">All Statuses</option>
                    <option value="Verified">Verified</option>
                    <option value="Pending">Pending Review</option>
                    <option value="Expiring">Expiring Soon</option>
                </select>
            </div>
        </div>

        <!-- Table View / Dynamic Feed -->
        <div class="table-wrapper">
            <table class="data-table" id="docsTable">
                <thead>
                    <tr>
                        <th>Document Name</th>
                        <th>Employee Details</th>
                        <th>Category</th>
                        <th>Upload Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (documentsList != null && documentsList.Any())
                    {
                        foreach (dynamic doc in documentsList)
                        {
                            if (doc == null) continue;

                            var docId = doc.Id?.ToString() ?? "";
                            var docName = doc.Name?.ToString() ?? "Untitled Document";
                            var docCode = doc.Code?.ToString() ?? "DOC-000";
                            var fileSize = doc.FileSize?.ToString() ?? "1.0 MB";
                            var fileExtension = (doc.Extension?.ToString() ?? "pdf").ToLower();

                            var empName = doc.EmployeeName?.ToString() ?? "Unknown Employee";
                            var empMeta = doc.EmployeeMeta?.ToString() ?? "EMP-000 • General";
                            var category = doc.Category?.ToString() ?? "General";
                            var uploadDate = doc.UploadDate?.ToString() ?? "—";
                            var expiryDate = doc.ExpiryDate?.ToString() ?? "—";
                            var status = doc.Status?.ToString() ?? "Verified";

                            // Determine status UI badge class & icon
                            string badgeClass = "badge-green";
                            string statusIcon = "fa-circle-check";
                            if (status.Contains("Pending", StringComparison.OrdinalIgnoreCase)) { badgeClass = "badge-amber"; statusIcon = "fa-clock"; }
                            else if (status.Contains("Expiring", StringComparison.OrdinalIgnoreCase)) { badgeClass = "badge-orange"; statusIcon = "fa-triangle-exclamation"; }

                            // Determine icon type
                            string iconClass = fileExtension == "docx" || fileExtension == "doc" ? "fa-file-word word" : "fa-file-pdf pdf";
                            string viewUrl = $"{getDocumentUrl}/{docId}";

                            <tr data-category="@category" data-status="@status">
                                <td>
                                    <div class="doc-title-cell">
                                        <i class="fa-solid @iconClass doc-type-icon"></i>
                                        <div>
                                            <span class="doc-name">@docName</span>
                                            <span class="doc-sub">@docCode • @fileSize</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="emp-name">@empName</div>
                                    <div class="emp-sub">@empMeta</div>
                                </td>
                                <td><span class="category-chip">@category</span></td>
                                <td>@uploadDate</td>
                                <td class="@(status.Contains("Expiring") ? "text-orange" : "")">@expiryDate</td>
                                <td><span class="badge @badgeClass"><i class="fa-solid @statusIcon"></i> @status</span></td>
                                <td class="text-right">
                                    <a href="@viewUrl" class="btn-action" title="View Document"><i class="fa-regular fa-eye"></i></a>
                                    <a href="@viewUrl?download=true" class="btn-action" title="Download"><i class="fa-solid fa-download"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state-cell">
                                <div class="empty-state">
                                    <i class="fa-solid fa-folder-open empty-icon"></i>
                                    <p>No documents found in the system.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterTable() {
        const input = document.getElementById("searchInput").value.toUpperCase();
        const categoryFilter = document.getElementById("categoryFilter").value;
        const statusFilter = document.getElementById("statusFilter").value;

        const table = document.getElementById("docsTable");
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            const row = tr[i];
            if (row.classList.contains("empty-state-cell") || row.querySelector(".empty-state")) continue;

            const textContent = row.textContent || row.innerText;
            const rowCategory = row.getAttribute("data-category") || "";
            const rowStatus = row.getAttribute("data-status") || "";

            const matchesSearch = textContent.toUpperCase().indexOf(input) > -1;
            const matchesCategory = (categoryFilter === "All" || rowCategory === categoryFilter);
            const matchesStatus = (statusFilter === "All" || rowStatus.includes(statusFilter));

            if (matchesSearch && matchesCategory && matchesStatus) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }
    }

    function goBack() {
        if (window.history.length > 1 && document.referrer !== "") {
            window.history.back();
        } else {
            window.location.href = '@Url.Action("Index", "Dashboard")';
        }
    }
</script>