@model dynamic

@{
    ViewData["Title"] = "Expense Claims";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/expenseclaim.css" rel="stylesheet" />

<div class="exp-container">
    <!-- Header Section -->
    <div class="exp-header">
        <div class="exp-header-main">
            <button class="exp-btn-icon" onclick="history.back()" title="Go Back">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
            </button>
            <div>
                <h1 class="exp-title">Expense Claims</h1>
                <p class="exp-subtitle">Manage employee business travel, hotel, cab & food reimbursements</p>
            </div>
        </div>

        <div class="exp-header-actions">
            <button class="exp-btn-primary" onclick="openClaimModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                <span>New Expense Claim</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="exp-grid-stats">
        <div class="exp-stat-card">
            <div class="exp-stat-top">
                <div>
                    <span class="exp-stat-label">Total Claimed</span>
                    <h3 class="exp-stat-value">@(Model?.TotalClaimedAmount ?? "₹0")</h3>
                </div>
                <div class="exp-icon-box icon-blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                </div>
            </div>
            <span class="exp-stat-sub text-emerald">@(Model?.TotalClaimsCount ?? "0") Claims Submitted</span>
        </div>

        <div class="exp-stat-card">
            <div class="exp-stat-top">
                <div>
                    <span class="exp-stat-label">Pending Approval</span>
                    <h3 class="exp-stat-value">@(Model?.PendingAmount ?? "₹0")</h3>
                </div>
                <div class="exp-icon-box icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
            </div>
            <span class="exp-stat-sub text-amber">@(Model?.PendingClaimsCount ?? "0") Claims Under Review</span>
        </div>

        <div class="exp-stat-card">
            <div class="exp-stat-top">
                <div>
                    <span class="exp-stat-label">Approved Amount</span>
                    <h3 class="exp-stat-value">@(Model?.ApprovedAmount ?? "₹0")</h3>
                </div>
                <div class="exp-icon-box icon-green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
            </div>
            <span class="exp-stat-sub text-emerald">@(Model?.ApprovedClaimsCount ?? "0") Claims Settled</span>
        </div>

        <div class="exp-stat-card">
            <div class="exp-stat-top">
                <div>
                    <span class="exp-stat-label">Rejected Claims</span>
                    <h3 class="exp-stat-value">@(Model?.RejectedAmount ?? "₹0")</h3>
                </div>
                <div class="exp-icon-box icon-purple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                </div>
            </div>
            <span class="exp-stat-sub text-red">@(Model?.RejectedClaimsCount ?? "0") Claim Rejected</span>
        </div>
    </div>

    <!-- Main Content Panel -->
    <div class="exp-main-panel">
        <div class="exp-controls">
            <div class="exp-search-box">
                <svg class="exp-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="expSearchInput" placeholder="Search claims by title or type..." onkeyup="filterClaims()" />
            </div>

            <select class="exp-select" id="typeFilter" onchange="filterClaims()">
                <option value="All">All Categories</option>
                <option value="Hotel">Hotel Stay</option>
                <option value="Cab">Cab & Travel</option>
                <option value="Food">Food & Meals</option>
                <option value="Other">Other Expenses</option>
            </select>
        </div>

        <!-- Expense Claims List Table -->
        <div class="exp-table-responsive">
            <table class="exp-table" id="claimsTable">
                <thead>
                    <tr>
                        <th>Claim Details</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Receipt</th>
                        <th>Status</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ClaimsList != null && Model.ClaimsList.Count > 0)
                    {
                        foreach (var claim in Model.ClaimsList)
                        {
                            <tr>
                                <td>
                                    <div class="exp-claim-info">
                                        <span class="claim-title">@claim.Title</span>
                                        <span class="claim-emp">Emp: @claim.EmployeeName</span>
                                    </div>
                                </td>
                                <td><span class="badge @claim.CategoryBadgeClass">@claim.Category</span></td>
                                <td>@claim.Date</td>
                                <td class="exp-amount">@claim.Amount</td>
                                <td><a href="@claim.ReceiptUrl" target="_blank" class="exp-link">@claim.ReceiptName</a></td>
                                <td><span class="status-badge @claim.StatusBadgeClass">@claim.Status</span></td>
                                <td style="text-align: right;">
                                    <button class="exp-btn-view" onclick="viewClaimDetails('@claim.Id')">View</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: #64748b; padding: 2rem;">No expense claims found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Expense Claim Modal Popup -->
<div class="exp-modal-overlay" id="claimModal">
    <div class="exp-modal">
        <div class="exp-modal-header">
            <h2>Submit Expense Claim</h2>
            <button class="exp-modal-close" onclick="closeClaimModal()">&times;</button>
        </div>
        <form id="expForm" method="post" action="@Url.Action("SubmitClaim", "Expense")" enctype="multipart/form-data">
            <div class="exp-modal-body">
                <div class="exp-form-group">
                    <label>Claim Category</label>
                    <select class="exp-input" name="Category" required>
                        <option value="">Select Category</option>
                        <option value="Hotel">Hotel & Accommodation</option>
                        <option value="Cab">Cab / Taxi / Travel</option>
                        <option value="Food">Food & Business Meals</option>
                        <option value="Flight">Flight / Train Ticket</option>
                        <option value="Other">Other Allowance</option>
                    </select>
                </div>

                <div class="exp-form-group">
                    <label>Expense Title / Purpose</label>
                    <input type="text" class="exp-input" name="Title" placeholder="e.g. Hotel stay for Mumbai client visit" required />
                </div>

                <div class="exp-form-row">
                    <div class="exp-form-group">
                        <label>Date of Expense</label>
                        <input type="date" class="exp-input" name="Date" required />
                    </div>
                    <div class="exp-form-group">
                        <label>Amount (₹)</label>
                        <input type="number" class="exp-input" name="Amount" placeholder="0.00" min="1" required />
                    </div>
                </div>

                <div class="exp-form-group">
                    <label>Attach Bill / Receipt</label>
                    <div class="exp-file-upload">
                        <input type="file" id="billFile" name="ReceiptFile" hidden required onchange="updateFileName(this)" />
                        <label for="billFile" class="exp-file-label">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                            <span id="fileLabelText">Click to upload Invoice or Receipt (PDF, JPG, PNG)</span>
                        </label>
                    </div>
                </div>

                <div class="exp-form-group">
                    <label>Remarks / Description</label>
                    <textarea class="exp-input exp-textarea" name="Remarks" rows="3" placeholder="Add additional details about the expense..."></textarea>
                </div>
            </div>

            <div class="exp-modal-footer">
                <button type="button" class="exp-btn-secondary" onclick="closeClaimModal()">Cancel</button>
                <button type="submit" class="exp-btn-primary">Submit Claim</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openClaimModal() {
        document.getElementById("claimModal").style.display = "flex";
    }

    function closeClaimModal() {
        document.getElementById("claimModal").style.display = "none";
    }

    function updateFileName(input) {
        const textElement = document.getElementById("fileLabelText");
        if (input.files && input.files[0]) {
            textElement.textContent = "Selected: " + input.files[0].name;
        }
    }

    function viewClaimDetails(id) {
        // Handle view action logic or redirect
        location.href = '@Url.Action("Details", "Expense")?id=' + id;
    }

    function filterClaims() {
        const input = document.getElementById("expSearchInput").value.toUpperCase();
        const categoryFilter = document.getElementById("typeFilter").value.toUpperCase();
        const table = document.getElementById("claimsTable");
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            const tdTitle = tr[i].getElementsByTagName("td")[0];
            const tdCategory = tr[i].getElementsByTagName("td")[1];

            if (tdTitle && tdCategory) {
                const titleText = tdTitle.textContent || tdTitle.innerText;
                const categoryText = tdCategory.textContent || tdCategory.innerText;

                const matchesSearch = titleText.toUpperCase().indexOf(input) > -1;
                const matchesCategory = categoryFilter === "ALL" || categoryText.toUpperCase().indexOf(categoryFilter) > -1;

                if (matchesSearch && matchesCategory) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>