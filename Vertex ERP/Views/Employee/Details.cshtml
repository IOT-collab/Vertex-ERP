@model VertexERP.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/AddEmpHrm.css" rel="stylesheet" asp-append-version="true" />

<div class="hrms-page">
    <div class="page-header"><div class="header-text"><h2>@Model.FullName</h2><p>@Model.EmployeeCode · @Model.Designation · @Model.Department</p></div></div>
    <div class="form-container-wrapper">
        <div class="form-grid">
            <div class="form-main-section">
                <div class="section-divider"><span>Personal Details</span></div>
                <div class="form-row"><div class="form-group"><label>Email</label><strong>@Model.Email</strong></div><div class="form-group"><label>Phone Number</label><strong>@Model.PhoneNumber</strong></div></div>
                <div class="form-row"><div class="form-group"><label>Date of Birth</label><strong>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Not provided")</strong></div><div class="form-group"><label>Gender</label><strong>@(Model.Gender ?? "Not provided")</strong></div></div>
                <div class="form-group"><label>Address</label><strong>@(string.Join(", ", new[] { Model.Address, Model.City, Model.State }.Where(value => !string.IsNullOrWhiteSpace(value))) is var address && address.Length > 0 ? address : "Not provided")</strong></div>
            </div>
            <div class="form-side-section"><div class="config-card"><h3>Employment Details</h3><div class="form-group"><label>Joining Date</label><strong>@Model.JoiningDate.ToString("dd MMM yyyy")</strong></div><div class="form-group"><label>Reporting Manager</label><strong>@(Model.ReportingManager?.FullName ?? "Not assigned")</strong></div><div class="form-group"><label>Employment Type</label><strong>@Model.EmploymentType</strong></div><div class="form-group"><label>Status</label><strong>@Model.EmployeeStatus</strong></div><div class="form-group"><label>Active</label><strong>@(Model.IsActive ? "Yes" : "No")</strong></div></div></div>
        </div>
        <div class="form-actions-footer"><a asp-controller="Employee" asp-action="Index" class="btn-cancel">Back</a><a asp-controller="Employee" asp-action="Edit" asp-route-id="@Model.Id" class="btn-submit">Edit Employee</a></div>
    </div>
</div>
