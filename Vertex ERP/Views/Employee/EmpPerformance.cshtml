@{
    ViewData["Title"] = "Performance & Reviews";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/empperformance.css" rel="stylesheet" />


<div class="perf-dashboard-wrapper">

    <!-- Page Header -->
    <div class="dashboard-header">
        <div class="header-text">
            <h2>Performance &amp; Employee Reviews</h2>
            <p>Track your KPIs, self-assessments, manager reviews, and active goals.</p>
        </div>
        <div class="header-actions">
            <button class="btn-primary-glow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Self Assessment
            </button>
            <button class="btn-secondary-glow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Download Review Letter
            </button>
        </div>
    </div>

    <!-- Top Summary Performance Cards -->
    <div class="stats-grid">
        <div class="stat-card accent-purple">
            <div class="stat-icon icon-rating">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Overall Performance Score</span>
                <span class="stat-value">4.8 <small>/ 5.0</small></span>
                <small class="stat-meta text-purple">★ Exceeds Expectations</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-kpi">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">KPI Completion Rate</span>
                <span class="stat-value">88%</span>
                <small class="stat-meta text-green">↑ 6% higher than Q1</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-review">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Review Cycle</span>
                <span class="stat-value">Q2 - 2026</span>
                <small class="stat-meta text-amber">Status: Manager Submitted</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-goals">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Goals &amp; Milestones</span>
                <span class="stat-value">12 / 14</span>
                <small class="stat-meta text-green">2 In Progress</small>
            </div>
        </div>
    </div>

    <!-- Main Grid: KPIs & Review Feedback -->
    <div class="dashboard-grid">

        <!-- LEFT: KPI Metrics & Target Progress -->
        <div class="glass-card kpi-section">
            <div class="card-header">
                <div>
                    <h3>Key Performance Indicators (KPIs)</h3>
                    <p class="subtitle">Current Evaluation Period (Q2 2026)</p>
                </div>
                <span class="badge-cycle">Weightage Total: 100%</span>
            </div>

            <div class="kpi-list">
                <!-- KPI Item 1 -->
                <div class="kpi-item">
                    <div class="kpi-head">
                        <div class="kpi-title">
                            <strong>Project Deliverables &amp; Code Quality</strong>
                            <span class="kpi-weight">Weightage: 40%</span>
                        </div>
                        <span class="status-badge badge-success">On Track</span>
                    </div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-info">
                            <span>Target: 95% Code Coverage &amp; Zero Critical Bugs</span>
                            <span class="progress-perc">92%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill fill-purple" style="width: 92%;"></div>
                        </div>
                    </div>
                </div>

                <!-- KPI Item 2 -->
                <div class="kpi-item">
                    <div class="kpi-head">
                        <div class="kpi-title">
                            <strong>UI/UX Response Time Optimization</strong>
                            <span class="kpi-weight">Weightage: 30%</span>
                        </div>
                        <span class="status-badge badge-success">Exceeded</span>
                    </div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-info">
                            <span>Target: &lt; 200ms Page Load Time</span>
                            <span class="progress-perc">100%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill fill-green" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>

                <!-- KPI Item 3 -->
                <div class="kpi-item">
                    <div class="kpi-head">
                        <div class="kpi-title">
                            <strong>Team Collaboration &amp; Mentorship</strong>
                            <span class="kpi-weight">Weightage: 20%</span>
                        </div>
                        <span class="status-badge badge-warning">Needs Review</span>
                    </div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-info">
                            <span>Target: Conduct 4 Knowledge Sharing Sessions</span>
                            <span class="progress-perc">75%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill fill-amber" style="width: 75%;"></div>
                        </div>
                    </div>
                </div>

                <!-- KPI Item 4 -->
                <div class="kpi-item">
                    <div class="kpi-head">
                        <div class="kpi-title">
                            <strong>Documentation &amp; Process Adherence</strong>
                            <span class="kpi-weight">Weightage: 10%</span>
                        </div>
                        <span class="status-badge badge-success">On Track</span>
                    </div>
                    <div class="progress-bar-wrapper">
                        <div class="progress-info">
                            <span>Target: Complete Architecture Docs</span>
                            <span class="progress-perc">85%</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill fill-blue" style="width: 85%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Manager Feedback & Appraisal Notes -->
        <div class="glass-card review-notes-card">
            <div class="card-header">
                <h3>Latest Review Feedback</h3>
                <span class="badge-approved">✓ Manager Verified</span>
            </div>

            <div class="manager-meta">
                <div class="reviewer-avatar">RK</div>
                <div class="reviewer-info">
                    <strong>Rahul Kapoor</strong>
                    <span>Engineering Director • Evaluated on 15 Jul 2026</span>
                </div>
            </div>

            <div class="feedback-blocks">
                <div class="feedback-box">
                    <label class="text-green">Key Strengths</label>
                    <p>Exceptional work on modernizing front-end components and delivering responsive layouts on tight schedules. Great ownership of code quality.</p>
                </div>

                <div class="feedback-box">
                    <label class="text-amber">Areas of Growth</label>
                    <p>Focus more on cross-team documentation and active participation in architectural review discussions for upcoming quarterly sprints.</p>
                </div>
            </div>

            <div class="appraisal-summary-footer">
                <div class="appraisal-val">
                    <span>Recommended Grade</span>
                    <strong>A+ (Top Performer)</strong>
                </div>
                <button class="btn-sm-outline">View Complete History</button>
            </div>
        </div>

    </div>

    <!-- BOTTOM: Skills Matrix & Peer Kudos -->
    <div class="dashboard-grid bottom-grid">
        <!-- Skills Radar / Matrix -->
        <div class="glass-card">
            <div class="card-header">
                <h3>Technical &amp; Soft Skills</h3>
                <span class="badge-tag">Endorsed</span>
            </div>

            <div class="skills-chips">
                <div class="skill-pill">
                    <span>React / Razor Views</span>
                    <strong class="text-purple">95%</strong>
                </div>
                <div class="skill-pill">
                    <span>Responsive UI Architecture</span>
                    <strong class="text-green">98%</strong>
                </div>
                <div class="skill-pill">
                    <span>System Design</span>
                    <strong class="text-blue">82%</strong>
                </div>
                <div class="skill-pill">
                    <span>Team Collaboration</span>
                    <strong class="text-amber">90%</strong>
                </div>
                <div class="skill-pill">
                    <span>Agile / Sprint Planning</span>
                    <strong class="text-purple">88%</strong>
                </div>
            </div>
        </div>

        <!-- Peer Appreciations / Badges -->
        <div class="glass-card">
            <div class="card-header">
                <h3>Badges &amp; Appreciations</h3>
                <span class="badge-tag">3 Badges</span>
            </div>

            <div class="badge-list">
                <div class="badge-item">
                    <div class="badge-icon">🏆</div>
                    <div class="badge-details">
                        <strong>Star Performer Q1</strong>
                        <span>Awarded for delivering high-impact UI components.</span>
                    </div>
                </div>
                <div class="badge-item">
                    <div class="badge-icon">⚡</div>
                    <div class="badge-details">
                        <strong>Speed Demon</strong>
                        <span>Fastest turn-around time on bug resolution.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>