@model VertexERP.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/AddEmpHrm.css" rel="stylesheet" asp-append-version="true" />

<div class="hrms-page">
    <div class="page-header"><div class="header-text"><h2>Delete Employee</h2><p>@Model.FullName — @Model.EmployeeCode</p></div></div>
    <div class="form-container-wrapper">
        <div class="employee-onboarding-form">
            <div class="form-main-section">
                <h3>Are you sure you want to delete this employee?</h3>
                <p>This removes the employee record. Employees reporting to this employee will remain and become unassigned.</p>
            </div>
            <form asp-controller="Employee" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="form-actions-footer"><a asp-controller="Employee" asp-action="Index" class="btn-cancel">Cancel</a><button type="submit" class="btn-submit">Delete Employee</button></div>
            </form>
        </div>
    </div>
</div>
