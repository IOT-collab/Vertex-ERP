@*
    ASP.NET Core MVC ERP Master Dashboard View
*@
@{
    ViewData["Title"] = "ERP Master Dashboard";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/dashboard.css" rel="stylesheet" />

<div class="dashboard">

    <!-- Top Navigation & Header Row -->
    <header class="page-header">
        <div class="header-text">
            <span class="system-badge">Enterprise Resource Planning v2.4</span>
            <h2>Enterprise Overview</h2>
            <p>Welcome back, <strong>Admin</strong>. Here is your operational summary for today.</p>
        </div>

        <div class="header-actions">
            <!-- Sleek Upgraded Search Bar -->
            <div class="search-bar">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Search POs, Employees, Items..." />
                <span class="search-shortcut">⌘</span>
            </div>

            <div class="date-box">
                <span class="calendar-icon">📅</span>
                <div>
                    <strong>@DateTime.Now.ToString("dddd")</strong>
                    <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            <button class="btn-icon-bell" title="Notifications">
                🔔 <span class="dot"></span>
            </button>
        </div>
    </header>

    <!-- Top KPI Cards Grid -->
    <section class="card-row">
        <div class="dashboard-card status-blue">
            <div class="card-meta">
                <span>Total Workforce</span>
                <div class="card-icon blue-icon">👥</div>
            </div>
            <div class="card-body-metrics">
                <h2>142</h2>
                <span class="trend up">▲ +6 this month</span>
            </div>
            <div class="card-footer-info">134 Onboarding Complete</div>
        </div>

        <div class="dashboard-card status-green">
            <div class="card-meta">
                <span>Present Today</span>
                <div class="card-icon green-icon">🎯</div>
            </div>
            <div class="card-body-metrics">
                <h2>128</h2>
                <span class="trend neutral">90.1% Rate</span>
            </div>
            <div class="card-footer-info">10 On Field / Client Visit</div>
        </div>

        <div class="dashboard-card status-orange">
            <div class="card-meta">
                <span>Pending Approvals</span>
                <div class="card-icon orange-icon">⏳</div>
            </div>
            <div class="card-body-metrics">
                <h2>14</h2>
                <span class="trend warning">Needs Action</span>
            </div>
            <div class="card-footer-info">8 Leaves, 6 Purchase Orders</div>
        </div>

        <div class="dashboard-card status-purple">
            <div class="card-meta">
                <span>Inventory Items</span>
                <div class="card-icon purple-icon">📦</div>
            </div>
            <div class="card-body-metrics">
                <h2>1,240</h2>
                <span class="trend down">⚠ 18 Low Stock</span>
            </div>
            <div class="card-footer-info">4 Re-orders Auto-Triggered</div>
        </div>
    </section>

    <!-- Main Workspace Grid (Directory Table + Visual Stats) -->
    <section class="content-row">

        <!-- Table Column -->
        <div class="table-card-wrapper">
            <div class="table-box">
                <div class="box-header">
                    <div>
                        <h3>Recent Active Directory</h3>
                        <p class="sub-text">Real-time status of cross-departmental personnel</p>
                    </div>
                    <div class="table-controls">
                        <select class="select-filter">
                            <option>All Departments</option>
                            <option>IT & Systems</option>
                            <option>HR & Talent</option>
                            <option>Accounts</option>
                            <option>Production</option>
                        </select>
                        <span class="badge-count">6 Updates</span>
                    </div>
                </div>

                <div class="table-responsive-container">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Emp ID</th>
                                <th>Employee Details</th>
                                <th>Department</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="id-col">#101</td>
                                <td>
                                    <div class="user-meta">
                                        <span class="avatar-placeholder">RS</span>
                                        <div>
                                            <strong>Rahul Sharma</strong>
                                            <small>rahul.s@company.com</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dept-tag">IT Team</span></td>
                                <td>Sr. Developer</td>
                                <td><span class="status status-active">Active</span></td>
                                <td><button class="btn-action">View</button></td>
                            </tr>
                            <tr>
                                <td class="id-col">#102</td>
                                <td>
                                    <div class="user-meta">
                                        <span class="avatar-placeholder">AK</span>
                                        <div>
                                            <strong>Amit Kumar</strong>
                                            <small>amit.k@company.com</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dept-tag">HR & Talent</span></td>
                                <td>HR Executive</td>
                                <td><span class="status status-leave">On Leave</span></td>
                                <td><button class="btn-action">View</button></td>
                            </tr>
                            <tr>
                                <td class="id-col">#103</td>
                                <td>
                                    <div class="user-meta">
                                        <span class="avatar-placeholder">NS</span>
                                        <div>
                                            <strong>Neha Singh</strong>
                                            <small>neha.s@company.com</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dept-tag">Accounts</span></td>
                                <td>Financial Analyst</td>
                                <td><span class="status status-active">Active</span></td>
                                <td><button class="btn-action">View</button></td>
                            </tr>
                            <tr>
                                <td class="id-col">#104</td>
                                <td>
                                    <div class="user-meta">
                                        <span class="avatar-placeholder">RV</span>
                                        <div>
                                            <strong>Rohit Verma</strong>
                                            <small>rohit.v@company.com</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dept-tag">Production</span></td>
                                <td>Plant Manager</td>
                                <td><span class="status status-absent">Absent</span></td>
                                <td><button class="btn-action">View</button></td>
                            </tr>
                            <tr>
                                <td class="id-col">#105</td>
                                <td>
                                    <div class="user-meta">
                                        <span class="avatar-placeholder">PJ</span>
                                        <div>
                                            <strong>Pooja Joshi</strong>
                                            <small>pooja.j@company.com</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="dept-tag">Logistics</span></td>
                                <td>Supply Coordinator</td>
                                <td><span class="status status-field">On Field</span></td>
                                <td><button class="btn-action">View</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Attendance & Quick Visual Side Panel -->
        <div class="side-panel">
            <div class="attendance-box">
                <div class="box-header">
                    <h3>Attendance Split</h3>
                    <span class="sub-text">Today</span>
                </div>

                <!-- Visual Progress Bar -->
                <div class="progress-stacked">
                    <div class="progress-bar bg-green" style="width: 75%;" title="Present"></div>
                    <div class="progress-bar bg-blue" style="width: 10%;" title="Late"></div>
                    <div class="progress-bar bg-orange" style="width: 8%;" title="Leave"></div>
                    <div class="progress-bar bg-red" style="width: 7%;" title="Absent"></div>
                </div>

                <div class="attendance-list">
                    <div class="attendance-item">
                        <span class="label-group"><span class="indicator green"></span> Present</span>
                        <strong class="metric-val">128</strong>
                    </div>
                    <div class="attendance-item">
                        <span class="label-group"><span class="indicator blue"></span> Late Entry</span>
                        <strong class="metric-val">06</strong>
                    </div>
                    <div class="attendance-item">
                        <span class="label-group"><span class="indicator orange"></span> On Leave</span>
                        <strong class="metric-val">08</strong>
                    </div>
                    <div class="attendance-item">
                        <span class="label-group"><span class="indicator red"></span> Absent</span>
                        <strong class="metric-val">05</strong>
                    </div>
                </div>
            </div>

            <!-- Operational Alerts Card -->
            <div class="alerts-box">
                <h3>Priority Alerts</h3>
                <div class="alert-list">
                    <div class="alert-item warning">
                        <span class="alert-icon">⚡</span>
                        <div>
                            <strong>Low Stock Warning</strong>
                            <p>18 SKUs below threshold level.</p>
                        </div>
                    </div>
                    <div class="alert-item info">
                        <span class="alert-icon">💳</span>
                        <div>
                            <strong>Payroll Cycle</strong>
                            <p>Cutoff in 2 days. 4 pending timesheets.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- Bottom Management Panel -->
    <section class="bottom-row">

        <div class="activity-box">
            <div class="box-header">
                <h3>System Audit & Logs</h3>
                <a href="#" class="link-more">View All Logs →</a>
            </div>
            <div class="timeline-container">
                <div class="timeline-step">
                    <div class="step-icon blue"></div>
                    <div class="step-content">
                        <strong>User Sync Completed</strong>
                        <p>Employee <strong>Rahul Sharma</strong> synced with production database by Admin.</p>
                        <span class="timestamp">10 mins ago</span>
                    </div>
                </div>
                <div class="timeline-step">
                    <div class="step-icon green"></div>
                    <div class="step-content">
                        <strong>Payroll Auto-Generated</strong>
                        <p>Monthly payroll sheets created for Q3 lifecycle.</p>
                        <span class="timestamp">1 hour ago</span>
                    </div>
                </div>
                <div class="timeline-step">
                    <div class="step-icon orange"></div>
                    <div class="step-content">
                        <strong>Inventory Cron Job Triggered</strong>
                        <p>Stock scanner updated flags: 18 items marked low-stock.</p>
                        <span class="timestamp">3 hours ago</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="quick-box">
            <h3>Instant ERP Operations</h3>
            <p class="sub-text">Frequent enterprise shortcuts</p>
            <div class="action-flex">
                <button class="btn-neo-primary">
                    <span class="btn-icon">➕</span> Create Employee
                </button>
                <button class="btn-neo-secondary">
                    <span class="btn-icon">⏱</span> Log Attendance
                </button>
                <button class="btn-neo-secondary">
                    <span class="btn-icon">🧾</span> Raise PO Request
                </button>
                <button class="btn-neo-secondary">
                    <span class="btn-icon">🔄</span> Rebuild Payroll
                </button>
                <button class="btn-neo-secondary">
                    <span class="btn-icon">📊</span> Generate Report
                </button>
                <button class="btn-neo-secondary">
                    <span class="btn-icon">💾</span> Export Schema
                </button>
            </div>
        </div>

    </section>

</div>