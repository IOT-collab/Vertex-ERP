@*
    ASP.NET Core MVC ERP Master Dashboard View
*@

@{
    ViewData["Title"] = "ERP Master Dashboard";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/Dashboard.css" rel="stylesheet" asp-append-version="true" />

<div class="dashboard">

    <!-- =========================
         HEADER
    ========================== -->
    <header class="page-header">

        <div class="header-text">
            <span class="system-badge">Enterprise Resource Planning</span>

            <h2>Enterprise Overview</h2>

            <p>
                Welcome back.
                Here is your operational summary for today.
            </p>
        </div>

        <div class="header-actions">

            <!-- Search -->
            <div class="search-bar">
                <span class="search-icon">🔍</span>

                <input type="text"
                       placeholder="Search Employees, Items..." />

                <span class="search-shortcut">⌘</span>
            </div>

            <!-- Current Date -->
            <div class="date-box">

                <span class="calendar-icon">📅</span>

                <div>
                    <strong>
                        @DateTime.Now.ToString("dddd")
                    </strong>

                    <span>
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                </div>

            </div>

            <!-- AI Voice -->
            <button class="btn-ai-mic"
                    id="aiHeaderMic"
                    type="button"
                    title="Ask Vertex AI by voice">

                🎙
                <span class="mic-dot"></span>

            </button>

            <!-- Notifications -->
            <button class="btn-icon-bell"
                    type="button"
                    title="Notifications">

                🔔
                <span class="dot"></span>

            </button>

            <!-- User Avatar -->
            <div class="user-avatar"
                 title="User">

                <span></span>

            </div>

        </div>

    </header>


    <!-- =========================
         KPI CARDS
    ========================== -->

    <section class="card-row">

        <!-- Total Workforce -->
        <div class="dashboard-card status-blue">

            <div class="card-meta">

                <span>Total Workforce</span>

                <div class="card-icon blue-icon">
                    👥
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2></h2>

                <span class="trend up"></span>

            </div>

            <div class="card-footer-info"></div>

        </div>


        <!-- Present Today -->
        <div class="dashboard-card status-green">

            <div class="card-meta">

                <span>Present Today</span>

                <div class="card-icon green-icon">
                    🎯
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2></h2>

                <span class="trend neutral"></span>

            </div>

            <div class="card-footer-info"></div>

        </div>


        <!-- Pending Approvals -->
        <div class="dashboard-card status-orange">

            <div class="card-meta">

                <span>Pending Approvals</span>

                <div class="card-icon orange-icon">
                    ⏳
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2></h2>

                <span class="trend warning"></span>

            </div>

            <div class="card-footer-info"></div>

        </div>


        <!-- Inventory Items -->
        <div class="dashboard-card status-purple">

            <div class="card-meta">

                <span>Inventory Items</span>

                <div class="card-icon purple-icon">
                    📦
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2></h2>

                <span class="trend down"></span>

            </div>

            <div class="card-footer-info"></div>

        </div>

    </section>


    <!-- =========================
         ANALYTICS
    ========================== -->

    <section class="analytics-row">


        <!-- Workforce Trend -->
        <div class="analytics-card analytics-wide">

            <div class="box-header">

                <div>

                    <h3>Workforce Trend</h3>

                    <p class="sub-text">
                        Attendance performance across the current week
                    </p>

                </div>

                <span class="badge-count">
                    Live Trend
                </span>

            </div>


            <div class="line-chart"
                 aria-label="Weekly attendance trend graph">

                <!--
                    Dynamic workforce / attendance
                    graph will be displayed here.
                -->

                <div class="chart-labels">

                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>

                </div>

            </div>

        </div>


        <!-- Department Load -->
        <div class="analytics-card">

            <div class="box-header">

                <div>

                    <h3>Department Load</h3>

                    <p class="sub-text">
                        Open activity by team
                    </p>

                </div>

            </div>


            <div class="bar-chart"
                 aria-label="Department workload bar chart">

                <!--
                    Department workload
                    will come from database.
                -->

            </div>

        </div>


        <!-- Approval Health -->
        <div class="analytics-card">

            <div class="box-header">

                <div>

                    <h3>Approval Health</h3>

                    <p class="sub-text">
                        SLA clearance progress
                    </p>

                </div>

            </div>


            <div class="radial-chart">

                <!-- Dynamic chart -->

                <div class="radial-ring">
                    <span></span>
                </div>


                <div class="radial-details">

                    <div>

                        <strong></strong>

                        <span>
                            Closed
                        </span>

                    </div>


                    <div>

                        <strong></strong>

                        <span>
                            Queued
                        </span>

                    </div>


                    <div>

                        <strong></strong>

                        <span>
                            Escalated
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <section class="content-row">


        <!-- =====================
             EMPLOYEE DIRECTORY
        ====================== -->

        <div class="table-card-wrapper">

            <div class="table-box">


                <div class="box-header">

                    <div>

                        <h3>
                            Recent Active Directory
                        </h3>

                        <p class="sub-text">
                            Real-time status of cross-departmental personnel
                        </p>

                    </div>


                    <div class="table-controls">

                        <select class="select-filter">

                            <option value="">
                                All Departments
                            </option>

                        </select>


                        <span class="badge-count"></span>

                    </div>

                </div>


                <div class="table-responsive-container">

                    <table class="modern-table">


                        <thead>

                            <tr>

                                <th>
                                    Emp ID
                                </th>

                                <th>
                                    Employee Details
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <!--
                                Employee records will
                                come from database.
                            -->

                        </tbody>


                    </table>

                </div>

            </div>

        </div>


        <!-- =====================
             ATTENDANCE SIDE PANEL
        ====================== -->

        <div class="side-panel">


            <!-- Attendance Split -->
            <div class="attendance-box">


                <div class="box-header">

                    <h3>
                        Attendance Split
                    </h3>

                    <span class="sub-text">
                        Today
                    </span>

                </div>


                <!-- Attendance Progress -->
                <div class="progress-stacked">

                    <!--
                        Dynamic attendance
                        percentages will come here.
                    -->

                </div>


                <div class="attendance-list">


                    <!-- Present -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator green"></span>

                            Present

                        </span>

                        <strong class="metric-val"></strong>

                    </div>


                    <!-- Late -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator blue"></span>

                            Late Entry

                        </span>

                        <strong class="metric-val"></strong>

                    </div>


                    <!-- Leave -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator orange"></span>

                            On Leave

                        </span>

                        <strong class="metric-val"></strong>

                    </div>


                    <!-- Absent -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator red"></span>

                            Absent

                        </span>

                        <strong class="metric-val"></strong>

                    </div>


                </div>

            </div>


            <!-- =====================
                 PRIORITY ALERTS
            ====================== -->

            <div class="alerts-box">

                <h3>
                    Priority Alerts
                </h3>


                <div class="alert-list">

                    <!--
                        Dynamic system alerts
                        will come from database.
                    -->

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         BOTTOM MANAGEMENT
    ========================== -->

    <section class="bottom-row">


        <!-- =====================
             SYSTEM AUDIT LOG
        ====================== -->

        <div class="activity-box">


            <div class="box-header">

                <h3>
                    System Audit & Logs
                </h3>

                <a href="#"
                   class="link-more">

                    View All Logs →

                </a>

            </div>


            <div class="timeline-container">

                <!--
                    Dynamic audit logs
                    will come from database.
                -->

            </div>

        </div>


        <!-- =====================
             QUICK OPERATIONS
        ====================== -->

        <div class="quick-box">

            <h3>
                Instant ERP Operations
            </h3>

            <p class="sub-text">
                Frequent enterprise shortcuts
            </p>


            <div class="action-flex">


                <button type="button"
                        class="btn-neo-primary">

                    <span class="btn-icon">
                        ➕
                    </span>

                    Create Employee

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        ⏱
                    </span>

                    Log Attendance

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        🧾
                    </span>

                    Raise PO Request

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        🔄
                    </span>

                    Rebuild Payroll

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        📊
                    </span>

                    Generate Report

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        💾
                    </span>

                    Export Schema

                </button>


            </div>

        </div>

    </section>


    <!-- =========================
         VERTEX AI ASSISTANT
    ========================== -->

    <section class="ai-assistant"
             aria-label="Vertex AI Assistant">


        <button type="button"
                class="ai-toggle"
                id="aiToggle"
                title="Open Vertex AI Assistant">

            <span class="ai-pulse"></span>

            <strong>
                AI
            </strong>

        </button>


        <div class="ai-panel"
             id="aiPanel">


            <div class="ai-panel-header">

                <div>

                    <span class="system-badge">
                        Voice Assistant
                    </span>

                    <h3>
                        Vertex AI
                    </h3>

                    <p class="sub-text">
                        Ask for today's report, users,
                        attendance, or calendar status.
                    </p>

                </div>


                <button type="button"
                        class="ai-close"
                        id="aiClose"
                        title="Close assistant">

                    ×

                </button>

            </div>


            <div class="ai-messages"
                 id="aiMessages">

                <!-- AI responses appear here -->

            </div>


            <div class="ai-controls">


                <button type="button"
                        class="ai-mic"
                        id="aiMic"
                        title="Speak to assistant">

                    🎙

                </button>


                <input type="text"
                       id="aiInput"
                       placeholder="Ask Vertex AI..." />


                <button type="button"
                        class="ai-send"
                        id="aiSend">

                    Send

                </button>


            </div>

        </div>

    </section>

</div>


<!-- =========================
     VERTEX AI SCRIPT
========================== -->

<script>

    (() => {

        const aiToggle =
            document.getElementById("aiToggle");

        const aiPanel =
            document.getElementById("aiPanel");

        const aiClose =
            document.getElementById("aiClose");

        const aiInput =
            document.getElementById("aiInput");

        const aiSend =
            document.getElementById("aiSend");

        const aiMic =
            document.getElementById("aiMic");

        const aiHeaderMic =
            document.getElementById("aiHeaderMic");

        const aiMessages =
            document.getElementById("aiMessages");


        const SpeechRecognition =
            window.SpeechRecognition ||
            window.webkitSpeechRecognition;


        const recognition =
            SpeechRecognition
                ? new SpeechRecognition()
                : null;


        if (recognition) {

            recognition.lang = "en-IN";

            recognition.interimResults = false;

            recognition.continuous = false;

        }


        let isListening = false;


        // =====================
        // STOP AUDIO
        // =====================

        const stopAssistantAudio = () => {

            if ("speechSynthesis" in window) {

                window.speechSynthesis.cancel();

            }


            if (recognition && isListening) {

                try {

                    recognition.abort();

                }
                catch {

                    recognition.stop();

                }

            }


            isListening = false;


            if (aiMic)
                aiMic.classList.remove("listening");

            if (aiHeaderMic)
                aiHeaderMic.classList.remove("listening");

        };


        // =====================
        // ADD MESSAGE
        // =====================

        const addMessage = (text, type) => {

            if (!aiMessages)
                return;


            const message =
                document.createElement("div");


            message.className =
                `ai-message ${type}`;


            message.textContent = text;


            aiMessages.appendChild(message);


            aiMessages.scrollTop =
                aiMessages.scrollHeight;

        };


        // =====================
        // SPEAK
        // =====================

        const speak = (text) => {

            if (!aiPanel ||
                !aiPanel.classList.contains("open") ||
                !("speechSynthesis" in window)) {

                return;

            }


            window.speechSynthesis.cancel();


            const utterance =
                new SpeechSynthesisUtterance(text);


            const voices =
                window.speechSynthesis.getVoices();


            utterance.voice =

                voices.find(
                    voice =>
                        voice.lang === "en-US"
                )

                ||

                voices.find(
                    voice =>
                        voice.lang === "en-GB"
                )

                ||

                voices.find(
                    voice =>
                        voice.lang?.startsWith("en")
                );


            utterance.lang =
                utterance.voice?.lang || "en-US";


            utterance.rate = 0.95;

            utterance.pitch = 1;


            window.speechSynthesis.speak(
                utterance
            );

        };


        // =====================
        // ASK ASSISTANT
        // =====================

        const askAssistant = async () => {

            if (!aiInput)
                return;


            const question =
                aiInput.value.trim();


            if (!question)
                return;


            addMessage(
                question,
                "user"
            );


            aiInput.value = "";


            try {

                const response =
                    await fetch(
                        "/Guest/AskAssistant",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    message: question
                                })
                        }
                    );


                const data =
                    await response.json();


                addMessage(
                    data.reply,
                    "assistant"
                );


                if (
                    aiPanel &&
                    aiPanel.classList.contains("open")
                ) {

                    speak(data.reply);

                }

            }
            catch {

                const fallback =
                    "Assistant service is not responding right now.";


                addMessage(
                    fallback,
                    "assistant"
                );


                if (
                    aiPanel &&
                    aiPanel.classList.contains("open")
                ) {

                    speak(fallback);

                }

            }

        };


        // =====================
        // OPEN / CLOSE AI
        // =====================

        if (aiToggle) {

            aiToggle.addEventListener(
                "click",
                () => {

                    aiPanel?.classList.toggle("open");


                    if (
                        aiPanel &&
                        !aiPanel.classList.contains("open")
                    ) {

                        stopAssistantAudio();

                    }

                }
            );

        }


        if (aiClose) {

            aiClose.addEventListener(
                "click",
                () => {

                    aiPanel?.classList.remove("open");

                    stopAssistantAudio();

                }
            );

        }


        if (aiSend) {

            aiSend.addEventListener(
                "click",
                askAssistant
            );

        }


        if (aiInput) {

            aiInput.addEventListener(
                "keydown",
                event => {

                    if (event.key === "Enter") {

                        askAssistant();

                    }

                }
            );

        }


        // =====================
        // VOICE INPUT
        // =====================

        const startListening = () => {

            aiPanel?.classList.add("open");


            if (!recognition) {

                const message =
                    "Voice input is not supported in this browser. Please type your question.";


                addMessage(
                    message,
                    "assistant"
                );


                speak(message);

                return;

            }


            if (isListening)
                return;


            try {

                isListening = true;


                aiMic?.classList.add(
                    "listening"
                );


                aiHeaderMic?.classList.add(
                    "listening"
                );


                recognition.start();

            }
            catch {

                isListening = false;


                aiMic?.classList.remove(
                    "listening"
                );


                aiHeaderMic?.classList.remove(
                    "listening"
                );

            }

        };


        if (aiMic) {

            aiMic.addEventListener(
                "click",
                startListening
            );

        }


        if (aiHeaderMic) {

            aiHeaderMic.addEventListener(
                "click",
                startListening
            );

        }


        if (recognition) {


            recognition.onresult =
                event => {

                    const transcript =
                        event.results[0][0]
                            .transcript;


                    if (aiInput) {

                        aiInput.value =
                            transcript;

                    }


                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );


                    askAssistant();

                };


            recognition.onerror =
                () => {

                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );


                    const message =
                        "I could not hear the voice input. Please try again or type your question.";


                    addMessage(
                        message,
                        "assistant"
                    );


                    speak(message);

                };


            recognition.onend =
                () => {

                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );

                };

        }

    })();

</script>