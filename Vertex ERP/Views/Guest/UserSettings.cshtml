@using Shiva_Gautam.Models
@{
    ViewData["Title"] = "User Settings";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var users = ViewBag.Users as List<AppUser> ?? new List<AppUser>();
    var activeUsers = users.Count(user => user.IsActive);
}

<link href="~/css/UserSettings.css" rel="stylesheet" />

<div class="user-settings-page">
    <div class="page-header">
        <div class="header-text">
            <h2>User Login Settings</h2>
            <p>Manage employee login IDs, roles, and account access for Vertex ERP.</p>
        </div>

        <div class="user-summary">
            <strong>@activeUsers</strong>
            <span>Total Logins</span>
        </div>
    </div>

    @if (TempData["UserSettingMessage"] != null)
    {
        <div class="user-alert success">@TempData["UserSettingMessage"]</div>
    }

    @if (TempData["UserSettingError"] != null)
    {
        <div class="user-alert error">@TempData["UserSettingError"]</div>
    }

    <section class="user-settings-grid">
        <div class="create-user-card">
            <div class="section-title">
                <h3>Create Employee Login</h3>
                <p>Use this when a new employee joins and needs ERP access.</p>
            </div>

            <form asp-action="CreateUser" asp-controller="Guest" method="post" autocomplete="off" class="create-user-form">
                <div class="form-group">
                    <label for="username">Employee ID / Username</label>
                    <input id="username" name="username" type="text" placeholder="Example: VAS0180" required />
                </div>

                <div class="form-group">
                    <label for="fullName">Employee Name</label>
                    <input id="fullName" name="fullName" type="text" placeholder="Example: Krishna Sharma" required />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="text" placeholder="Example: Krishna1234" required />
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" name="role">
                        <option>User</option>
                        <option>Supervisor</option>
                        <option>Admin</option>
                    </select>
                </div>

                <button type="submit" class="btn-create-user">Create Login</button>
            </form>
        </div>

        <div class="login-policy-card">
            <div class="section-title">
                <h3>Default Login Rule</h3>
                <p>Imported employees can log in using their employee code.</p>
            </div>

            <div class="policy-list">
                <div>
                    <span>Username</span>
                    <strong>Employee ID</strong>
                </div>
                <div>
                    <span>Password</span>
                    <strong>FirstName1234</strong>
                </div>
                <div>
                    <span>Example</span>
                    <strong>Krishna1234</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="users-table-card">
        <div class="section-title table-title">
            <div>
                <h3>Employee Login Directory</h3>
                <p>Passwords are securely hashed in the database. The visible password below is the initial generated rule for imported users.</p>
            </div>
            <span class="status-pill">@activeUsers Active</span>
        </div>

        <div class="users-table-wrap">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Employee ID / Username</th>
                        <th>Employee Name</th>
                        <th>Designation / Role</th>
                        <th>Initial Password Rule</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        var firstName = user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? user.Username;
                        var initialPassword = user.Username.ToLowerInvariant() switch
                        {
                            "admin" => "Vertex1234",
                            "user" => "User1234",
                            "supervisor" => "Supervisor1234",
                            _ => $"{firstName.Replace("Mr.", "").Trim()}1234"
                        };
                        <tr class="user-row">
                            <td><strong>@user.Username</strong></td>
                            <td>
                                <span class="display-value user-name-display">@user.FullName</span>
                                <form id="edit-user-@user.Id" asp-action="UpdateUser" asp-controller="Guest" method="post" class="edit-user-form">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input class="edit-input" name="fullName" type="text" value="@user.FullName" required />
                                </form>
                            </td>
                            <td>
                                <span class="display-value role-badge">@user.Role</span>
                                <select form="edit-user-@user.Id" class="edit-select" name="role">
                                    @if (user.Role == "User")
                                    {
                                        <option selected>User</option>
                                    }
                                    else
                                    {
                                        <option>User</option>
                                    }
                                    @if (user.Role == "Supervisor")
                                    {
                                        <option selected>Supervisor</option>
                                    }
                                    else
                                    {
                                        <option>Supervisor</option>
                                    }
                                    @if (user.Role == "Admin")
                                    {
                                        <option selected>Admin</option>
                                    }
                                    else
                                    {
                                        <option>Admin</option>
                                    }
                                </select>
                            </td>
                            <td><code>@initialPassword</code></td>
                            <td>
                                <span class="display-value status-badge @(user.IsActive ? "active" : "inactive")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                                <select form="edit-user-@user.Id" class="edit-select" name="isActive">
                                    @if (user.IsActive)
                                    {
                                        <option value="true" selected>Active</option>
                                        <option value="false">Inactive</option>
                                    }
                                    else
                                    {
                                        <option value="true">Active</option>
                                        <option value="false" selected>Inactive</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn-row-edit" data-edit-row>Edit</button>
                                    <button type="submit" form="edit-user-@user.Id" class="btn-row-save">Save</button>
                                    <button type="button" class="btn-row-cancel" data-cancel-row>Cancel</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    const closeEditingRows = (exceptRow = null) => {
        document.querySelectorAll(".user-row.is-editing").forEach((row) => {
            if (row !== exceptRow) {
                row.querySelector("form")?.reset();
                row.classList.remove("is-editing");
            }
        });
    };

    document.querySelectorAll("[data-edit-row]").forEach((button) => {
        button.addEventListener("click", () => {
            const row = button.closest(".user-row");
            closeEditingRows(row);
            row?.classList.add("is-editing");
        });
    });

    document.querySelectorAll("[data-cancel-row]").forEach((button) => {
        button.addEventListener("click", () => {
            const row = button.closest(".user-row");
            row?.querySelector("form")?.reset();
            row?.classList.remove("is-editing");
        });
    });
</script>
