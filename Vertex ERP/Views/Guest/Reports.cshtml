@{
    ViewData["Title"] = "Reports Dashboard";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/report.css" rel="stylesheet" />

<!-- FontAwesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="report-container">

    <!-- Page Header Section -->
    <header class="report-header">
        <div class="header-text">
            <h2><i class="fa-solid fa-chart-pie text-primary-icon"></i> Reports Dashboard</h2>
            <p>View, filter, and generate real-time ERP analytics & reports.</p>
        </div>

        <div class="header-buttons">
            <button type="button" class="btn-primary">
                <i class="fa-solid fa-plus"></i> Generate Report
            </button>
            <button type="button" class="btn-secondary">
                <i class="fa-solid fa-file-excel"></i> Export Excel
            </button>
        </div>
    </header>

    <!-- Dynamic Dynamic Metrics / Summary KPI Row -->
    <section class="report-cards">
        <div class="report-card blue">
            <h3>@(ViewBag.TotalReports ?? "0")</h3>
            <p><i class="fa-solid fa-folder-open"></i> Total Reports</p>
        </div>

        <div class="report-card green">
            <h3>@(ViewBag.TodayReports ?? "0")</h3>
            <p><i class="fa-solid fa-calendar-day"></i> Today's Reports</p>
        </div>

        <div class="report-card orange">
            <h3>@(ViewBag.PendingReports ?? "0")</h3>
            <p><i class="fa-solid fa-clock"></i> Pending Reports</p>
        </div>

        <div class="report-card red">
            <h3>@(ViewBag.FailedReports ?? "0")</h3>
            <p><i class="fa-solid fa-circle-exclamation"></i> Failed Reports</p>
        </div>
    </section>

    <!-- Dynamic Query Filter Consolidation Panel -->
    <form method="get" asp-action="Index" class="filter-panel">
        <div class="filter-field">
            <label class="filter-label"><i class="fa-solid fa-magnifying-glass"></i> Search</label>
            <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" placeholder="Search by name or ID..." />
        </div>

        <div class="filter-field">
            <label class="filter-label"><i class="fa-solid fa-filter"></i> Module Type</label>
            <select name="reportType" asp-items="ViewBag.ReportTypes">
                <option value="">All Categories</option>
            </select>
        </div>

        <div class="filter-field">
            <label class="filter-label"><i class="fa-solid fa-calendar-alt"></i> From Date</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" />
        </div>

        <div class="filter-field">
            <label class="filter-label"><i class="fa-solid fa-calendar-alt"></i> To Date</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate" />
        </div>

        <div class="filter-field action-field">
            <button type="submit" class="btn-search">
                <i class="fa-solid fa-filter"></i> Apply Filters
            </button>
        </div>
    </form>

    <!-- Report Categories Matrix -->
    <section class="category-grid">
        @if (ViewBag.Categories != null)
        {
            foreach (var cat in ViewBag.Categories)
            {
                <a href="@cat.Url" class="category-card">
                    <div class="cat-icon-box">
                        <i class="@(cat.IconClass ?? "fa-solid fa-file-lines")"></i>
                    </div>
                    <div>
                        <h4>@cat.Title</h4>
                        <p>@cat.Description</p>
                    </div>
                </a>
            }
        }
    </section>

    <!-- Dynamic Database Log / Data Table -->
    <section class="table-box">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Report Name</th>
                    <th>Module</th>
                    <th>Generated By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.ReportName</strong></td>
                            <td>@item.ModuleName</td>
                            <td>@item.GeneratedBy</td>
                            <td>@item.CreatedDate?.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <span class="status @item.StatusClass">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="ViewReport" asp-route-id="@item.Id" class="view-btn" title="View Details">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    <a asp-action="Download" asp-route-id="@item.Id" class="download-btn" title="Download Document">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="no-data-cell">
                            <i class="fa-solid fa-inbox no-data-icon"></i>
                            <p>No report records found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

</div>
