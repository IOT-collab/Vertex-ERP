@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/report.css" rel="stylesheet" />

<div class="report-container">

    <!-- Adaptive Page Header Layout -->
    <div class="report-header">
        <div class="header-text">
            <h2>Reports Dashboard</h2>
            <p>View and generate ERP reports</p>
        </div>

        <div class="header-buttons">
            <button class="btn-primary">Generate Report</button>
            <button class="btn-secondary">Export Excel</button>
        </div>
    </div>

    <!-- Summary KPI Row Fluid Grid -->
    <div class="report-cards">
        <div class="report-card blue">
            <h3>156</h3>
            <p>Total Reports</p>
        </div>

        <div class="report-card green">
            <h3>12</h3>
            <p>Today's Reports</p>
        </div>

        <div class="report-card orange">
            <h3>25</h3>
            <p>Pending Reports</p>
        </div>

        <div class="report-card red">
            <h3>8</h3>
            <p>Failed Reports</p>
        </div>
    </div>

    <!-- Dynamic Query Filter Consolidation Panel -->
    <div class="filter-panel">
        <div class="filter-field">
            <input type="text" placeholder="Search Report">
        </div>

        <div class="filter-field">
            <select>
                <option>Report Type</option>
                <option>Employee</option>
                <option>Attendance</option>
                <option>Inventory</option>
                <option>Payroll</option>
            </select>
        </div>

        <div class="filter-field">
            <input type="date">
        </div>

        <div class="filter-field">
            <input type="date">
        </div>

        <div class="filter-field action-field">
            <button class="btn-search">Search</button>
        </div>
    </div>

    <!-- Report Categories Matrix Auto-Grid -->
    <div class="category-grid">
        <div class="category-card">
            <h4>Employee Report</h4>
            <p>Employee master and details</p>
        </div>

        <div class="category-card">
            <h4>Attendance Report</h4>
            <p>Daily & Monthly attendance</p>
        </div>

        <div class="category-card">
            <h4>Inventory Report</h4>
            <p>Stock & warehouse summary</p>
        </div>

        <div class="category-card">
            <h4>Payroll Report</h4>
            <p>Salary & payment reports</p>
        </div>

        <div class="category-card">
            <h4>Leave Report</h4>
            <p>Leave history & approvals</p>
        </div>

        <div class="category-card">
            <h4>Sales Report</h4>
            <p>Revenue & invoice summary</p>
        </div>
    </div>

    <!-- Core Database Roster Log Data Table Container -->
    <div class="table-box">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Report Name</th>
                    <th>Module</th>
                    <th>Generated By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Monthly Attendance</strong></td>
                    <td>Attendance</td>
                    <td>Admin</td>
                    <td>15-Jul-2026</td>
                    <td>
                        <span class="status completed">Completed</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="view-btn">View</button>
                            <button class="download-btn">Download</button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><strong>Inventory Summary</strong></td>
                    <td>Inventory</td>
                    <td>Admin</td>
                    <td>15-Jul-2026</td>
                    <td>
                        <span class="status pending">Pending</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="view-btn">View</button>
                            <button class="download-btn">Download</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>