@{
    ViewData["Title"] = "Employee Portal";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="~/css/employee11.css" rel="stylesheet" />

<div class="emp-dash-container">

    <!-- TOP HEADER / PROFILE BAR -->
    <div class="emp-profile-bar">
        <div class="emp-user-info">
            <div class="emp-avatar">RS</div>
            <div>
                <h2>Rahul Sharma <span class="badge badge-active">Active</span></h2>
                <p>Sr. Frontend Developer • Core Engineering (VTX-2024-089)</p>
            </div>
        </div>
        <div class="emp-actions">
            <div class="timer-box">Logged in: <strong>04h 25m</strong></div>
            <button class="btn btn-primary"><i class="fas fa-clock"></i> Punch Out</button>
            <button class="btn btn-secondary"><i class="fas fa-id-card"></i> ID Card</button>
        </div>
    </div>

    <!-- QUICK STATS (4 METRICS) -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon icon-blue"><i class="fas fa-calendar-check"></i></div>
            <div class="stat-data">
                <span class="stat-value">96.5%</span>
                <span class="stat-label">Attendance</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-purple"><i class="fas fa-laptop"></i></div>
            <div class="stat-data">
                <span class="stat-value">3 Assets</span>
                <span class="stat-label">Assigned Hardware</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-amber"><i class="fas fa-tasks"></i></div>
            <div class="stat-data">
                <span class="stat-value">3 / 5</span>
                <span class="stat-label">Today's Tasks</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-green"><i class="fas fa-calendar-alt"></i></div>
            <div class="stat-data">
                <span class="stat-value">12 Tasks</span>
                <span class="stat-label">Upcoming (30 Days)</span>
            </div>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN DASHBOARD GRID -->
    <div class="dash-grid">

        <!-- LEFT COLUMN: TODAY'S TASKS & UPCOMING 30-DAY PLAN -->
        <div class="dash-column">

            <!-- TODAY'S TASKS CARD -->
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-tasks"></i> Today's Tasks</h3>
                    <button class="btn btn-sm btn-secondary"><i class="fas fa-plus"></i> Add Log</button>
                </div>
                <div class="card-body">
                    <ul class="task-list">
                        <li class="task-item">
                            <input type="checkbox" id="t1" class="task-check" />
                            <label for="t1" class="task-details">
                                <strong>Fix Responsive Grid UI Overlap Issue</strong>
                                <small>Vertex ERP • Due: 02:00 PM</small>
                            </label>
                            <span class="tag tag-red">High</span>
                        </li>
                        <li class="task-item">
                            <input type="checkbox" id="t2" class="task-check" />
                            <label for="t2" class="task-details">
                                <strong>Integrate Attendance Webhook</strong>
                                <small>API Pipeline • Due: 05:30 PM</small>
                            </label>
                            <span class="tag tag-amber">Medium</span>
                        </li>
                        <li class="task-item completed">
                            <input type="checkbox" id="t3" class="task-check" checked />
                            <label for="t3" class="task-details">
                                <strong>Submit Weekly Progress Report</strong>
                                <small>HR Compliance • Done 11:15 AM</small>
                            </label>
                            <span class="tag tag-green">Done</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- UPCOMING TASKS (30-DAY MONTHLY PLAN) -->
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-calendar-week"></i> Upcoming Tasks</h3>
                    <button class="btn btn-sm btn-outline-primary" id="toggleUpcomingBtn" onclick="toggleUpcomingTasks()">
                        <i class="fas fa-eye"></i> View 30-Day Plan
                    </button>
                </div>
                <div class="card-body">

                    <!-- SUMMARY PREVIEW (Visible by default) -->
                    <div class="upcoming-summary" id="upcomingSummary">
                        <div class="plan-badge-bar">
                            <span class="plan-period"><i class="far fa-clock"></i> Next 30 Days Target</span>
                            <span class="badge badge-purple">12 Deliverables Scheduled</span>
                        </div>
                        <div class="progress-bar-container mt-10">
                            <div class="progress-info">
                                <span>Monthly Progress</span>
                                <strong>25% Completed</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: 25%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- FULL 30-DAY TASK LIST (Expandable) -->
                    <div class="upcoming-expanded-list" id="upcomingTaskList">
                        <ul class="task-list mt-10">
                            <li class="task-item">
                                <div class="task-date-badge">
                                    <span class="day">05</span>
                                    <span class="month">AUG</span>
                                </div>
                                <div class="task-details">
                                    <strong>Sprint Planning & Design Review</strong>
                                    <small>Vertex ERP v2.0 • Phase 1 Kickoff</small>
                                </div>
                                <span class="tag tag-blue">Scheduled</span>
                            </li>
                            <li class="task-item">
                                <div class="task-date-badge">
                                    <span class="day">12</span>
                                    <span class="month">AUG</span>
                                </div>
                                <div class="task-details">
                                    <strong>OAuth2 Authorization Security Audit</strong>
                                    <small>Core Security Compliance</small>
                                </div>
                                <span class="tag tag-red">High Priority</span>
                            </li>
                            <li class="task-item">
                                <div class="task-date-badge">
                                    <span class="day">18</span>
                                    <span class="month">AUG</span>
                                </div>
                                <div class="task-details">
                                    <strong>Database Migration to PostgreSQL</strong>
                                    <small>Infrastructure Upgrade</small>
                                </div>
                                <span class="tag tag-amber">Medium</span>
                            </li>
                            <li class="task-item">
                                <div class="task-date-badge">
                                    <span class="day">25</span>
                                    <span class="month">AUG</span>
                                </div>
                                <div class="task-details">
                                    <strong>End-to-End Testing & Bug Scrub</strong>
                                    <small>QA & Release Preparation</small>
                                </div>
                                <span class="tag tag-blue">Planned</span>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: CORE INFORMATION & ANNOUNCEMENTS -->
        <div class="dash-column">

            <!-- PROFILE & CORE INFO -->
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-user-circle"></i> Core Profile</h3>
                    <span class="badge badge-green">KYC Verified</span>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-row"><span>Manager:</span> <strong>Vikram Malhotra</strong></div>
                        <div class="info-row"><span>Email:</span> <strong>rahul.sharma@company.com</strong></div>
                        <div class="info-row"><span>Location:</span> <strong>Noida HQ (Tower B)</strong></div>
                        <div class="info-row"><span>Verification:</span> <strong>PAN & Compliance Verified</strong></div>
                    </div>
                </div>
            </div>

            <!-- ANNOUNCEMENTS & SUPPORT -->
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-bullhorn"></i> Announcement</h3>
                </div>
                <div class="card-body">
                    <div class="alert-box">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <strong>Quarterly All-Hands Townhall</strong>
                            <p>Scheduled for Friday at 04:00 PM in Conference Room A / Teams.</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-secondary w-100"><i class="fas fa-headset"></i> Raise Helpdesk Ticket</button>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- TOGGLE SCRIPT -->
<script>
    function toggleUpcomingTasks() {
        const taskList = document.getElementById('upcomingTaskList');
        const btn = document.getElementById('toggleUpcomingBtn');

        if (taskList.classList.contains('show')) {
            taskList.classList.remove('show');
            btn.innerHTML = '<i class="fas fa-eye"></i> View 30-Day Plan';
        } else {
            taskList.classList.add('show');
            btn.innerHTML = '<i class="fas fa-eye-slash"></i> Hide Plan';
        }
    }
</script>