@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Attendence";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/Attendence.css" rel="stylesheet" />

<div class="attendance-panel-container">

    <!-- Header Hub -->
    <div class="page-header">
        <div class="header-text">
            <h2>Attendance Management</h2>
            <p>Track global checkpoints, monthly metrics, total late limits, and remaining leave buckets.</p>
        </div>

        <a href="@Url.Action("AddAttendance", "Guest")" class="btn-add" style="text-decoration: none; display: inline-flex; align-items: center;">
            + Mark Attendence
        </a>
    </div>

    <!-- Top Grid Cards Counters: Dynamic Flex/Grid Matrix -->
    <div class="dashboard-cards">
        <div class="card present">
            <h3>120</h3>
            <span>Present Today</span>
        </div>
        <div class="card absent">
            <h3>08</h3>
            <span>Absent Today</span>
        </div>
        <div class="card leave">
            <h3>05</h3>
            <span>On Leave</span>
        </div>
        <div class="card late">
            <h3>12</h3>
            <span>Late Arrivals</span>
        </div>
    </div>

    <!-- Query Filter Hub -->
    <div class="filter-box">
        <div class="filter-field">
            <input type="text" placeholder="Search Employee...">
        </div>
        <div class="filter-field">
            <select>
                <option>All Departments</option>
                <option>IT Component</option>
                <option>HR Department</option>
                <option>Sales Matrix</option>
            </select>
        </div>
        <div class="filter-field">
            <input type="date">
        </div>
        <div class="filter-field">
            <select>
                <option>All Statuses</option>
                <option>Present</option>
                <option>Absent</option>
                <option>Leave</option>
                <option>Late</option>
            </select>
        </div>
        <div class="filter-field action-field">
            <button class="btn-search">Run Search</button>
        </div>
    </div>

    <!-- Core Database Full Width Roster Table Container -->
    <div class="table-box">
        <table>
            <thead>
                <tr>
                    <th>Emp ID</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Total Leaves</th>
                    <th>Leaves Taken</th>
                    <th>Leaves Left</th>
                    <th>Late Days</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>101</td>
                    <td><strong>Sanjeev Kumar</strong></td>
                    <td>IT</td>
                    <td>15-Jul-2026</td>
                    <td>09:02 AM</td>
                    <td>06:12 PM</td>
                    <td class="txt-total">24</td>
                    <td class="txt-used">04</td>
                    <td class="txt-avail">20</td>
                    <td class="txt-late">03 Days</td>
                    <td>
                        <span class="status present-status">Present</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="edit">Edit</button>
                            <button class="delete">Delete</button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>102</td>
                    <td><strong>Tarun Sharma</strong></td>
                    <td>HR</td>
                    <td>15-Jul-2026</td>
                    <td>09:45 AM</td>
                    <td>06:00 PM</td>
                    <td class="txt-total">24</td>
                    <td class="txt-used">06</td>
                    <td class="txt-avail">18</td>
                    <td class="txt-late">07 Days</td>
                    <td>
                        <span class="status late-status">Late</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="edit">Edit</button>
                            <button class="delete">Delete</button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>103</td>
                    <td><strong>Amit Verma</strong></td>
                    <td>Sales</td>
                    <td>15-Jul-2026</td>
                    <td>--:--</td>
                    <td>--:--</td>
                    <td class="txt-total">24</td>
                    <td class="txt-used">05</td>
                    <td class="txt-avail">19</td>
                    <td class="txt-late">01 Day</td>
                    <td>
                        <span class="status leave-status">Leave</span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="edit">Edit</button>
                            <button class="delete">Delete</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>