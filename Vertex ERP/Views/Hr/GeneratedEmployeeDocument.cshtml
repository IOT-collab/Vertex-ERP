@model VertexERP.Models.EmployeeDocumentFormViewModel
@{ ViewData["Title"]=Model.DocumentType; Layout="_Layout"; var isOffer=Model.DocumentType=="Offer Letter"; var isIncrement=Model.DocumentType=="Increment / Promotion Letter"; }
<style>
.letter-tools{width:min(850px,100%);display:flex;justify-content:space-between;gap:10px;margin:20px auto}.letter-tools a,.letter-tools button{border:0;border-radius:9px;padding:11px 16px;text-decoration:none;font-weight:700;cursor:pointer}.letter-tools a{background:#e7eef8;color:#1e40af}.letter-tools button{background:#2563eb;color:#fff}.letter-sheet{width:min(850px,calc(100% - 24px));min-height:1050px;margin:0 auto 30px;padding:70px 72px;background:#fff;color:#172033;box-shadow:0 18px 45px #17203325;font-family:Arial,sans-serif}.letter-brand{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:22px;border-bottom:3px solid #2563eb}.letter-brand h1{margin:0;color:#163b72;font-size:28px}.letter-brand p{margin:5px 0 0;color:#64748b}.letter-date{text-align:right;color:#475569}.letter-sheet h2{text-align:center;margin:42px 0 32px;text-transform:uppercase;letter-spacing:.08em;font-size:21px}.letter-sheet p{font-size:15px;line-height:1.75;margin:14px 0}.letter-details{margin:24px 0;padding:18px 20px;border-left:4px solid #2563eb;background:#f4f7fb}.letter-details p{margin:5px 0}.signature{margin-top:70px}.signature strong{display:block;margin-top:42px}.employee-copy{margin-top:55px;padding-top:18px;border-top:1px solid #cbd5e1;color:#64748b;font-size:12px}
@@media(max-width:650px){.letter-tools{padding:0 12px;flex-wrap:wrap}.letter-sheet{padding:35px 24px;min-height:0}.letter-brand{gap:12px}.letter-brand h1{font-size:22px}.letter-date{font-size:12px}.letter-sheet h2{margin:30px 0 22px;font-size:18px}}@@media print{body{background:#fff!important}.letter-tools,header,nav,.sidebar,.topbar,.common-back-nav{display:none!important}.letter-sheet{width:100%;min-height:auto;margin:0;padding:20mm;box-shadow:none}.page-content{padding:0!important}}
</style>
<div class="letter-tools"><a asp-action="GenerateDocument" asp-route-employeeId="@Model.EmployeeId"><i class="fa-solid fa-arrow-left"></i> Edit details</a><button type="button" onclick="window.print()"><i class="fa-solid fa-print"></i> Print / Save PDF</button><form asp-action="DownloadGeneratedDocument" method="post"><input asp-for="EmployeeId" type="hidden"/><input asp-for="EmployeeName" type="hidden"/><input asp-for="DateOfBirth" type="hidden"/><input asp-for="Mobile" type="hidden"/><input asp-for="Email" type="hidden"/><input asp-for="Designation" type="hidden"/><input asp-for="Department" type="hidden"/><input asp-for="ManagerName" type="hidden"/><input asp-for="DocumentType" type="hidden"/><input asp-for="EffectiveDate" type="hidden"/><input asp-for="NewDesignation" type="hidden"/><input asp-for="AdditionalNotes" type="hidden"/><input asp-for="PanNumber" type="hidden"/><input asp-for="WorkLocation" type="hidden"/><input asp-for="AnnualCtc" type="hidden"/><input asp-for="MonthlyGross" type="hidden"/><input asp-for="ProbationPeriod" type="hidden"/><input asp-for="BankName" type="hidden"/><input asp-for="BankAccountNumber" type="hidden"/><input asp-for="PfNumber" type="hidden"/><input asp-for="PfUan" type="hidden"/><input asp-for="BasicSalary" type="hidden"/><input asp-for="HouseRentAllowance" type="hidden"/><input asp-for="ConveyanceAllowance" type="hidden"/><input asp-for="SpecialAllowance" type="hidden"/><input asp-for="ProvidentFund" type="hidden"/><input asp-for="ProfessionalTax" type="hidden"/><input asp-for="Tds" type="hidden"/><input asp-for="OtherDeductions" type="hidden"/><button type="submit"><i class="fa-solid fa-download"></i> Download Document</button></form></div>
<article class="letter-sheet"><header class="letter-brand"><div><h1>VERTEX GROUP</h1><p>Human Resources Department</p></div><div class="letter-date"><strong>Date</strong><br/>@DateTime.Today.ToString("dd MMMM yyyy")</div></header><h2>@Model.DocumentType</h2>
<p>To,<br/><strong>@Model.EmployeeName</strong><br/>@Model.Email<br/>@Model.Mobile</p>
@if(isOffer){<p>Dear @Model.EmployeeName,</p><p>We are pleased to offer you the position of <strong>@Model.Designation</strong> in the <strong>@Model.Department</strong> department at Vertex Group, effective from <strong>@Model.EffectiveDate.ToString("dd MMMM yyyy")</strong>.</p><div class="letter-details"><p><strong>Designation:</strong> @Model.Designation</p><p><strong>Reporting Manager:</strong> @Model.ManagerName</p><p><strong>Joining Date:</strong> @Model.EffectiveDate.ToString("dd MMMM yyyy")</p></div><p>Your employment will be governed by the policies, confidentiality requirements and terms communicated by the company. We look forward to your contribution and wish you a successful journey with Vertex Group.</p>}
else if(isIncrement){<p>Dear @Model.EmployeeName,</p><p>In recognition of your contribution and performance, we are pleased to confirm your @(string.IsNullOrWhiteSpace(Model.NewDesignation)?"increment / promotion":"promotion") effective from <strong>@Model.EffectiveDate.ToString("dd MMMM yyyy")</strong>.</p><div class="letter-details"><p><strong>Current Designation:</strong> @Model.Designation</p>@if(!string.IsNullOrWhiteSpace(Model.NewDesignation)){<p><strong>New Designation:</strong> @Model.NewDesignation</p>}<p><strong>Reporting Manager:</strong> @Model.ManagerName</p></div><p>All other employment terms remain unchanged unless separately communicated. We appreciate your continued commitment and wish you further success.</p>}
else{<p>Dear @Model.EmployeeName,</p><p>This is to confirm that you are relieved from your duties as <strong>@Model.Designation</strong> in the <strong>@Model.Department</strong> department at the close of business on <strong>@Model.EffectiveDate.ToString("dd MMMM yyyy")</strong>.</p><p>During your employment, you reported to <strong>@Model.ManagerName</strong>. Subject to completion of the required handover and clearance formalities, the company acknowledges the conclusion of your employment.</p><p>We thank you for your contribution and wish you success in your future endeavours.</p>}
@if(!string.IsNullOrWhiteSpace(Model.AdditionalNotes)){<div class="letter-details"><strong>Additional information</strong><p>@Model.AdditionalNotes</p></div>}<div class="signature"><p>For Vertex Group</p><strong>Authorized Signatory</strong><span>Human Resources</span></div><footer class="employee-copy">This document was generated through Vertex ERP. Employee ID: @Model.EmployeeId · DOB: @(Model.DateOfBirth?.ToString("dd/MM/yyyy")??"Not recorded")</footer></article>
