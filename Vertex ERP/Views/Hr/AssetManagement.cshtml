@model IReadOnlyList<VertexERP.Models.EmployeeAsset>
@{ ViewData["Title"] = "Asset Management"; Layout = "_Layout"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section">
    <header><div><h1>Asset Management</h1><p>Hardware and accessories issued to employees.</p></div><a class="btn btn-primary" asp-action="IssueAsset">Issue New Asset</a></header>
    @if (TempData["AssetMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
    <div class="employee-summary"><article><small>Total Issued Assets</small><strong>@Model.Count</strong></article><article><small>Employees with Assets</small><strong>@Model.Select(asset => asset.EmployeeId).Distinct().Count()</strong></article></div>
    <div class="employee-panel">
        @if (Model.Count == 0) { <div class="employee-empty">No assets issued yet. Select Issue New Asset to assign one to an employee.</div> }
        else
        {
            <table class="employee-table"><thead><tr><th>Asset Tag</th><th>Asset</th><th>Employee</th><th>Category</th><th>Serial Number</th><th>Issue Date</th><th>Notes</th></tr></thead>
            <tbody>@foreach (var asset in Model)
            {
                <tr><td>@asset.AssetTag</td><td>@asset.AssetName</td><td>@asset.Employee.FullName<small>@asset.Employee.EmployeeCode</small></td><td>@asset.Category</td><td>@(asset.SerialNumber ?? "--")</td><td>@asset.IssueDate.ToString("dd MMM yyyy")</td><td>@(asset.Notes ?? "--")</td></tr>
            }</tbody></table>
        }
    </div>
</section>
