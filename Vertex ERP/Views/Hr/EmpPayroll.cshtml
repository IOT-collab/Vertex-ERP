@model dynamic

@{
    ViewData["Title"] = "Payroll & Salary";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/EmpPayroll.css" rel="stylesheet" asp-append-version="true" />

<div class="payroll-dashboard-wrapper">

    <!-- Page Header with Back Arrow -->
    <div class="dashboard-header">
        <div class="header-left-group">
            <div class="header-text">
                <h2>Payroll &amp; Salary Portal</h2>
                <p>View monthly payslips, salary breakdowns, tax declarations, and payout accounts.</p>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn-secondary-glow" onclick="location.href='@Url.Action("DownloadForm16", "Payroll")'">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Download Form 16
            </button>
        </div>
    </div>

    <!-- Top Salary Overview Stats -->
    <div class="stats-grid">
        <div class="stat-card accent-green">
            <div class="stat-icon icon-net">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Net Take-Home (@(Model?.CurrentMonthName ?? "Current Month"))</span>
                <span class="stat-value">@(Model?.NetTakeHome != null ? ((decimal)Model.NetTakeHome).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</span>
                <small class="stat-meta text-green">✓ Credited</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-gross">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Gross Salary</span>
                <span class="stat-value">@(Model?.GrossSalary != null ? ((decimal)Model.GrossSalary).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</span>
                <small class="stat-meta">Monthly Base + Allowances</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-deduction">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Deductions</span>
                <span class="stat-value">@(Model?.TotalDeductions != null ? ((decimal)Model.TotalDeductions).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</span>
                <small class="stat-meta text-amber">PF, Tax &amp; PT Deductions</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-ytd">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <div class="stat-info">
                <span class="stat-label">YTD Earnings</span>
                <span class="stat-value">@(Model?.YTDEarnings != null ? ((decimal)Model.YTDEarnings).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</span>
                <small class="stat-meta">Year to Date</small>
            </div>
        </div>
    </div>

    <!-- Main Grid: Breakdown & Bank Info -->
    <div class="dashboard-grid">

        <!-- LEFT: Salary Breakdown -->
        <div class="glass-card breakdown-card">
            <div class="card-header">
                <h3>Current Month Salary Breakdown</h3>
                <span class="badge-month">@(Model?.CurrentMonthName ?? "N/A")</span>
            </div>

            <div class="breakdown-columns">
                <!-- Earnings Column -->
                <div class="breakdown-col">
                    <h4 class="col-title text-green">Earnings</h4>
                    <ul class="breakdown-list">
                        @if (Model?.EarningsList != null)
                        {
                            foreach (var earning in Model.EarningsList)
                            {
                                <li>
                                    <span>@earning.Name</span>
                                    <strong>@earning.Amount.ToString("C0", new System.Globalization.CultureInfo("hi-IN"))</strong>
                                </li>
                            }
                        }
                        else
                        {
                            <li><span>No data available</span><strong>₹0</strong></li>
                        }
                        <li class="col-total">
                            <span>Total Gross Earnings</span>
                            <strong class="text-green">@(Model?.GrossSalary != null ? ((decimal)Model.GrossSalary).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</strong>
                        </li>
                    </ul>
                </div>

                <!-- Deductions Column -->
                <div class="breakdown-col">
                    <h4 class="col-title text-red">Deductions</h4>
                    <ul class="breakdown-list">
                        @if (Model?.DeductionsList != null)
                        {
                            foreach (var deduction in Model.DeductionsList)
                            {
                                <li>
                                    <span>@deduction.Name</span>
                                    <strong>@deduction.Amount.ToString("C0", new System.Globalization.CultureInfo("hi-IN"))</strong>
                                </li>
                            }
                        }
                        else
                        {
                            <li><span>No data available</span><strong>₹0</strong></li>
                        }
                        <li class="col-total">
                            <span>Total Deductions</span>
                            <strong class="text-red">@(Model?.TotalDeductions != null ? ((decimal)Model.TotalDeductions).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</strong>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="net-payout-banner">
                <span>Net Payable Amount:</span>
                <h2>@(Model?.NetTakeHome != null ? ((decimal)Model.NetTakeHome).ToString("C0", new System.Globalization.CultureInfo("hi-IN")) : "₹0")</h2>
            </div>
        </div>

        <!-- RIGHT: Bank Info -->
        <div class="glass-card account-card">
            <div class="card-header">
                <h3>Payout &amp; Account Details</h3>
                <span class="badge-verified">✓ Verified</span>
            </div>

            <div class="account-details">
                <div class="detail-group">
                    <label>Bank Name</label>
                    <span>@(Model?.BankName ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <label>Account Number</label>
                    <span class="font-mono">@(Model?.MaskedAccountNumber ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <label>IFSC Code</label>
                    <span class="font-mono">@(Model?.IfscCode ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <label>PAN Number</label>
                    <span class="font-mono">@(Model?.PanNumber ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <label>PF UAN Number</label>
                    <span class="font-mono">@(Model?.UanNumber ?? "N/A")</span>
                </div>
                <div class="detail-group">
                    <label>Payment Mode</label>
                    <span>@(Model?.PaymentMode ?? "N/A")</span>
                </div>
            </div>

            <div class="tax-declaration-banner">
                <div class="tax-info">
                    <h5>Tax Regime: @(Model?.TaxRegime ?? "N/A")</h5>
                    <p>Submit declarations to save Income Tax.</p>
                </div>
                <button class="btn-sm-primary" onclick="location.href='@Url.Action("ManageTax", "Payroll")'">Manage Tax</button>
            </div>
        </div>

    </div>

    <!-- BOTTOM: Payslip Downloads Table -->
    <div class="glass-card table-section">
        <div class="card-header">
            <h3>Monthly Payslips History</h3>
            <div class="filter-controls">
                <select class="year-select" id="financialYearSelect" onchange="filterPayslips(this.value)">
                    @if (Model?.AvailableFinancialYears != null)
                    {
                        foreach (var fy in Model.AvailableFinancialYears)
                        {
                            <option value="@fy.Value" selected="@fy.Selected">@fy.Text</option>
                        }
                    }
                    else
                    {
                        <option value="2026">2025-2026</option>
                    }
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Month &amp; Year</th>
                        <th>Gross Amount</th>
                        <th>Deductions</th>
                        <th>Net Paid</th>
                        <th>Payment Date</th>
                        <th>Status</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.PayslipHistory != null)
                    {
                        foreach (var payslip in Model.PayslipHistory)
                        {
                            <tr>
                                <td><strong>@payslip.MonthYear</strong></td>
                                <td>@payslip.GrossAmount.ToString("C0", new System.Globalization.CultureInfo("hi-IN"))</td>
                                <td>@payslip.DeductionsAmount.ToString("C0", new System.Globalization.CultureInfo("hi-IN"))</td>
                                <td><strong class="text-green">@payslip.NetPaid.ToString("C0", new System.Globalization.CultureInfo("hi-IN"))</strong></td>
                                <td>@payslip.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge badge-paid">@payslip.Status</span></td>
                                <td class="text-right">
                                    <button class="btn-action" onclick="location.href='@Url.Action("DownloadPayslip", "Payroll", new { id = payslip.Id })'">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                        Download
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: #64748b;">No payslip history found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
