@model VertexERP.Models.EmployeeDirectoryViewModel
@{
    ViewData["Title"] = "Employee Dashboard";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/EmployeeDashboard.css" rel="stylesheet" asp-append-version="true" />

<div class="employee-dashboard-wrapper">
    <div class="dashboard-header-card">
        <div class="header-left"><div><h2>Employee Management</h2><p>Manage employees, departments and system users efficiently.</p></div></div>
        <div class="header-right">
            <a asp-controller="Hr" asp-action="HrAddEmp" class="btn-primary-glow" id="addEmployeeBtn"><i class="fa-solid fa-user-plus"></i> Add Employee</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon total-icon"><i class="fa-solid fa-users"></i></div><div class="stat-details"><span class="stat-value">@Model.TotalEmployees</span><span class="stat-label">Total Employees</span></div></div>
        <div class="stat-card"><div class="stat-icon active-icon"><i class="fa-solid fa-user-check"></i></div><div class="stat-details"><span class="stat-value">@Model.ActiveEmployees</span><span class="stat-label">Active</span></div></div>
        <div class="stat-card"><div class="stat-icon inactive-icon"><i class="fa-solid fa-user-xmark"></i></div><div class="stat-details"><span class="stat-value">@Model.InactiveEmployees</span><span class="stat-label">Inactive</span></div></div>
        <div class="stat-card"><div class="stat-icon dept-icon"><i class="fa-solid fa-briefcase"></i></div><div class="stat-details"><span class="stat-value">@Model.TotalDepartments</span><span class="stat-label">Departments</span></div></div>
    </div>

    @if (TempData["EmployeeMessage"] is string message)
    {
        <div class="employee-message"><i class="fa-solid fa-circle-check"></i> @message</div>
    }
    @if (TempData["CreatedLoginUsername"] is string createdUsername && TempData["CreatedLoginPassword"] is string createdPassword)
    {
        <section class="created-login-card" aria-label="New employee login credentials">
            <div><span class="created-login-kicker">LOGIN READY</span><h3>New account credentials</h3><p>Copy these exact, case-sensitive credentials and share them securely with the employee.</p></div>
            <div class="created-login-values">
                <label>Username <span id="createdLoginUsername">@createdUsername</span><button type="button" onclick="copyCreatedCredential('createdLoginUsername', this)">Copy</button></label>
                <label>Password <span id="createdLoginPassword">@createdPassword</span><button type="button" onclick="copyCreatedCredential('createdLoginPassword', this)">Copy</button></label>
                <label>Role <span>@TempData["CreatedLoginRole"]</span></label>
            </div>
            <small>This password is shown only once on this screen.</small>
        </section>
        <script>
            async function copyCreatedCredential(id, button) {
                await navigator.clipboard.writeText(document.getElementById(id).textContent.trim());
                const oldText = button.textContent; button.textContent = 'Copied';
                setTimeout(() => button.textContent = oldText, 1400);
            }
        </script>
    }
    @if (TempData["EmployeeError"] is string error)
    {
        <div class="employee-message employee-error"><i class="fa-solid fa-circle-exclamation"></i> @error</div>
    }

    <form asp-controller="Employee" asp-action="Index" method="get" class="toolbar-card" id="employeeFilterForm">
        <div class="search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" name="search" value="@Model.Search" placeholder="Search by employee ID, name, email or department..." /></div>
        <select name="department" class="employee-filter" aria-label="Filter by department" onchange="this.form.submit()">
            <option value="">All departments</option>
            @foreach (var item in Model.Departments) { <option value="@item" selected="@(Model.Department == item)">@item</option> }
        </select>
        <select name="status" class="employee-filter" aria-label="Filter by status" onchange="this.form.submit()">
            <option value="">All statuses</option>
            <option value="active" selected="@(Model.Status == "active")">Active</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
        </select>
        <button type="submit" class="btn-secondary"><i class="fa-solid fa-filter"></i> Filter</button>
    </form>

    <div class="glass-card table-section">
        <div class="card-header"><div class="card-title-group"><h3>Employee Directory</h3><span class="badge-accent">Live Records</span></div></div>
        <div class="table-responsive">
            <table class="modern-table">
                <thead><tr><th>Employee ID</th><th>Name</th><th>Email</th><th>Department</th><th>Designation</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @if (Model.Employees.Count > 0)
                {
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td><span class="code-text">@employee.EmployeeCode</span></td>
                            <td class="fw-semibold">@employee.FullName</td>
                            <td>@employee.Email</td>
                            <td>@employee.Department</td>
                            <td>@employee.Designation</td>
                            <td><span class="status-badge @(employee.IsActive ? "badge-active" : "badge-inactive")">@employee.EmployeeStatus</span></td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@employee.Id" class="action-btn" title="View employee"><i class="fa-solid fa-eye"></i></a>
                                    <a asp-controller="Main" asp-action="Employees" asp-route-id="@employee.Id" class="action-btn" title="Open employee self-service profile"><i class="fa-solid fa-id-card"></i></a>
                                    <a asp-controller="Employee" asp-action="LoginAccess" asp-route-id="@employee.Id" class="action-btn" title="Update username or reset password"><i class="fa-solid fa-key"></i></a>
                                    <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.Id" class="action-btn edit-action" title="Edit employee"><i class="fa-solid fa-pen-to-square"></i></a>
                                    <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.Id" class="action-btn delete-action" title="Delete employee"><i class="fa-solid fa-user-slash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center-muted"><div class="empty-state"><i class="fa-solid fa-folder-open"></i><p>No employee records found.</p></div></td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
