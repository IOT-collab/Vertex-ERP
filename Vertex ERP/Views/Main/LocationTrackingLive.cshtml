@model VertexERP.Models.SiteEmployeeLocationViewModel
@{ ViewData["Title"]="Employee Location Tracking";Layout="~/Views/Shared/_LayoutMaster.cshtml";var s=Model.SelectedEmployee;var date=Context.Request.Query["date"].ToString(); }
<style>.lt{max-width:1250px;margin:26px auto;padding:0 18px}.lt h1{color:#172a46}.lt-grid{display:grid;grid-template-columns:330px 1fr;gap:18px}.lt-list,.lt-detail{background:#fff;border:1px solid #dbe4ef;border-radius:14px;padding:16px}.lt-form{display:flex;gap:7px;margin-bottom:14px}.lt-form input,.lt-form button{padding:9px;border:1px solid #cbd5e1;border-radius:8px}.lt-form button{background:#2563eb;color:white;font-weight:700}.emp{display:block;padding:11px;margin:5px 0;text-decoration:none;color:#172a46;border-radius:9px}.emp:hover,.emp.sel{background:#eef5ff}.emp small{display:block;color:#64748b;margin-top:3px}.tag{display:inline-block;padding:3px 7px;border-radius:99px;background:#dcfce7;color:#166534;font-size:11px;margin-top:5px}.tag.out,.tag.none{background:#f1f5f9;color:#64748b}.profile{border-bottom:1px solid #e2e8f0;padding-bottom:14px}.profile h2{margin:0}.profile p{color:#64748b}.punches{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}.punch{border:1px solid #dbe4ef;border-radius:11px;padding:15px}.punch h3{margin:0;color:#2563eb}.punch.out h3{color:#059669}.punch p{color:#475569}.map{color:#1d4ed8;font-weight:700}.selfie{width:150px;height:150px;object-fit:cover;border-radius:10px;border:1px solid #cbd5e1}@@media(max-width:780px){.lt-grid,.punches{grid-template-columns:1fr}}</style>
<main class="lt"><h1>Employee Location Tracking</h1><p>HR/Admin can see all employees and their field attendance location, time, accuracy and selfie.</p><div class="lt-grid"><aside class="lt-list"><form class="lt-form"><input type="date" name="date" value="@date"><button>View</button></form><b>Employees (@Model.Employees.Count)</b>@foreach(var e in Model.Employees){<a class="emp @(s?.EmployeeId==e.EmployeeId?"sel":"")" asp-action="LocationTracking" asp-route-date="@date" asp-route-employeeId="@e.EmployeeId"><b>@e.EmployeeName</b><small>@e.EmployeeCode · @e.Department</small><span class="tag @(e.IsCheckedOut?"out":e.CheckInTime.HasValue?"":"none")">@(e.CheckInTime.HasValue?(e.IsCheckedOut?"Checked out":"Checked in"):"No field attendance")</span></a>}</aside><section class="lt-detail">@if(s is null){<p>Select an employee who has field attendance for the selected date.</p>}else{<div class="profile"><h2>@s.EmployeeName</h2><p>@s.EmployeeCode · @s.Designation · @s.Department</p></div><div class="punches"><article class="punch"><h3>Check In</h3>@if(s.CheckInTime.HasValue){<p><b>Time:</b> @s.CheckInTime.Value.ToString("dd MMM yyyy, hh:mm tt")</p><p><b>GPS:</b> @s.CheckInLatitude, @s.CheckInLongitude<br><b>Accuracy:</b> @(s.CheckInAccuracyMetres?.ToString("0.0")??"—") m</p><a class="map" target="_blank" href="https://www.google.com/maps?q=@s.CheckInLatitude,@s.CheckInLongitude">Open location on map</a>@if(s.CheckInSelfiePath is not null){<p><img class="selfie" src="@s.CheckInSelfiePath" alt="Check-in selfie"></p>}}else{<p>No check-in recorded.</p>}</article><article class="punch out"><h3>Check Out</h3>@if(s.CheckOutTime.HasValue){<p><b>Time:</b> @s.CheckOutTime.Value.ToString("dd MMM yyyy, hh:mm tt")</p><p><b>GPS:</b> @s.CheckOutLatitude, @s.CheckOutLongitude<br><b>Accuracy:</b> @(s.CheckOutAccuracyMetres?.ToString("0.0")??"—") m</p><a class="map" target="_blank" href="https://www.google.com/maps?q=@s.CheckOutLatitude,@s.CheckOutLongitude">Open location on map</a>@if(s.CheckOutSelfiePath is not null){<p><img class="selfie" src="@s.CheckOutSelfiePath" alt="Check-out selfie"></p>}}else{<p>Check-out not recorded yet.</p>}</article></div>}</section></div></main>
