@model VertexERP.Models.SiteEmployeeLocationViewModel
@using VertexERP.Services
@{ ViewData["Title"]="Site Employee Location"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; var selected=Model.SelectedEmployee; var date=Model.SelectedDate.ToString("yyyy-MM-dd");
string Map(decimal? latitude,decimal? longitude)=>FormattableString.Invariant($"https://www.google.com/maps?q={latitude:F6},{longitude:F6}"); }
<link href="~/css/site-location-cards.css" rel="stylesheet" asp-append-version="true"/>
<main class="sl-page" data-site-location-page>
<header class="sl-header"><div><span class="sl-kicker">SITE ATTENDANCE</span><h1>Site Employee Location</h1><p>@(Model.IsManagerView?"Your team's":"Employee") recorded site check-ins and check-outs. GPS is captured at attendance time, not continuously.</p></div><span class="sl-live"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Updates every 15 seconds</span></header>
<form asp-action="LocationTracking" method="get" class="sl-date"><label for="sl-date">Attendance date</label><input id="sl-date" name="date" type="date" min="2000-01-01" max="2100-12-31" value="@date" required/><button type="submit">View</button></form>
<div class="sl-grid" data-site-location-content>
<aside class="sl-roster"><div class="sl-section-title"><h2>Site employees <span>@Model.Employees.Count</span></h2><small>@Model.SelectedDate.ToString("dd MMM yyyy")</small></div>
@if(Model.Employees.Count==0){<div class="sl-empty"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><strong>No site attendance found</strong><p>No employee has marked site attendance for this date.</p></div>}
@foreach(var employee in Model.Employees){
<a class="sl-person @(selected?.EmployeeId==employee.EmployeeId?"selected":"")" asp-action="LocationTracking" asp-route-date="@date" asp-route-employeeId="@employee.EmployeeId" data-site-employee="@employee.EmployeeId" aria-current="@(selected?.EmployeeId==employee.EmployeeId?"true":null)">
<div class="sl-person-heading"><span class="sl-avatar"><span>@ManagerDashboardPresentation.Initials(employee.EmployeeName)</span>@if(!string.IsNullOrWhiteSpace(employee.PhotoPath)){<img src="@employee.PhotoPath" alt="@employee.EmployeeName profile photo" loading="lazy" onerror="this.hidden=true"/>}</span><div class="sl-person-name"><strong>@employee.EmployeeName</strong><small>@employee.EmployeeCode</small></div><span class="sl-status @(employee.IsCheckedOut?"out":"in")">@(employee.IsCheckedOut?"Checked out":"On site")</span></div>
<p class="sl-job">@employee.Department · @employee.Designation</p><p class="sl-site"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @(employee.LastSiteName??employee.CheckOutSiteName??employee.CheckInSiteName??"Site not provided")</p>
<div class="sl-times"><span><small>Check in</small><b>@(employee.CheckInTime?.ToString("hh:mm tt")??"—")</b></span><span><small>Check out</small><b>@(employee.CheckOutTime?.ToString("hh:mm tt")??"—")</b></span></div></a>}
</aside>
<section class="sl-details" aria-label="Selected employee site attendance">
@if(selected==null){<div class="sl-panel sl-empty"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><h2>Recorded site locations</h2><p>Employee cards will appear automatically as site attendance is marked.</p></div>}
else{
<header class="sl-panel sl-selected"><span class="sl-avatar large"><span>@ManagerDashboardPresentation.Initials(selected.EmployeeName)</span>@if(!string.IsNullOrWhiteSpace(selected.PhotoPath)){<img src="@selected.PhotoPath" alt="@selected.EmployeeName profile photo" onerror="this.hidden=true"/>}</span><div><h2>@selected.EmployeeName</h2><p>@selected.EmployeeCode · @selected.Department</p><small>@selected.Designation</small></div></header>
<div class="sl-punch-grid">@foreach(var checkout in new[]{false,true}){var time=checkout?selected.CheckOutTime:selected.CheckInTime;var latitude=checkout?selected.CheckOutLatitude:selected.CheckInLatitude;var longitude=checkout?selected.CheckOutLongitude:selected.CheckInLongitude;var accuracy=checkout?selected.CheckOutAccuracyMetres:selected.CheckInAccuracyMetres;var selfie=checkout?selected.CheckOutSelfiePath:selected.CheckInSelfiePath;var site=checkout?selected.CheckOutSiteName:selected.CheckInSiteName;
<article class="sl-panel sl-punch"><h3><i class="fa-solid @(checkout?"fa-arrow-right-from-bracket":"fa-arrow-right-to-bracket")" aria-hidden="true"></i> @(checkout?"Check out":"Check in")</h3>@if(time.HasValue){<dl><dt>Site</dt><dd>@(site??"Not provided")</dd><dt>Time (IST)</dt><dd>@time.Value.ToString("dd MMM yyyy · hh:mm tt")</dd><dt>GPS accuracy</dt><dd>@(accuracy.HasValue?accuracy.Value.ToString("0.0")+" m":"Not recorded")</dd></dl>@if(latitude.HasValue&&longitude.HasValue){<p class="sl-coordinates">@latitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture), @longitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture)</p><a class="sl-map-link" href="@Map(latitude,longitude)" target="_blank" rel="noopener noreferrer">Open recorded location on map <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>}else{<p>GPS coordinates not recorded.</p>}@if(!string.IsNullOrWhiteSpace(selfie)){<a href="@selfie" target="_blank" rel="noopener noreferrer"><img class="sl-selfie" src="@selfie" alt="@(checkout?"Check-out":"Check-in") attendance selfie" loading="lazy"/></a>}}else{<p class="sl-muted">@(checkout?"Check-out not recorded yet.":"Check-in not recorded.")</p>}</article>}
</div>
@if(selected.LastLatitude.HasValue&&selected.LastLongitude.HasValue){<article class="sl-panel"><h3>Latest recorded site location</h3><iframe class="sl-map" title="Latest recorded attendance location" src="@(Map(selected.LastLatitude,selected.LastLongitude)+"&output=embed")" loading="lazy" allowfullscreen></iframe></article>}
}
</section></div><p class="sl-refresh-state" data-site-refresh-status role="status"></p></main>
<script src="~/js/site-location-cards.js" asp-append-version="true" defer></script>
