@model VertexERP.Models.VerifyResetOtpViewModel
@{ ViewData["Title"] = "Verify OTP"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Verify OTP - Vertex ERP</title><link href="~/css/Login.css" rel="stylesheet" asp-append-version="true"/></head>
<body><main class="login-shell"><section class="login-card"><div class="login-heading"><span class="eyebrow">Password Recovery</span><h1>Verify OTP</h1><p>@(TempData["ResetNotice"] ?? "Enter the six-digit OTP sent to your registered email.")</p></div><form asp-action="VerifyResetOtp" method="post" class="login-form"><input asp-for="Email" type="hidden"/><div asp-validation-summary="ModelOnly" class="login-alert"></div><div class="form-group"><label asp-for="Otp"></label><div class="input-shell"><span class="input-icon">OTP</span><input asp-for="Otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456"/></div><span asp-validation-for="Otp"></span></div><button type="submit" class="login-button">Verify code <span aria-hidden="true">-&gt;</span></button></form><p class="login-footnote"><a asp-action="ForgotPassword">Use a different email</a></p></section></main></body></html>
