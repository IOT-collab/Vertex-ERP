@model VertexERP.Models.BankApprovalViewModel
@{ ViewData["Title"]="Bank Update Requests"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/BankDetails.css" rel="stylesheet" asp-append-version="true" />
<section class="bank-page"><header><div><span>HR VERIFICATION</span><h1>Bank Update Requests</h1><p>Only approved requests update the employee master bank record.</p></div></header><article class="bank-card request-history">@if(Model.Requests.Count==0){<div class="bank-empty">No bank update requests.</div>}else{<table><thead><tr><th>Employee</th><th>Requested Details</th><th>Date</th><th>Status</th><th>HR Action</th></tr></thead><tbody>@foreach(var request in Model.Requests){<tr><td><strong>@request.Employee.FullName</strong><small>@request.Employee.EmployeeCode</small></td><td><strong>@request.BankName · XXXX @request.AccountLastFour</strong><small>@request.IfscCode · @request.AccountType</small></td><td>@request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="@request.Status.ToLowerInvariant()">@request.Status</span></td><td>@if(request.Status=="Pending"){<form asp-action="ReviewBankUpdate" method="post" class="review-form"><input type="hidden" name="id" value="@request.Id"/><input name="note" placeholder="HR note"/><button name="decision" value="Approved" class="bank-primary">Approve & Update</button><button name="decision" value="Rejected" class="bank-danger">Reject</button></form>}else{<small>@(request.HrNote??"Reviewed")</small>}</td></tr>}</tbody></table>}</article></section>
