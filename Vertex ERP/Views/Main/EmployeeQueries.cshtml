@model VertexERP.Models.EmployeeQueryViewModel
@{ ViewData["Title"]="Raise Query"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>Raise Query</h1><p>Your query will be visible to your reporting manager and HR.</p></div></header><article class="employee-panel">@if(TempData["QueryMessage"]!=null){<p class="present">@TempData["QueryMessage"]</p>}@if(TempData["QueryError"]!=null){<p class="absent">@TempData["QueryError"]</p>}<form asp-action="RaiseQuery" method="post" class="leave-form"><label>Subject<input name="subject" maxlength="150" required/></label><label>Category<select name="category"><option>General</option><option>Attendance</option><option>Payroll</option><option>Task</option><option>Leave</option><option>Technical</option></select></label><label class="wide">Query Details<textarea name="description" rows="4" maxlength="1500" required></textarea></label><button type="submit" class="btn btn-primary">Raise Ticket</button></form><h3>My Tickets</h3>@if(Model.Tickets.Count==0){<div class="employee-empty">No query tickets raised.</div>}else{<table class="employee-table"><thead><tr><th>Ticket</th><th>Category</th><th>Raised On</th><th>Status</th><th>Response</th></tr></thead><tbody>@foreach(var ticket in Model.Tickets){<tr><td><strong>#@ticket.Id · @ticket.Subject</strong><small>@ticket.Description</small></td><td>@ticket.Category</td><td>@ticket.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="employee-badge">@ticket.Status</span></td><td>@(ticket.Resolution??"Awaiting response")</td></tr>}</tbody></table>}</article></section>
