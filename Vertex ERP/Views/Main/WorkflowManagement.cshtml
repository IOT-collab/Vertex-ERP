@model VertexERP.Models.WorkflowManagementViewModel
@{ ViewData["Title"]="Leave & Query Workflow"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>Leave & Query Workflow</h1><p>Organization-wide leave status and employee query tickets</p></div></header><article class="employee-panel"><h3>Leave Requests</h3>@if(Model.LeaveRequests.Count==0){<div class="employee-empty">No leave requests.</div>}else{<table class="employee-table"><thead><tr><th>Applicant</th><th>Type / Dates</th><th>Approval Route</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var leave in Model.LeaveRequests){<tr><td><strong>@leave.Employee.FullName</strong><small>@leave.Employee.EmployeeCode · @leave.Employee.Designation</small></td><td>@leave.LeaveType<small>@leave.FromDate.ToString("dd MMM") - @leave.ToDate.ToString("dd MMM yyyy") (@(leave.ToDate.DayNumber-leave.FromDate.DayNumber+1) days)</small></td><td>@leave.ApprovalLevel<small>@(leave.AssignedApproverEmployee?.FullName??"HR / Admin")</small></td><td><span class="employee-badge @leave.Status.ToLowerInvariant()">@leave.Status</span></td><td>@if(leave.Status=="Pending"&&leave.ApprovalLevel=="HR/Admin"){<form asp-action="DecideManagerLeave" method="post"><input type="hidden" name="id" value="@leave.Id"/><button name="decision" value="Approved" class="btn btn-primary">Approve</button><button name="decision" value="Rejected" class="btn btn-secondary">Reject</button></form>}else{<small>@(leave.DecidedAtUtc?.ToLocalTime().ToString("dd MMM yyyy")??"Awaiting manager")</small>}</td></tr>}</tbody></table>}</article><article class="employee-panel" style="margin-top:16px"><h3>Employee Query Tickets</h3>@if(Model.QueryTickets.Count==0){<div class="employee-empty">No query tickets.</div>}else{<table class="employee-table"><thead><tr><th>Employee</th><th>Query</th><th>Manager</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach(var ticket in Model.QueryTickets){<tr><td><strong>@ticket.Employee.FullName</strong><small>@ticket.Employee.EmployeeCode</small></td><td><strong>#@ticket.Id · @ticket.Subject</strong><small>@ticket.Description</small></td><td>@(ticket.ReportingManager?.FullName??"Not assigned")</td><td><span class="employee-badge">@ticket.Status</span></td><td><form asp-action="UpdateQueryTicket" method="post"><input type="hidden" name="id" value="@ticket.Id"/><input name="resolution" value="@ticket.Resolution" placeholder="Response"/><select name="status"><option>In Progress</option><option>Resolved</option><option>Closed</option></select><button class="btn btn-primary">Save</button></form></td></tr>}</tbody></table>}</article></section>
