@model VertexERP.Models.ManagerAttendanceViewModel
@{ ViewData["Title"]="Team Attendance"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/ManagerSections.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-section"><header><h1>Team Attendance</h1><p>Today's attendance status for your reporting team</p></header><div class="section-stats"><div><i class="fa-solid fa-users"></i><span><small>Team Members</small><b>@Model.TeamMembers.Count</b></span></div><div><i class="fa-solid fa-user-check green"></i><span><small>Present</small><b>@Model.Present</b></span></div><div><i class="fa-solid fa-user-xmark red"></i><span><small>Absent</small><b>@Model.Absent</b></span></div><div><i class="fa-solid fa-plane orange"></i><span><small>On Leave</small><b>@Model.OnLeave</b></span></div></div><article class="section-card"><h3>Employee Attendance — @DateTime.Today.ToString("dd MMMM yyyy")</h3><div class="section-table"><table><thead><tr><th>Employee</th><th>ID</th><th>Department</th><th>Designation</th><th>Status</th></tr></thead><tbody>@foreach(var employee in Model.TeamMembers){var status=Model.OnLeaveIds.Contains(employee.Id)?"On Leave":Model.PresentIds.Contains(employee.Id)?"Present":"Absent";<tr><td><b>@employee.FullName</b><small>@employee.Email</small></td><td>@employee.EmployeeCode</td><td>@employee.Department</td><td>@employee.Designation</td><td><em class="@status.Replace(" ","").ToLowerInvariant()">@status</em></td></tr>}</tbody></table></div></article></section>
