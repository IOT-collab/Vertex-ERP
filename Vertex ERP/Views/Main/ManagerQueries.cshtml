@model VertexERP.Models.ManagerSectionViewModel
@{ ViewData["Title"]="Employee Queries"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/ManagerSections.css" rel="stylesheet" asp-append-version="true" /><link href="~/css/WorkflowUi.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-section"><header><h1>Employee Queries</h1><p>Tickets raised by employees who report to you</p></header><div class="section-stats"><div><i class="fa-regular fa-circle-question"></i><span><small>Total Tickets</small><b>@Model.QueryTickets.Count</b></span></div><div><i class="fa-regular fa-clock orange"></i><span><small>Open</small><b>@Model.QueryTickets.Count(x=>x.Status=="Open")</b></span></div><div><i class="fa-solid fa-spinner orange"></i><span><small>In Progress</small><b>@Model.QueryTickets.Count(x=>x.Status=="In Progress")</b></span></div><div><i class="fa-regular fa-circle-check green"></i><span><small>Resolved</small><b>@Model.QueryTickets.Count(x=>x.Status=="Resolved"||x.Status=="Closed")</b></span></div></div><article class="section-card"><div class="section-table"><table><thead><tr><th>Employee</th><th>Ticket</th><th>Status</th><th>Response</th></tr></thead><tbody>@if(Model.QueryTickets.Count==0){<tr><td colspan="4" class="no-data">No employee queries assigned to you.</td></tr>}else{@foreach(var ticket in Model.QueryTickets){<tr><td><b>@ticket.Employee.FullName</b><small>@ticket.Employee.EmployeeCode</small></td><td><b>#@ticket.Id · @ticket.Subject</b><small>@ticket.Description</small></td><td><em>@ticket.Status</em></td><td><form asp-action="UpdateQueryTicket" method="post" class="query-response-form"><input type="hidden" name="id" value="@ticket.Id"/><input name="resolution" value="@ticket.Resolution" placeholder="Write response"/><select name="status"><option selected="@(ticket.Status=="In Progress")">In Progress</option><option selected="@(ticket.Status=="Resolved")">Resolved</option><option selected="@(ticket.Status=="Closed")">Closed</option></select><button class="workflow-btn primary">Save Response</button></form></td></tr>}}</tbody></table></div></article></section>
