@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Vertex ERP</title>
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/common-ui.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <div class="ai-holo-bg" aria-hidden="true">
            <div class="holo-room"></div>
            <div class="holo-assistant">
                <span class="holo-ring ring-one"></span>
                <span class="holo-ring ring-two"></span>
                <span class="holo-ring ring-three"></span>
                <span class="holo-core"></span>
                <span class="voice-wave wave-one"></span>
                <span class="voice-wave wave-two"></span>
                <span class="voice-wave wave-three"></span>
                <span class="voice-wave wave-four"></span>
                <span class="voice-wave wave-five"></span>
                <span class="holo-node node-one"></span>
                <span class="holo-node node-two"></span>
                <span class="holo-node node-three"></span>
            </div>
        </div>

        <section class="login-card" aria-labelledby="loginTitle">
            <div class="logo-placeholder">
                <img src="~/images/vertex-group-logo.png" alt="Vertex Group" />
            </div>

            <div class="login-heading">
                <span class="eyebrow">Enterprise Access</span>
                <h1 id="loginTitle">Welcome to Vertex ERP</h1>
                <p>Sign in with your employee credentials to continue.</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="login-alert">@ViewBag.ErrorMessage</div>
            }

            <form asp-action="Login" asp-controller="Main" method="post" autocomplete="off" class="login-form">
                <div class="form-group">
                    <label for="email">Employee ID / Username</label>
                    <div class="input-shell">
                        <span class="input-icon">ID</span>
                        <input id="email" name="email" type="text" placeholder="Enter employee ID or username" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-shell">
                        <span class="input-icon">***</span>
                        <input id="password" name="password" type="password" placeholder="Enter password" required />
                        <button type="button" class="password-visibility" id="togglePassword" aria-label="Show password" title="Show password">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                </div>

                <div class="login-options">
                    <label class="remember-option">
                        <input type="checkbox" name="RememberMe" />
                        <span></span>
                        Remember me
                    </label>
                    <a href="#" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="login-button">
                    Login
                    <span aria-hidden="true">-&gt;</span>
                </button>
            </form>

            <p class="login-footnote">Secure ERP workspace access</p>
        </section>
    </main>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const password = document.getElementById('password');
            const showing = password.type === 'text';
            password.type = showing ? 'password' : 'text';
            this.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />${showing ? '' : '<path d="m3 3 18 18" />'}</svg>`;
            this.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
            this.title = showing ? 'Show password' : 'Hide password';
        });
    </script>
</body>
</html>
