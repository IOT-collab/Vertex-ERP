@model VertexERP.Models.Employee
@{ ViewData["Title"]="My Profile"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/ProfileEnhancements.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section profile-page">
 <header><div><h1>My Profile</h1><p>Your personal and employment information</p></div><a asp-action="EditEmployeeProfile" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Update Profile</a></header>
 @if(TempData["ProfileMessage"]!=null){<div class="profile-success"><i class="fa-solid fa-circle-check"></i>@TempData["ProfileMessage"]</div>}
 <article class="employee-panel profile-cover"><div class="profile-head">@if(!string.IsNullOrWhiteSpace(Model.PhotoPath)){<img src="@Model.PhotoPath" alt="@Model.FullName"/>}else{<div class="avatar"><i class="fa-regular fa-user"></i></div>}<div><span class="profile-kicker">EMPLOYEE PROFILE</span><h2>@Model.FullName</h2><div class="profile-tags"><span>@Model.EmployeeCode</span><span>@Model.EmployeeStatus</span><span>@Model.EmploymentType</span></div></div></div><div class="profile-quick"><div><small>Department</small><strong>@Model.Department</strong></div><div><small>Designation</small><strong>@Model.Designation</strong></div><div><small>Reporting Manager</small><strong>@(Model.ReportingManager?.FullName??"Not assigned")</strong></div></div></article>
 <div class="profile-sections"><article class="employee-panel"><h3><i class="fa-regular fa-address-card"></i> Personal Information</h3><div class="profile-grid">@foreach(var field in new[]{("First Name",Model.FirstName),("Last Name",Model.LastName??"--"),("Date of Birth",Model.DateOfBirth?.ToString("dd MMM yyyy")??"--"),("Gender",Model.Gender??"--"),("Marital Status",Model.MaritalStatus??"--"),("Emergency Contact",Model.EmergencyContact??"--")}){<div class="profile-field"><small>@field.Item1</small><strong>@field.Item2</strong></div>}</div></article>
 <article class="employee-panel"><h3><i class="fa-regular fa-envelope"></i> Contact Information</h3><div class="profile-grid">@foreach(var field in new[]{("Email Address",Model.Email),("Mobile Number",Model.PhoneNumber),("Work Location",Model.WorkLocation??"--"),("Address",Model.Address??"--"),("City",Model.City??"--"),("State / PIN",$"{Model.State??"--"} · {Model.PinCode??"--"}")}){<div class="profile-field"><small>@field.Item1</small><strong>@field.Item2</strong></div>}</div></article>
 <article class="employee-panel profile-wide"><h3><i class="fa-solid fa-briefcase"></i> Employment Information</h3><div class="profile-grid profile-grid-four">@foreach(var field in new[]{("Employee ID",Model.EmployeeCode),("Department",Model.Department),("Designation",Model.Designation),("Joining Date",Model.JoiningDate.ToString("dd MMM yyyy")),("Employment Type",Model.EmploymentType),("Reporting Manager",Model.ReportingManager?.FullName??"Not assigned"),("Status",Model.EmployeeStatus),("Last Updated",Model.UpdatedDate?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")??"Not updated")}){<div class="profile-field"><small>@field.Item1</small><strong>@field.Item2</strong></div>}</div></article></div>
</section>
