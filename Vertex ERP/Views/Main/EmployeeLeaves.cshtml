@model VertexERP.Models.EmployeeLeaveViewModel
@{ ViewData["Title"]="Leave Management"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>Leave Management</h1><p>Leave balance, usage and requests for @Model.Employee.FullName</p></div></header><div class="leave-grid"><article class="employee-panel leave-balance"><small>Casual Leave</small><strong>@Model.CasualRemaining days left</strong><div><span>Used</span><b>@Model.CasualUsed / 12</b></div></article><article class="employee-panel leave-balance"><small>Sick Leave</small><strong>@Model.SickRemaining days left</strong><div><span>Used</span><b>@Model.SickUsed / 8</b></div></article><article class="employee-panel leave-balance"><small>Earned Leave</small><strong>@Model.EarnedRemaining days left</strong><div><span>Used</span><b>@Model.EarnedUsed / 12</b></div></article></div><div class="employee-panel"><h3>Apply Leave</h3>@if(TempData["LeaveMessage"]!=null){<p class="present">@TempData["LeaveMessage"]</p>}@if(TempData["LeaveError"]!=null){<p class="absent">@TempData["LeaveError"]</p>}<form asp-action="ApplyLeave" method="post" class="leave-form"><label>Leave Type<select name="leaveType" required><option value="">Select type</option><option>Casual Leave</option><option>Sick Leave</option><option>Earned Leave</option><option>Unpaid Leave</option></select></label><label>From Date<input type="date" name="fromDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>To Date<input type="date" name="toDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label class="wide">Reason<textarea name="reason" rows="3" required></textarea></label><button class="btn btn-primary" type="submit">Submit Leave Request</button></form><h3>Leave History</h3>@if(Model.Requests.Count==0){<div class="employee-empty">No leave requests.</div>}else{<table class="employee-table"><thead><tr><th>Type</th><th>Dates</th><th>Reason</th><th>Status</th></tr></thead><tbody>@foreach(var leave in Model.Requests){<tr><td>@leave.LeaveType</td><td>@leave.FromDate.ToString("dd MMM") - @leave.ToDate.ToString("dd MMM yyyy")</td><td>@leave.Reason</td><td><span class="employee-badge @leave.Status.ToLowerInvariant()">@leave.Status</span></td></tr>}</tbody></table>}</div></section>
