@model VertexERP.Models.ManagerSectionViewModel
@{ ViewData["Title"]="Project Management"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; var completed=Model.Tasks.Count(x=>x.Status=="Completed"); }
<link href="~/css/ManagerSections.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-section"><header><h1>Project Management</h1><p>Your team's project work, progress and current status</p></header><div class="section-stats"><div><i class="fa-solid fa-folder-open"></i><span><small>Total Work Items</small><b>@Model.Tasks.Count</b></span></div><div><i class="fa-solid fa-spinner orange"></i><span><small>In Progress</small><b>@Model.Tasks.Count(x=>x.Status=="In Progress")</b></span></div><div><i class="fa-solid fa-circle-check green"></i><span><small>Completed</small><b>@completed</b></span></div><div><i class="fa-solid fa-chart-line"></i><span><small>Completion</small><b>@(Model.Tasks.Count==0?0:(completed*100/Model.Tasks.Count))%</b></span></div></div><article class="section-card"><h3>Project / Work Report</h3><div class="section-table"><table><thead><tr><th>Project / Work</th><th>Employee</th><th>Description</th><th>Priority</th><th>Due Date</th><th>Status</th></tr></thead><tbody>@if(Model.Tasks.Count==0){<tr><td colspan="6" class="no-data">No project work assigned.</td></tr>}else{@foreach(var task in Model.Tasks){<tr><td><b>@task.Title</b></td><td>@task.Assignee.FullName</td><td>@(task.Description??"--")</td><td>@task.Priority</td><td>@task.DueDate.ToString("dd MMM yyyy")</td><td><em>@task.Status</em></td></tr>}}</tbody></table></div></article></section>
