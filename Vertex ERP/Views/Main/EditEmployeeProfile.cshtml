@model VertexERP.Models.EmployeeProfileEditViewModel
@{ ViewData["Title"]="Update Profile"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/ProfileEnhancements.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>Update Profile</h1><p>Correct your personal information</p></div><a asp-action="EmployeeProfile" class="btn btn-secondary">Cancel</a></header><form asp-action="EditEmployeeProfile" method="post" class="employee-panel profile-edit-form"><div asp-validation-summary="ModelOnly" class="absent"></div><div class="readonly-notice"><i class="fa-solid fa-lock"></i><div><strong>HR-protected information</strong><span>Name, employee ID, email, mobile, department, designation, manager, joining date and employment type can only be changed by HR.</span></div></div><div class="profile-edit-grid"><label>Full Name<input value="@Model.FullName" disabled/></label><label>Employee ID<input value="@Model.EmployeeCode" disabled/></label><label>Email Address<input value="@Model.Email" disabled/></label><label>Mobile Number<input value="@Model.PhoneNumber" disabled/></label><label>Date of Birth<input asp-for="DateOfBirth" type="date"/></label><label>Gender<select asp-for="Gender"><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select></label><label>Marital Status<select asp-for="MaritalStatus"><option value="">Select</option><option>Single</option><option>Married</option><option>Other</option></select></label><label>Emergency Contact<input asp-for="EmergencyContact"/><span asp-validation-for="EmergencyContact"></span></label><label>Work Location<input asp-for="WorkLocation"/></label><label class="wide">Address<textarea asp-for="Address" rows="3"></textarea></label><label>City<input asp-for="City"/></label><label>State<input asp-for="State"/></label><label>PIN Code<input asp-for="PinCode"/><span asp-validation-for="PinCode"></span></label></div><div class="profile-form-actions"><a asp-action="EmployeeProfile" class="btn btn-secondary">Cancel</a><button type="submit" class="btn btn-primary">Save Changes</button></div></form></section>
