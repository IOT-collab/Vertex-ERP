@model VertexERP.Models.BankDetailRequestViewModel
@{ ViewData["Title"]="Request Bank Update"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/BankDetails.css" rel="stylesheet" asp-append-version="true" />
<section class="bank-page"><header><div><span>SECURE UPDATE REQUEST</span><h1>Update Bank Details</h1><p>Your information will not change until HR verifies and approves this request.</p></div></header><form asp-action="RequestBankUpdate" method="post" class="bank-card bank-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Account Holder Name<input asp-for="AccountHolderName"/><span asp-validation-for="AccountHolderName"></span></label><label>Bank Name<input asp-for="BankName"/><span asp-validation-for="BankName"></span></label><label>Account Number<input asp-for="AccountNumber" type="password"/><span asp-validation-for="AccountNumber"></span></label><label>Confirm Account Number<input asp-for="ConfirmAccountNumber" type="password"/><span asp-validation-for="ConfirmAccountNumber"></span></label><label>IFSC Code<input asp-for="IfscCode"/><span asp-validation-for="IfscCode"></span></label><label>Branch Name<input asp-for="BranchName"/></label><label>Account Type<select asp-for="AccountType"><option>Savings</option><option>Current</option><option>Salary</option></select></label><label>PAN Number<input asp-for="PanNumber"/></label><label>UAN / PF Number<input asp-for="UanNumber"/></label><label>ESIC Number<input asp-for="EsicNumber"/></label><label>UPI ID<input asp-for="UpiId"/></label><div class="wide bank-actions"><a asp-action="MyBankDetails" class="bank-secondary">Cancel</a><button class="bank-primary">Submit to HR</button></div></form></section>
