@* Attendance Management View *@
@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/Attendence.css" rel="stylesheet" />

<div class="attendance-panel-container">

    <!-- Header Hub -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-text">
                <h2>Attendance Management</h2>
                <p>Track global checkpoints, monthly metrics, total late limits, and remaining leave buckets.</p>
            </div>
        </div>

        <!-- Action Group -->
        <div class="header-actions">
            <a href="@Url.Action("AddAttendance", "Main")" class="btn-add">
                + Mark Attendance
            </a>
        </div>
    </div>

    <!-- Top Grid Cards Counters -->
    <div class="dashboard-cards">
        <div class="card present">
            <h3>@ViewBag.PresentCount</h3>
            <span>Present Today</span>
        </div>
        <div class="card absent">
            <h3>@ViewBag.AbsentCount</h3>
            <span>Absent Today</span>
        </div>
        <div class="card leave">
            <h3>@ViewBag.LeaveCount</h3>
            <span>On Leave</span>
        </div>
        <div class="card late">
            <h3>@ViewBag.LateCount</h3>
            <span>Late Arrivals</span>
        </div>
    </div>

    <!-- Query Filter Hub -->
    <form asp-action="Index" asp-controller="Attendance" method="get">
        <div class="filter-box">
            <div class="filter-field">
                <input type="text" name="searchQuery" placeholder="Search Employee...">
            </div>
            <div class="filter-field">
                <select name="departmentId" asp-items="ViewBag.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="filter-field">
                <input type="date" name="filterDate">
            </div>
            <div class="filter-field">
                <select name="status">
                    <option value="">All Statuses</option>
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Leave">Leave</option>
                    <option value="Late">Late</option>
                </select>
            </div>
            <div class="filter-field action-field">
                <button type="submit" class="btn-search">Run Search</button>
            </div>
        </div>
    </form>

    <!-- Core Database Full Width Roster Table Container -->
    <div class="table-box">
        <table>
            <thead>
                <tr>
                    <th>Emp ID</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Total Leaves</th>
                    <th>Leaves Taken</th>
                    <th>Leaves Left</th>
                    <th>Late Days</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EmpId</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.Department</td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>@item.CheckIn</td>
                            <td>@item.CheckOut</td>
                            <td><span class="txt-total">@item.TotalLeaves</span></td>
                            <td><span class="txt-used">@item.LeavesTaken</span></td>
                            <td><span class="txt-avail">@item.LeavesLeft</span></td>
                            <td><span class="txt-late">@item.LateDays</span></td>
                            <td>
                                <span class="status @(item.Status.ToLower())-status">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="@Url.Action("Edit", "Attendance", new { id = item.Id })" class="edit">Edit</a>
                                    <a href="@Url.Action("Delete", "Attendance", new { id = item.Id })" class="delete" onclick="return confirm('Are you sure?');">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12" style="text-align: center; color: #64748b; padding: 24px;">
                            No attendance records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
