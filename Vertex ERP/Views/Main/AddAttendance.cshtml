@* Add Attendance View *@
@{
    ViewData["Title"] = "Add Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/addattendence.css" rel="stylesheet" />

<div class="attendance-panel-container">

    <!-- Header Hub -->
    <div class="page-header">
        <div class="header-left">
            <div class="header-text">
                <h2>Mark Daily Attendance</h2>
                <p>Log automated or manual entry points, register check-in logs, and adjust baseline configurations.</p>
            </div>
        </div>
    </div>

    <!-- Master Form Wrapper Container -->
    <div class="form-container-wrapper">
        <form asp-action="AddAttendance" asp-controller="Attendance" method="post" class="attendance-form">

            <div class="form-grid">

                <!-- Left Section: Core Parameters -->
                <div class="form-main-section">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="EmployeeId">Select Employee</label>
                            <select id="EmployeeId" name="EmployeeId" asp-items="ViewBag.Employees" required>
                                <option value="" disabled selected>Choose Employee</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="LogDate">Attendance Date</label>
                            <input type="date" id="LogDate" name="LogDate" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="CheckInTime">Check-In Time</label>
                            <input type="time" id="CheckInTime" name="CheckInTime" />
                        </div>

                        <div class="form-group">
                            <label for="CheckOutTime">Check-Out Time</label>
                            <input type="time" id="CheckOutTime" name="CheckOutTime" />
                        </div>
                    </div>

                    <div class="form-row triple-row">
                        <div class="form-group">
                            <label for="TotalLeaves">Total Leaves Allocation</label>
                            <input type="number" id="TotalLeaves" name="TotalLeaves" placeholder="e.g. 24" min="0" />
                        </div>

                        <div class="form-group">
                            <label for="LeavesTaken">Leaves Availed / Taken</label>
                            <input type="number" id="LeavesTaken" name="LeavesTaken" placeholder="e.g. 0" min="0" />
                        </div>

                        <div class="form-group">
                            <label for="LateDays">Late Days Count</label>
                            <input type="number" id="LateDays" name="LateDays" placeholder="e.g. 0" min="0" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Remarks">Operational Remarks</label>
                        <textarea id="Remarks" name="Remarks" rows="3" placeholder="Document exceptions, on-field duty approvals, or notes..."></textarea>
                    </div>

                </div>

                <!-- Right Section: Status Anchors & Metadata -->
                <div class="form-side-section">

                    <div class="config-card">
                        <h3>Attendance Status</h3>

                        <div class="form-group">
                            <label for="Status">Checkpoint Status</label>
                            <select id="Status" name="Status" required>
                                <option value="" disabled selected>Select Status</option>
                                <option value="Present">Present</option>
                                <option value="Late">Late</option>
                                <option value="Leave">On Leave</option>
                                <option value="Absent">Absent</option>
                            </select>
                        </div>

                        <div class="checkbox-group">
                            <label class="custom-checkbox">
                                <input type="checkbox" name="IsOnField" value="true" />
                                <span class="checkmark"></span>
                                Mark as On-Field / Client Visit
                            </label>
                        </div>

                        <div class="checkbox-group">
                            <label class="custom-checkbox">
                                <input type="checkbox" name="IsPayrollIntegrated" value="true" checked />
                                <span class="checkmark"></span>
                                Standard Payroll Integration
                            </label>
                        </div>
                    </div>

                    <div class="info-alert-box">
                        <h4>Validation Trigger</h4>
                        <p>Committing this log updates automated biometric data structures for the designated employee for this date.</p>
                    </div>

                </div>
            </div>

            <!-- Operational Form Actions -->
            <div class="form-actions-footer">
                <a href="@Url.Action("Attendance", "Main")" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">Submit Attendance</button>
            </div>

        </form>
    </div>

</div>
