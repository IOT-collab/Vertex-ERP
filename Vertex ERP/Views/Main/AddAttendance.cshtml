@model VertexERP.Models.ManualAttendanceViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Mark Manual Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var direct = true;
    var employeesJson = JsonSerializer.Serialize(Model.Employees.Select(e => new { id = e.Id, name = e.FullName, code = e.EmployeeCode, department = e.Department, shiftStart = e.ShiftStartTime.ToString("HH:mm"), shiftEnd = e.ShiftEndTime.ToString("HH:mm") }));
}
<link href="~/css/AddAttendence.css" rel="stylesheet" asp-append-version="true" />

<section class="manual-attendance-page">
    <header class="manual-hero">
        <div><span class="manual-kicker"><i class="fa-solid fa-user-check"></i> AUTHORIZED MANUAL ENTRY</span><h1>@(direct ? "Mark Manual Attendance" : "Request Attendance Correction")</h1><p>Use this form when an employee could not record a biometric punch.</p></div>
        <span class="access-chip"><i class="fa-solid @(Model.IsManagerView ? "fa-people-group" : "fa-building")"></i> @(Model.IsManagerView ? "Your Department Only" : "All Departments")</span>
    </header>

    @if (TempData["AttendanceRequestMessage"] is string message) { <div class="manual-notice" role="status">@message</div> }
    <div class="manual-notice"><i class="fa-solid fa-circle-info"></i><div><strong id="manual-shift">Select an employee to view their assigned shift</strong><span>Authorized employee entries are saved immediately. Corrections replace the selected original punch time.</span></div></div>

    <form asp-action="AddAttendance" asp-controller="Main" method="post" class="manual-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="manual-step"><span>1</span><div><h2>Select Employee</h2><p>Select an employee from the full list, or filter by department.</p></div></div>
        <div class="manual-grid two">
            <label><span>Department filter</span><select asp-for="Department" id="Department"><option value="">All Departments</option>@foreach(var department in Model.Departments){<option value="@department">@department</option>}</select><em asp-validation-for="Department"></em></label>
            <label><span>Employee <b>*</b></span><select asp-for="EmployeeId" id="EmployeeId" required><option value="">Select Employee</option></select><em asp-validation-for="EmployeeId"></em></label>
        </div>

        <div class="manual-step"><span>2</span><div><h2>Attendance Timing</h2><p>Enter the attendance date and actual check-in/check-out time.</p></div></div>
        @if (direct)
        {
            <label><span>What to modify</span><select asp-for="ModificationMode"><option value="Both">Both Check-In and Check-Out</option><option value="CheckIn">Only Check-In</option><option value="CheckOut">Only Check-Out</option></select></label>
            <p id="existing-punch-times" role="status">Select employee and date to view existing punch times.</p>
        }
        <div class="manual-grid three">
            <label><span>Attendance Date <b>*</b></span><input asp-for="AttendanceDate" type="date" max="@DateOnly.FromDateTime(VertexERP.Services.FieldAttendanceClock.Now).ToString("yyyy-MM-dd")" required/><em asp-validation-for="AttendanceDate"></em></label>
            <label><span>Check-In Time <small>(24-hour HH:MM)</small></span><input asp-for="CheckInTime" type="time" placeholder="09:45" class="hhmm-input" step="1" required/><em asp-validation-for="CheckInTime"></em></label>
            <label><span>Check-Out Time <small>(24-hour HH:MM)</small></span><input asp-for="CheckOutTime" type="time" placeholder="18:30" class="hhmm-input" step="1" required="@direct"/><em asp-validation-for="CheckOutTime"></em></label>
        </div>

        <p id="manual-duration" role="status">Enter check-in and check-out to preview working duration.</p>
        <div class="manual-confirm"><i class="fa-solid fa-shield-halved"></i><span>@(direct ? "Save will immediately update attendance, Present counts, employee login and Excel reports." : "This correction request is sent to Admin for approval.")</span></div>
        <div asp-validation-summary="All" class="submit-errors"></div>
        <footer><a asp-action="Employees" class="manual-cancel">Cancel</a><button type="submit" id="submitAttendance"><i class="fa-solid fa-check"></i> @(direct ? "Save Attendance" : "Send to Admin")</button></footer>
    </form>
</section>

<script>
(() => {
    const employees = @Html.Raw(employeesJson);
    const department = document.getElementById('Department');
    const employee = document.getElementById('EmployeeId');
    const selectedEmployee = '@(Model.EmployeeId?.ToString() ?? "")';
    function refreshEmployees() {
        const value = department.value.toLowerCase();
        const selection = employee.value || selectedEmployee;
        const matches = employees.filter(item => !value || (item.department || '').toLowerCase() === value);
        employee.replaceChildren();
        const placeholder = document.createElement('option');
        placeholder.value = ''; placeholder.textContent = matches.length ? 'Select Employee' : 'No employees found';
        employee.appendChild(placeholder);
        matches.forEach(item => {
            const option = document.createElement('option'); option.value = item.id;
            option.textContent = `${item.code} - ${item.name}`;
            option.selected = String(item.id) === selection; employee.appendChild(option);
        });
        employee.disabled = false;
        duration();
    }
    department.addEventListener('change', refreshEmployees); refreshEmployees();
    function duration() {
        const start = document.getElementById('CheckInTime').value, end = document.getElementById('CheckOutTime').value;
        const minutes = value => Number(value.split(':')[0]) * 60 + Number(value.split(':')[1]);
        const assigned = employees.find(item => String(item.id) === employee.value);
        document.getElementById('manual-shift').textContent = assigned ? `Assigned shift: ${assigned.shiftStart} - ${assigned.shiftEnd}` : 'Select an employee to view their assigned shift';
        let elapsed = minutes(end) - minutes(start);
        if (assigned && minutes(assigned.shiftEnd) < minutes(assigned.shiftStart) && elapsed < 0) elapsed += 24 * 60;
        document.getElementById('manual-duration').textContent = start && end && elapsed > 0
            ? `Working duration: ${Math.floor(elapsed / 60)}h ${String(elapsed % 60).padStart(2, '0')}m (actual entered times; no automatic break deduction)`
            : 'Enter a check-out later than check-in to calculate working duration.';
    }
    const mode = document.getElementById('ModificationMode');
    const inTime = document.getElementById('CheckInTime');
    const outTime = document.getElementById('CheckOutTime');
    let existing = { checkIn: null, checkOut: null }, previewVersion = 0;
    function updateMode() {
        if (!mode) return;
        inTime.disabled = mode.value === 'CheckOut';
        outTime.disabled = mode.value === 'CheckIn';
        inTime.required = !inTime.disabled; outTime.required = !outTime.disabled;
        if (inTime.disabled) inTime.value = existing.checkIn || '';
        if (outTime.disabled) outTime.value = existing.checkOut || '';
        duration();
    }
    async function loadExisting() {
        if (!mode) { duration(); return; }
        const version = ++previewVersion;
        existing = { checkIn: null, checkOut: null };
        const message = document.getElementById('existing-punch-times');
        if (!employee.value) { message.textContent = 'Select employee and date to view existing punch times.'; updateMode(); return; }
        message.textContent = 'Loading existing punch times...';
        try {
            const query = new URLSearchParams({ employeeId: employee.value, date: document.getElementById('AttendanceDate').value });
            const response = await fetch('@Url.Action("ManualAttendanceTimes", "Main")?' + query, { cache: 'no-store' });
            if (!response.ok) throw new Error();
            const data = await response.json();
            if (version !== previewVersion) return;
            existing = data;
            message.textContent = `Existing Check-In: ${data.checkIn || 'Not recorded'} | Check-Out: ${data.checkOut || 'Not recorded'}`;
            inTime.value = data.checkIn || ''; outTime.value = data.checkOut || '';
            updateMode();
        } catch {
            if (version !== previewVersion) return;
            message.textContent = 'Could not load existing times. Please retry selecting the employee.';
            updateMode();
        }
    }
    if (mode) {
        mode.addEventListener('change', updateMode);
        document.getElementById('AttendanceDate').addEventListener('change', loadExisting);
        department.addEventListener('change', loadExisting);
        updateMode();
    }
    employee.addEventListener('change', loadExisting);
    employee.addEventListener('change', duration);
    document.querySelectorAll('.hhmm-input').forEach(input => input.addEventListener('input', duration)); duration();
    if (mode && employee.value) loadExisting();
    const form = document.querySelector('.manual-form');
    form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
            event.preventDefault(); form.reportValidity();
            const invalid = form.querySelector(':invalid');
            if (invalid) invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        const button = document.getElementById('submitAttendance');
        button.disabled = true;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving Attendance...';
    });
    const errorBox = document.querySelector('.submit-errors');
    if (errorBox && errorBox.textContent.trim()) errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
})();
</script>
