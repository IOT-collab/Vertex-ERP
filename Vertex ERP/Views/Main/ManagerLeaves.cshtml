@model VertexERP.Models.ManagerSectionViewModel
@{ ViewData["Title"]="Team Leave Management"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/ManagerSections.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-section"><header><h1>Leave Management</h1><p>Leave applications submitted by your reporting employees</p></header><div class="section-stats"><div><i class="fa-solid fa-calendar-days"></i><span><small>Total Requests</small><b>@Model.LeaveRequests.Count</b></span></div><div><i class="fa-regular fa-clock orange"></i><span><small>Pending</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Pending")</b></span></div><div><i class="fa-regular fa-circle-check green"></i><span><small>Approved</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Approved")</b></span></div><div><i class="fa-regular fa-circle-xmark red"></i><span><small>Rejected</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Rejected")</b></span></div></div><article class="section-card"><h3>Team Leave Requests</h3><div class="section-table"><table><thead><tr><th>Employee</th><th>Leave Type</th><th>From</th><th>To</th><th>Reason</th><th>Applied On</th><th>Status</th></tr></thead><tbody>@if(Model.LeaveRequests.Count==0){<tr><td colspan="7" class="no-data">No leave applications received.</td></tr>}else{@foreach(var item in Model.LeaveRequests){<tr><td><b>@item.Employee.FullName</b><small>@item.Employee.EmployeeCode</small></td><td>@item.LeaveType</td><td>@item.FromDate.ToString("dd MMM yyyy")</td><td>@item.ToDate.ToString("dd MMM yyyy")</td><td>@item.Reason</td><td>@item.AppliedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><em class="@item.Status.ToLowerInvariant()">@item.Status</em></td></tr>}}</tbody></table></div></article></section>
