@model VertexERP.Models.MyBankDetailsViewModel
@{ ViewData["Title"]="My Bank Details"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/BankDetails.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/BankDetailsForm.css" rel="stylesheet" asp-append-version="true" />
<section class="bank-page"><header><div><span>BANK &amp; PAYROLL</span><h1>My Bank Details</h1><p>Verified payment information linked to your account.</p></div>@if(!Model.Requests.Any(request=>request.Status=="Pending")){<a asp-action="RequestBankUpdate" class="bank-primary"><i class="fa-solid fa-pen"></i> @(Model.BankDetail==null?"Add Bank Details":"Update Bank Details")</a>}</header>
@if(TempData["BankMessage"]!=null){<div class="bank-alert">@TempData["BankMessage"]</div>}
<article class="bank-card bank-hero"><i class="fa-solid fa-building-columns"></i><div><small>Account Holder</small><h2>@(Model.BankDetail?.AccountHolderName??Model.Employee.FullName)</h2><span>@(Model.BankDetail?.IsVerified==true?"HR Verified":"Not verified")</span></div></article>
@if(Model.BankDetail==null){<article class="bank-card bank-empty"><i class="fa-solid fa-building-columns"></i><h3>Bank details not available</h3><p>Use Add Bank Details to submit your information to HR for verification.</p></article>}else{<div class="bank-grid">@foreach(var item in new[]{("Bank Name",Model.BankDetail.BankName),("Account Number",$"XXXX XXXX {Model.BankDetail.AccountLastFour}"),("IFSC Code",Model.BankDetail.IfscCode),("Branch",Model.BankDetail.BranchName??"--"),("Account Type",Model.BankDetail.AccountType),("PAN",Model.BankDetail.PanNumber??"--"),("UAN / PF",Model.BankDetail.UanNumber??"--"),("ESIC",Model.BankDetail.EsicNumber??"--"),("UPI ID",Model.BankDetail.UpiId??"--")}){<article class="bank-card"><small>@item.Item1</small><strong>@item.Item2</strong></article>}</div>}
@if(Model.Requests.Any(request=>request.Status=="Pending")){<div class="bank-pending-note"><i class="fa-solid fa-clock"></i> Bank update request HR approval ke liye pending hai.</div>}
<article class="bank-card request-history"><h3>Update Request History</h3>@if(Model.Requests.Count==0){<p>No bank update requests.</p>}else{<table><thead><tr><th>Requested On</th><th>Bank</th><th>Account</th><th>Status</th><th>HR Note</th></tr></thead><tbody>@foreach(var request in Model.Requests){<tr><td>@request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@request.BankName</td><td>XXXX @request.AccountLastFour</td><td><span class="@request.Status.ToLowerInvariant()">@request.Status</span></td><td>@(request.HrNote??"--")</td></tr>}</tbody></table>}</article></section>
