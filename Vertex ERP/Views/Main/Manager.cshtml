@model VertexERP.Models.ManagerDashboardViewModel
@using VertexERP.Services
@using System.Text.Json
@using System.Globalization
@{
    ViewData["Title"] = "Manager Dashboard";
    ViewData["ManagerWorkspace"] = true;
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var now = FieldAttendanceClock.Now;
    var today = DateOnly.FromDateTime(now);
    var name = Model.Viewer?.FullName ?? User.Identity?.Name ?? "Manager";
    var approvals = Model.LeaveRequests.Where(x => ManagerDashboardPresentation.AwaitingAction(x, Model.IsManagerScope)).ToList();
    var overdue = Model.Tasks.Where(x => ManagerDashboardPresentation.IsOverdue(x, today)).ToList();
    var leaveUrl = User.IsInRole("Manager") ? "/Main/ManagerLeaves" : "/Main/WorkflowManagement";
    var queryUrl = User.IsInRole("Manager") ? "/Main/ManagerQueries" : "/Main/WorkflowManagement";
    var searchItems = Model.TeamMembers.Select(x => new { label = x.FullName + " · " + x.EmployeeCode, type = "Employee", url = "#manager-member-"+x.Id })
        .Concat(Model.Projects.Select(x => new { label = x.ProjectName, type = "Project", url = "/Main/ManagerProjects" }))
        .Concat(Model.Tasks.Select(x => new { label = x.Title, type = "Task", url = "/Main/TaskMgm" })).ToList();
    var chartPeriods = new[] { "month", "week", "all" }.ToDictionary(x=>x,x=>ManagerDashboardPresentation.Workload(Model.Tasks,today,x));
}
<link href="~/css/ManagerWorkspace.css" rel="stylesheet" asp-append-version="true" />
<section class="md-dashboard" id="managerDashboard" data-period="@(now.Hour<12?"morning":now.Hour<17?"afternoon":"evening")" data-notification-url="@Url.Action("ManagerNotificationUpdates")">
 <section class="md-hero" aria-label="Welcome and today's date">
  <div class="md-diwali-vfx" aria-hidden="true"><span class="md-vfx-burst md-vfx-burst-one"></span><span class="md-vfx-burst md-vfx-burst-two"></span><span class="md-vfx-petal md-vfx-petal-one"></span><span class="md-vfx-petal md-vfx-petal-two"></span><span class="md-vfx-petal md-vfx-petal-three"></span><span class="md-vfx-petal md-vfx-petal-four"></span><span class="md-vfx-petal md-vfx-petal-five"></span></div>
  <div class="md-greeting"><p id="manager-greeting">@ManagerDashboardPresentation.Greeting(DateTimeOffset.UtcNow),</p><h1><span data-no-localize>@name</span> <span class="md-wave" aria-hidden="true">&#128075;</span></h1><p>Here's an overview of your team, tasks and approvals.</p></div>
  <blockquote class="md-quote">“Great managers build<br/>great people.”<span></span></blockquote>
  <img class="md-hero-art" src="~/images/manager/welcome-illustration.png" asp-append-version="true" alt=""/>
  <img class="md-diwali-art" src="~/images/diwali/ganesh-lakshmi.webp" asp-append-version="true" alt="Lord Ganesha and Goddess Lakshmi seated on lotus flowers"/>
  <div class="md-date"><span class="md-date-icon"><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></span><div><small>Today's Date</small><strong id="manager-today">@now.ToString("dd MMMM yyyy",CultureInfo.InvariantCulture)</strong><span id="manager-weekday">@now.ToString("dddd",CultureInfo.InvariantCulture)</span></div></div>
 </section>
 <div class="md-metrics">
  <a class="md-metric md-blue" href="#manager-team"><span class="md-metric-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span><div><small>Total Employees</small><strong>@Model.TeamMembers.Count</strong><span>Under your reports</span></div><i class="fa-solid fa-users md-watermark" aria-hidden="true"></i></a>
  <a class="md-metric md-green" href="/Main/TaskMgm"><span class="md-metric-icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><div><small>Completed Tasks</small><strong>@Model.CompletedThisMonth</strong><span>This month</span></div><i class="fa-solid fa-chart-simple md-watermark" aria-hidden="true"></i></a>
  <a class="md-metric md-amber" href="/Main/TaskMgm"><span class="md-metric-icon"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></span><div><small>In Progress</small><strong>@Model.InProgressTasks</strong><span>Currently active</span></div><i class="fa-solid fa-spinner md-watermark" aria-hidden="true"></i></a>
  <button class="md-metric md-purple" type="button" data-manager-open-tab="approvals"><span class="md-metric-icon"><i class="fa-solid fa-list-ul" aria-hidden="true"></i></span><div><small>Pending Approval</small><strong>@Model.PendingApprovals</strong><span>Awaiting action</span></div><i class="fa-regular fa-file-lines md-watermark" aria-hidden="true"></i></button>
  <button class="md-metric md-red" type="button" data-manager-open-tab="overdue"><span class="md-metric-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></span><div><small>Overdue Tasks</small><strong>@Model.OverdueTasks</strong><span>Past due date</span></div><i class="fa-solid fa-triangle-exclamation md-watermark" aria-hidden="true"></i></button>
 </div>
 <div class="md-content-grid">
  <article class="md-panel md-team" id="manager-team"><header class="md-panel-heading"><div><h2><i class="fa-solid fa-id-card-clip" aria-hidden="true"></i> Team Members</h2><p>Active employees under your reporting manager</p></div><div class="md-team-tools"><label class="md-search-field"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="manager-team-search" type="search" aria-label="Search team members" placeholder="Search employee..."/></label>@if(User.IsInRole("HR")||User.IsInRole("Admin")){<a class="md-primary-action" href="/Hr/HrAddEmp"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add Employee</a>}else{<a class="md-primary-action" href="/Main/MyTeam">View Team <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>}</div></header>
  <div class="md-table-wrap"><table class="md-team-table"><thead><tr><th>Employee</th><th>Employee ID</th><th>Department</th><th>Designation</th><th>Email</th><th>Phone</th><th>Status</th><th><span class="md-sr-only">Actions</span></th></tr></thead><tbody>
   @foreach(var employee in Model.TeamMembers){<tr id="manager-member-@employee.Id" data-manager-member data-search="@($"{employee.FullName} {employee.EmployeeCode} {employee.Department} {employee.Designation} {employee.Email}")"><td><div class="md-person"><span class="md-avatar"><span>@ManagerDashboardPresentation.Initials(employee.FullName)</span>@if(!string.IsNullOrWhiteSpace(employee.PhotoPath)){<img src="@employee.PhotoPath" alt="" loading="lazy" onerror="this.hidden=true"/>}</span><span><strong data-no-localize>@employee.FullName</strong><small data-no-localize>@employee.Email</small></span></div></td><td data-no-localize>@employee.EmployeeCode</td><td>@employee.Department</td><td>@employee.Designation</td><td data-no-localize>@employee.Email</td><td data-no-localize>@(string.IsNullOrWhiteSpace(employee.PhoneNumber)?"—":employee.PhoneNumber)</td><td><span class="md-active-status"><i aria-hidden="true"></i>@employee.EmployeeStatus</span></td><td><details class="md-row-menu"><summary aria-label="Options for @employee.FullName"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></summary><div class="md-menu"><strong>@employee.FullName</strong><span>@Model.Tasks.Count(x=>x.AssigneeId==employee.Id) assigned tasks</span><span>@Model.Tasks.Count(x=>x.AssigneeId==employee.Id&&!ManagerDashboardPresentation.IsCompleted(x)) pending tasks</span><span>Shift: @employee.ShiftStartTime.ToString("hh:mm tt") – @employee.ShiftEndTime.ToString("hh:mm tt")</span><a href="/Main/ManagerAttendance">Team attendance</a><a href="/Main/TaskMgm">Task management</a></div></details></td></tr>}
   <tr id="manager-no-members" hidden="@(Model.TeamMembers.Count>0)"><td colspan="8"><div class="md-empty md-team-empty"><i class="fa-solid fa-user-group" aria-hidden="true"></i><strong>@(Model.TeamMembers.Count==0?"No team members assigned":"No matching employees")</strong><span>Employees appear here from reporting manager assignments.</span></div></td></tr>
  </tbody></table></div><p class="md-table-count" id="manager-team-count" aria-live="polite">@Model.TeamMembers.Count team members</p></article>
  <article class="md-panel md-workload"><header class="md-panel-heading"><div><h2>Employee Workload Overview</h2><p id="manager-chart-caption">Tasks created this month</p></div><label class="md-sr-only" for="manager-chart-period">Workload period</label><select id="manager-chart-period"><option value="month">This Month</option><option value="week">This Week</option><option value="all">All Time</option></select></header><div class="md-chart-layout"><div class="md-donut" id="manager-workload-chart" role="img" aria-label="Workload distribution"><div><strong id="manager-chart-total">@chartPeriods["month"].Total</strong><span>Total Tasks</span></div></div><dl class="md-chart-legend">@foreach(var category in new[]{"Completed","In Progress","Pending","Overdue"}){<div data-manager-category="@category"><dt><i class="md-legend-dot" aria-hidden="true"></i>@category</dt><dd data-chart-count>0</dd><dd data-chart-percent>0%</dd></div>}</dl></div></article>
  <article class="md-panel md-recent" id="manager-recent"><header class="md-panel-heading"><h2><i class="fa-regular fa-file-lines" aria-hidden="true"></i> Recent Tasks &amp; Approvals</h2><a class="md-soft-action" id="manager-recent-all" href="@leaveUrl">View All</a></header><div class="md-tabs" role="tablist" aria-label="Tasks and approvals"><button id="manager-tab-approvals" role="tab" aria-selected="true" aria-controls="manager-approvals-panel" data-manager-tab="approvals" type="button">Pending Approval (@Model.PendingApprovals)</button><button id="manager-tab-own" role="tab" aria-selected="false" aria-controls="manager-own-panel" data-manager-tab="own" type="button">My Tasks (@Model.OwnTasks.Count)</button><button id="manager-tab-overdue" role="tab" aria-selected="false" aria-controls="manager-overdue-panel" data-manager-tab="overdue" type="button">Overdue (@overdue.Count)</button></div>
   <div id="manager-approvals-panel" role="tabpanel" aria-labelledby="manager-tab-approvals" data-manager-task-panel="approvals">@if(Model.PendingApprovals==0){<div class="md-empty"><span class="md-empty-illustration"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><strong>No pending approvals</strong><span>You are all caught up!</span></div>}else{<div class="md-activity-list">@foreach(var request in approvals.Take(4)){<a href="@leaveUrl"><span class="md-list-icon md-purple"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i></span><span><strong>@request.Employee.FullName</strong><small>@request.LeaveType · @request.FromDate.ToString("dd MMM") – @request.ToDate.ToString("dd MMM")</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>}@foreach(var claim in Model.ExpenseClaims.Take(4)){<a href="/Expense/Index"><span class="md-list-icon md-blue"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span><span><strong>@claim.Employee.FullName</strong><small>@claim.Title · ₹@claim.Amount.ToString("N2")</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>}</div>}</div>
   <div id="manager-own-panel" role="tabpanel" aria-labelledby="manager-tab-own" data-manager-task-panel="own" hidden>@if(Model.OwnTasks.Count==0){<div class="md-empty"><i class="fa-solid fa-list-check" aria-hidden="true"></i><strong>No tasks assigned to you</strong><span>Your assigned work will appear here.</span></div>}else{<div class="md-activity-list">@foreach(var task in Model.OwnTasks.Take(6)){<a href="/Main/TaskMgm"><span class="md-list-icon md-blue"><i class="fa-regular fa-square-check" aria-hidden="true"></i></span><span><strong>@task.Title</strong><small>Due @task.DueDate.ToString("dd MMM") · @task.Status</small></span></a>}</div>}</div>
   <div id="manager-overdue-panel" role="tabpanel" aria-labelledby="manager-tab-overdue" data-manager-task-panel="overdue" hidden>@if(overdue.Count==0){<div class="md-empty"><i class="fa-regular fa-circle-check" aria-hidden="true"></i><strong>No overdue tasks</strong><span>Your team is on track.</span></div>}else{<div class="md-activity-list">@foreach(var task in overdue.Take(6)){<a href="/Main/TaskMgm"><span class="md-list-icon md-red"><i class="fa-regular fa-clock" aria-hidden="true"></i></span><span><strong>@task.Title</strong><small>@task.Assignee.FullName · Due @task.DueDate.ToString("dd MMM")</small></span></a>}</div>}</div>
  </article>
  <article class="md-panel md-queries"><header class="md-query-heading"><span class="md-query-icon"><i class="fa-regular fa-comment-dots" aria-hidden="true"></i></span><div><h2>Team Queries</h2><p>Employee queries and requests</p></div><div class="md-query-tabs" role="tablist" aria-label="Team queries">@foreach(var state in new[]{"Open","Resolved","Closed"}){var count=Model.QueryTickets.Count(x=>state=="Open"?x.Status!="Resolved"&&x.Status!="Closed":x.Status==state);<button type="button" id="manager-query-@state" role="tab" aria-controls="manager-query-panel-@state" aria-selected="@(state=="Open"?"true":"false")" data-manager-query="@state">@state (@count)</button>}</div><a class="md-soft-action" href="@queryUrl">View All</a></header>
   @foreach(var state in new[]{"Open","Resolved","Closed"}){var tickets=Model.QueryTickets.Where(x=>state=="Open"?x.Status!="Resolved"&&x.Status!="Closed":x.Status==state).ToList();<div id="manager-query-panel-@state" role="tabpanel" aria-labelledby="manager-query-@state" data-manager-query-panel="@state" hidden="@(state!="Open")">@if(tickets.Count==0){<div class="md-query-empty"><i class="fa-regular fa-comments" aria-hidden="true"></i><div><strong>@(state=="Open"?"No employee queries":"No "+state.ToLowerInvariant()+" queries")</strong><span>@(state=="Open"?"All queries have been addressed.":"Your query history will appear here.")</span></div></div>}else{<div class="md-query-list">@foreach(var ticket in tickets.Take(3)){<a href="@(state=="Open"?queryUrl:"/Main/ClosedIssues?status="+state)"><strong>@ticket.Subject</strong><span>@ticket.Employee.FullName · @ticket.Status</span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>}</div>}</div>}
  </article>
 </div>
 <script type="application/json" id="manager-search-data">@Html.Raw(JsonSerializer.Serialize(searchItems))</script>
 <script type="application/json" id="manager-chart-data">@Html.Raw(JsonSerializer.Serialize(chartPeriods, new JsonSerializerOptions { PropertyNamingPolicy=JsonNamingPolicy.CamelCase }))</script>
</section>
<script src="~/js/manager-dashboard.js" asp-append-version="true" defer></script>
