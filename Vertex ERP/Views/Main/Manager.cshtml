@model VertexERP.Models.ManagerDashboardViewModel
@{ ViewData["Title"]="Manager Dashboard"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/Manager.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/ManagerReport.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/ManagerNotifications.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-dashboard">
 <header class="manager-header"><div><h1>Manager Dashboard</h1><p>Complete overview of your team, tasks and approval requests</p></div><div class="manager-header-actions"><div class="notification-wrap @(Model.NotificationCount>0?"has-alert":"")" id="managerNotifications"><button type="button" class="notification-bell" onclick="toggleNotifications(event)" aria-label="Open notifications" aria-expanded="false"><i class="fa-regular fa-bell"></i>@if(Model.NotificationCount>0){<span>@Model.NotificationCount</span>}</button><div class="notification-panel" role="region" aria-label="Notifications"><div class="notification-title"><b>Notifications</b><small>@Model.NotificationCount pending</small></div>@if(Model.NotificationCount==0){<div class="notification-empty"><i class="fa-regular fa-bell-slash"></i><span>No pending notifications</span></div>}else{<div class="notification-list">@foreach(var item in Model.Notifications){<a href="@item.Url" class="notification-row"><i class="notification-type @item.Type.ToLowerInvariant()"></i><span><strong>@item.Title</strong><small>@item.Detail</small><time>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM, hh:mm tt")</time></span></a>}</div>}</div></div><div class="today-card"><i class="fa-regular fa-calendar"></i><span><small>Today's Date</small><strong>@DateTime.Today.ToString("dd MMMM yyyy")</strong></span></div></div></header>
 <article class="welcome-panel panel"><div class="welcome-icon"><i class="fa-solid fa-people-roof"></i></div><div class="welcome-copy"><small>TEAM MANAGEMENT</small><h2>Team Report</h2><p>Team workload, pending work and employee leave applications.</p></div><div class="welcome-stat"><i class="fa-solid fa-user-tie"></i><span><small>Managers</small><strong>@Model.Managers.Count</strong></span></div><div class="welcome-stat"><i class="fa-solid fa-users"></i><span><small>Team Members</small><strong>@Model.TeamMembers.Count</strong></span></div><div class="welcome-stat"><i class="fa-solid fa-bell"></i><span><small>Pending Leaves</small><strong>@Model.PendingLeaveRequests</strong></span></div></article>
 <div class="summary-grid"><article class="summary-card"><span class="summary-icon primary"><i class="fa-solid fa-clipboard-list"></i></span><div><small>Total Tasks</small><strong>@Model.TotalTasks</strong><p>All team tasks</p></div></article><article class="summary-card"><span class="summary-icon green"><i class="fa-regular fa-circle-check"></i></span><div><small>Completed</small><strong>@Model.CompletedTasks</strong><p>Completed work</p></div></article><article class="summary-card"><span class="summary-icon orange"><i class="fa-regular fa-hourglass-half"></i></span><div><small>In Progress</small><strong>@Model.InProgressTasks</strong><p>Currently active</p></div></article><article class="summary-card"><span class="summary-icon purple"><i class="fa-solid fa-list-ul"></i></span><div><small>Pending</small><strong>@Model.PendingTasks</strong><p>Work remaining</p></div></article><article class="summary-card"><span class="summary-icon red"><i class="fa-regular fa-clock"></i></span><div><small>Overdue</small><strong>@Model.OverdueTasks</strong><p>Past due date</p></div></article></div>
 <div class="report-grid">
  <article class="panel report-tasks"><div class="panel-heading"><h3>Team Tasks</h3><span>@Model.Tasks.Count task(s)</span></div>@if(Model.Tasks.Count==0){<div class="empty-section"><i class="fa-solid fa-list-check"></i><strong>No tasks assigned</strong></div>}else{<div class="table-wrap"><table class="manager-table"><thead><tr><th>Task</th><th>Assigned To</th><th>Manager</th><th>Due Date</th><th>Priority</th><th>Status</th></tr></thead><tbody>@foreach(var task in Model.Tasks){<tr><td><b>@task.Title</b></td><td>@task.Assignee.FullName</td><td>@task.Manager.FullName</td><td>@task.DueDate.ToString("dd MMM yyyy")</td><td>@task.Priority</td><td><span class="task-status">@task.Status</span></td></tr>}</tbody></table></div>}</article>
  <article class="panel leave-panel"><div class="panel-heading"><h3>Leave Requests</h3><span>@Model.PendingLeaveRequests pending</span></div>@if(Model.LeaveRequests.Count==0){<div class="empty-section"><i class="fa-regular fa-calendar-xmark"></i><strong>No leave requests</strong></div>}else{<div class="leave-list">@foreach(var request in Model.LeaveRequests){<div><span><strong>@request.Employee.FullName</strong><small>@request.LeaveType · @request.FromDate.ToString("dd MMM") - @request.ToDate.ToString("dd MMM")</small><small>@request.Reason</small></span><em class="leave-status">@request.Status</em></div>}</div>}</article>
 </div>
 <article class="panel manager-directory"><div class="panel-heading"><div><h3>Employee Workload Report</h3><p>Employee-wise assigned and pending tasks</p></div><span>@Model.TeamMembers.Count member(s)</span></div>@if(Model.TeamMembers.Count==0){<div class="empty-section directory-empty"><i class="fa-solid fa-users"></i><strong>No team members assigned</strong><small>Assign a Reporting Manager in employee details.</small></div>}else{<div class="table-wrap"><table class="manager-table"><thead><tr><th>Employee</th><th>Employee ID</th><th>Department</th><th>Designation</th><th>Assigned</th><th>Pending</th></tr></thead><tbody>@foreach(var employee in Model.TeamMembers){<tr><td><div class="manager-person">@if(!string.IsNullOrWhiteSpace(employee.PhotoPath)){<img src="@employee.PhotoPath" alt="@employee.FullName"/>}else{<span><i class="fa-solid fa-user"></i></span>}<div><b>@employee.FullName</b><small>@employee.Email</small></div></div></td><td>@employee.EmployeeCode</td><td>@employee.Department</td><td>@employee.Designation</td><td>@Model.Tasks.Count(task=>task.AssigneeId==employee.Id)</td><td>@Model.Tasks.Count(task=>task.AssigneeId==employee.Id&&!task.Status.Equals("Completed",StringComparison.OrdinalIgnoreCase))</td></tr>}</tbody></table></div>}</article>
</section>
<script>
 function toggleNotifications(event){event.stopPropagation();const wrap=document.getElementById('managerNotifications');const open=wrap.classList.toggle('open');wrap.querySelector('.notification-bell').setAttribute('aria-expanded',open);}
 document.addEventListener('click',()=>document.getElementById('managerNotifications')?.classList.remove('open'));
 document.querySelector('.notification-panel')?.addEventListener('click',event=>event.stopPropagation());
 const notificationsLoadedAt=new Date().toISOString();
 window.setInterval(async()=>{try{const response=await fetch('/Main/ManagerNotificationCount?sinceUtc='+encodeURIComponent(notificationsLoadedAt),{cache:'no-store'});if(!response.ok)return;const data=await response.json();if(data.hasNew)window.location.reload();}catch{}},10000);
</script>
