@model VertexERP.Models.SalarySlipPageViewModel
@{ ViewData["Title"]="Salary Slips"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/SalarySlips.css" rel="stylesheet" asp-append-version="true" />
<section class="salary-page"><header><div><span class="salary-kicker">PAYROLL SELF SERVICE</span><h1>Salary Slips</h1><p>Select a month and download your salary slip securely in PDF format.</p></div><div class="salary-person"><i class="fa-solid fa-user-shield"></i><span><small>Employee</small><strong>@Model.Employee.FullName</strong><small>@Model.Employee.EmployeeCode</small></span></div></header><div class="salary-summary"><article><i class="fa-solid fa-building"></i><span><small>Department</small><strong>@Model.Employee.Department</strong></span></article><article><i class="fa-solid fa-briefcase"></i><span><small>Designation</small><strong>@Model.Employee.Designation</strong></span></article><article><i class="fa-regular fa-calendar"></i><span><small>Available Slips</small><strong>@Model.Months.Count months</strong></span></article></div><article class="salary-panel"><div class="salary-panel-title"><div><h2>Monthly Salary Slips</h2><p>All downloads are generated as PDF files.</p></div><span><i class="fa-regular fa-file-pdf"></i> PDF only</span></div>@if(Model.Months.Count==0){<div class="salary-empty">No salary-slip month is available yet.</div>}else{<div class="salary-list">@foreach(var slip in Model.Months){<div class="salary-row"><div class="salary-month-icon"><i class="fa-regular fa-calendar-days"></i></div><div><strong>@slip.Label</strong><small>Monthly salary statement · @Model.Employee.EmployeeCode</small></div><span class="salary-status">Available</span><a asp-action="DownloadSalarySlip" asp-route-year="@slip.Year" asp-route-month="@slip.Month" class="salary-download"><i class="fa-solid fa-download"></i> Download PDF</a></div>}</div>}</article></section>
