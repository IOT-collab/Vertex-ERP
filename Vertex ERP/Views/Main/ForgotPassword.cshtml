@model VertexERP.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Forgot Password - Vertex ERP</title><link href="~/css/Login.css" rel="stylesheet" asp-append-version="true"/></head>
<body><main class="login-shell"><section class="login-card"><div class="login-heading"><span class="eyebrow">Password Recovery</span><h1>Forgot password?</h1><p>Enter your registered 10-digit mobile number. Your OTP is valid for 5 minutes.</p></div><form asp-action="ForgotPassword" method="post" class="login-form"><div asp-validation-summary="ModelOnly" class="login-alert"></div><div class="form-group"><label asp-for="PhoneNumber"></label><div class="input-shell"><span class="input-icon">+91</span><input asp-for="PhoneNumber" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="10" pattern="[0-9]{10}" placeholder="10-digit mobile number"/></div><span asp-validation-for="PhoneNumber"></span></div><button type="submit" class="login-button">Send OTP <span aria-hidden="true">-&gt;</span></button></form><p class="login-footnote"><a asp-action="Login">Back to login</a></p></section></main></body></html>
