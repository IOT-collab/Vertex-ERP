@model VertexERP.Models.ForgotPasswordViewModel
@using System.Text.Json
@inject IConfiguration Configuration
@{ ViewData["Title"] = "Forgot Password"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - Vertex ERP</title>
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true" />
    <style>[hidden] { display: none !important; }</style>
</head>
<body>
<main class="login-shell"><section class="login-card" aria-labelledby="recoveryTitle">
    <div class="login-heading"><span class="eyebrow">Password Recovery</span><h1 id="recoveryTitle">Forgot password?</h1>
        <p>Verify your identity using a contact method already registered with Vertex ERP.</p></div>

    <form asp-action="ForgotPassword" method="post" class="login-form" id="identifyForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="login-alert" role="alert"></div>
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="login-alert" role="status">@Model.StatusMessage</div> }
        <div class="form-group"><label asp-for="Username"></label><div class="input-shell"><span class="input-icon">ID</span>
            <input asp-for="Username" autocomplete="username" placeholder="Enter employee ID or username" /></div><span asp-validation-for="Username"></span></div>
        <button type="submit" class="login-button" id="continueButton">Continue <span aria-hidden="true">-&gt;</span></button>
    </form>

    @if (Model.MethodsAvailable)
    {
        <section class="login-form" aria-labelledby="methodHeading">
            <h2 id="methodHeading">Verify your identity using:</h2>
            @if (Model.HasSms)
            {
                <div class="form-group"><p><strong>SMS OTP</strong><br />Registered Mobile: @Model.MaskedPhone</p>
                    <button type="button" class="login-button" id="smsButton">Send SMS OTP</button></div>
            }
            @if (Model.HasSms && Model.HasEmail) { <p class="login-footnote" style="text-align:center">OR</p> }
            @if (Model.HasEmail)
            {
                <div class="form-group"><p><strong>Email OTP</strong><br />Registered Email: @Model.MaskedEmail</p>
                    <button type="button" class="login-button" id="emailButton">Send Email OTP</button></div>
            }
        </section>
    }

    <section class="login-form" id="otpSection" hidden>
        <div class="login-heading"><h2>Enter verification code</h2><p id="otpNotice">The code expires in 5 minutes.</p></div>
        <div id="recaptcha-container"></div>
        <div id="otpEntry" class="form-group" hidden><label for="otp">Six-digit OTP</label>
            <div class="input-shell"><span class="input-icon">OTP</span><input id="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" /></div></div>
        <p class="login-alert" id="recoveryMessage" role="status" hidden></p>
        <button type="button" class="login-button" id="verifyButton" hidden>Verify code <span aria-hidden="true">-&gt;</span></button>
        <p class="login-footnote" id="countdown" aria-live="polite"></p>
    </section>
    <p class="login-footnote"><a asp-action="Login">Back to login</a></p>
</section></main>
@if (Model.MethodsAvailable)
{
<script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js';
    import { getAuth, RecaptchaVerifier, signInWithPhoneNumber, signOut } from 'https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js';

    const firebaseConfig = @Html.Raw(JsonSerializer.Serialize(Configuration.GetSection("Firebase:Web").Get<Dictionary<string, string>>() ?? new Dictionary<string, string>()));
    const auth = getAuth(initializeApp(firebaseConfig));
    const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const headers = { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf };
    const smsButton = document.getElementById('smsButton');
    const emailButton = document.getElementById('emailButton');
    const otpSection = document.getElementById('otpSection');
    const otpEntry = document.getElementById('otpEntry');
    const otpInput = document.getElementById('otp');
    const verifyButton = document.getElementById('verifyButton');
    const message = document.getElementById('recoveryMessage');
    const notice = document.getElementById('otpNotice');
    const countdown = document.getElementById('countdown');
    let activeMethod = '';
    let confirmation = null;
    let verifier = null;
    let resendAvailableAt = 0;
    let smsChallengeStarted = false;

    function showMessage(text, error = false) {
        message.textContent = text;
        message.hidden = !text;
        message.dataset.error = error ? 'true' : 'false';
    }
    async function post(url, body = {}) {
        const response = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body), credentials: 'same-origin', signal: AbortSignal.timeout(30000) });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.message || 'We could not complete that request.');
        return data;
    }
    function startCountdown(seconds) {
        const until = Date.now() + seconds * 1000;
        resendAvailableAt = until;
        const resendButton = activeMethod === 'sms' ? smsButton : emailButton;
        if (resendButton) resendButton.disabled = true;
        const tick = () => {
            const remaining = Math.max(0, Math.ceil((until - Date.now()) / 1000));
            countdown.textContent = remaining ? `You can request another code in ${remaining}s.` : 'You can request another code now.';
            if (!remaining && resendButton) resendButton.disabled = false;
            if (remaining) window.setTimeout(tick, 1000);
        };
        tick();
    }
    function startExpiryCountdown() {
        const expiresAt = Date.now() + 5 * 60 * 1000;
        const tick = () => {
            const remaining = Math.max(0, Math.ceil((expiresAt - Date.now()) / 1000));
            if (!remaining) { notice.textContent = 'This code expired. Request a new code to continue.'; return; }
            notice.textContent = `Your verification code expires in ${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}.`;
            window.setTimeout(tick, 1000);
        };
        tick();
    }
    function beginEntry(method, text) {
        activeMethod = method;
        otpSection.hidden = false;
        otpEntry.hidden = false;
        verifyButton.hidden = false;
        notice.textContent = text;
        startExpiryCountdown();
        otpInput.value = '';
        otpInput.focus();
    }

    if (smsButton) smsButton.addEventListener('click', async () => {
        smsButton.disabled = true; smsButton.textContent = 'Preparing secure verification…'; showMessage('');
        try {
            const challenge = await post('@Url.Action("BeginSmsOtp")');
            smsChallengeStarted = true;
            // Firebase must render its reCAPTCHA in a visible container.
            otpSection.hidden = false;
            notice.textContent = 'Complete the reCAPTCHA below to request your SMS code.';
            showMessage('Loading secure reCAPTCHA…');
            if (verifier) { verifier.clear(); verifier = null; }
            verifier = new RecaptchaVerifier(auth, 'recaptcha-container', {
                size: 'normal',
                'expired-callback': () => showMessage('reCAPTCHA expired. Complete it again to continue.', true)
            });
            await verifier.render();
            smsButton.textContent = 'Complete the reCAPTCHA below…';
            showMessage('Complete the reCAPTCHA to send the code to your registered mobile.');
            confirmation = await signInWithPhoneNumber(auth, challenge.phoneNumber, verifier);
            await post('@Url.Action("MarkSmsSent")');
            beginEntry('sms', 'A Firebase verification code was sent to your registered mobile.');
            startCountdown(challenge.resendAfterSeconds || 60);
            showMessage('SMS code sent.');
        } catch (error) {
            if (smsChallengeStarted && !confirmation) await post('@Url.Action("CancelSmsOtp")').catch(() => {});
            if (confirmation) {
                beginEntry('sms', 'A code was sent. Continue verification; retry if the connection interrupted.');
                showMessage('The code was sent, but we could not finish the server check. Try Verify code.', true);
            } else {
                const code = error?.code || '';
                if (code === 'auth/unauthorized-domain') {
                    showMessage('This website domain is not enabled for Firebase Phone Authentication. Open Vertex ERP from an authorized HTTPS domain.', true);
                } else if (code === 'auth/captcha-check-failed' || code === 'auth/invalid-app-credential') {
                    showMessage('Firebase could not validate reCAPTCHA. Refresh the page and try again.', true);
                } else if (error?.name === 'TimeoutError' || error?.name === 'AbortError') {
                    showMessage('The request timed out. Check the connection and try again.', true);
                } else {
                    showMessage('SMS verification could not start. Please complete the reCAPTCHA and try again.', true);
                }
            }
            if (verifier) { verifier.clear(); verifier = null; }
        } finally { smsButton.disabled = Date.now() < resendAvailableAt; smsButton.textContent = 'Send SMS OTP'; smsChallengeStarted = false; }
    });

    if (emailButton) emailButton.addEventListener('click', async () => {
        emailButton.disabled = true; emailButton.textContent = 'Sending code…'; showMessage('');
        try {
            const data = await post('@Url.Action("BeginEmailOtp")');
            beginEntry('email', data.message);
            startCountdown(data.resendAfterSeconds || 60);
            showMessage(data.message);
        } catch (error) { showMessage(error.message, true); }
        finally { emailButton.disabled = Date.now() < resendAvailableAt; emailButton.textContent = 'Send Email OTP'; }
    });

    verifyButton.addEventListener('click', async () => {
        verifyButton.disabled = true; verifyButton.textContent = 'Verifying…'; showMessage('');
        try {
            if (activeMethod === 'sms') {
                await post('@Url.Action("MarkSmsSent")');
                const result = await confirmation.confirm(otpInput.value.trim());
                const idToken = await result.user.getIdToken(true);
                await signOut(auth);
                const data = await post('@Url.Action("VerifySmsOtp")', { idToken });
                window.location.assign(data.redirectUrl);
            } else {
                const data = await post('@Url.Action("VerifyEmailOtp")', { otp: otpInput.value.trim() });
                window.location.assign(data.redirectUrl);
            }
        } catch (error) { showMessage(error.message || 'The code is invalid or has expired.', true); }
        finally { verifyButton.disabled = false; verifyButton.textContent = 'Verify code →'; }
    });

    document.getElementById('identifyForm').addEventListener('submit', () => {
        const button = document.getElementById('continueButton');
        button.disabled = true;
        button.textContent = 'Checking…';
    });
</script>
}
</body></html>
