@model VertexERP.Models.FieldAttendanceViewModel
@{ ViewData["Title"] = "Mark Attendance"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<style>
.field-attendance{max-width:850px;margin:30px auto;padding:clamp(18px,4vw,38px);background:#111c31;border:1px solid #2b3d5d;border-radius:18px;color:#edf4ff}.field-attendance h1{margin:0;font-size:clamp(25px,4vw,34px)}.field-attendance p{color:#aabbd5}.field-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:26px}.field-action{border:0;border-radius:14px;padding:25px 18px;background:#2866dd;color:#fff;font:700 17px inherit;cursor:pointer}.field-action.checkout{background:#0f9f73}.field-action:disabled{opacity:.45;cursor:not-allowed}.field-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:22px}.field-details article{padding:16px;border-radius:12px;background:#172641}.field-details small{display:block;color:#9db0cf}.field-details strong{display:block;margin-top:7px;font-size:18px}.selfie-panel{margin-top:24px;padding:18px;border:1px dashed #4b6b99;border-radius:14px}.selfie-row{display:flex;flex-wrap:wrap;gap:14px;align-items:center}.selfie-preview{display:none;width:120px;height:120px;object-fit:cover;border-radius:12px;border:2px solid #5687e6}.field-message{min-height:22px;margin-top:18px;color:#c1d4f3}.field-message.error{color:#ffaaa9}@@media(max-width:560px){.field-actions,.field-details{grid-template-columns:1fr}.field-attendance{margin:14px}.field-action{min-height:100px}}
</style>
<section class="field-attendance">
    <h1>Field Attendance</h1><p>Check in/out records your current GPS location and server time. Add a selfie if required for the visit.</p>
    <div class="field-actions"><button id="checkIn" class="field-action" @(Model.HasCheckedIn ? "disabled" : "")><i class="fa-solid fa-right-to-bracket"></i> Check In</button><button id="checkOut" class="field-action checkout" @(!Model.HasCheckedIn || Model.HasCheckedOut ? "disabled" : "")><i class="fa-solid fa-right-from-bracket"></i> Check Out</button></div>
    <div class="field-details"><article><small>Check In</small><strong id="checkInTime">@(Model.CheckInTime?.ToString("hh:mm tt") ?? "Not recorded")</strong></article><article><small>Check Out</small><strong id="checkOutTime">@(Model.CheckOutTime?.ToString("hh:mm tt") ?? "Not recorded")</strong></article></div>
    <div class="selfie-panel"><div class="selfie-row"><button id="captureSelfie" type="button" class="field-action" style="padding:11px 15px;font-size:14px"><i class="fa-solid fa-camera"></i> Capture Selfie</button><input id="selfieFile" type="file" accept="image/*" capture="user" hidden><img id="selfiePreview" class="selfie-preview" alt="Selfie preview"><span>Optional selfie: camera opens on supported phones.</span></div></div>
    <p class="field-message" id="fieldMessage" aria-live="polite"></p>
    @Html.AntiForgeryToken()
</section>
<script>
(() => {
 const message=document.getElementById('fieldMessage'), selfieFile=document.getElementById('selfieFile'), preview=document.getElementById('selfiePreview'); let selfieData=null;
 document.getElementById('captureSelfie').onclick=()=>selfieFile.click();
 selfieFile.onchange=()=>{const file=selfieFile.files[0]; if(!file)return; if(file.size>5*1024*1024){show('Selfie must be smaller than 5 MB.',true);return;} const reader=new FileReader(); reader.onload=()=>{selfieData=reader.result;preview.src=selfieData;preview.style.display='block';};reader.readAsDataURL(file);};
 const show=(text,error=false)=>{message.textContent=text;message.className=error?'field-message error':'field-message';};
 const position=()=>new Promise((resolve,reject)=>{if(!navigator.geolocation)return reject(new Error('This device does not support location services.'));navigator.geolocation.getCurrentPosition(resolve,error=>reject(new Error(error.code===1?'Please allow location permission to mark attendance.':'Unable to get your current location. Please turn on location and try again.')),{enableHighAccuracy:true,timeout:20000,maximumAge:0});});
 async function mark(action){const button=action==='Check In'?document.getElementById('checkIn'):document.getElementById('checkOut');button.disabled=true;show('Getting your current location…');try{const gps=await position();show('Saving attendance…');const response=await fetch('@Url.Action("SubmitFieldAttendance","Main")',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-TOKEN':document.querySelector('input[name="__RequestVerificationToken"]').value},body:JSON.stringify({action,latitude:gps.coords.latitude,longitude:gps.coords.longitude,accuracyMetres:gps.coords.accuracy,selfieDataUrl:selfieData})});const data=await response.json();if(!response.ok)throw new Error(data.message||'Could not save attendance.');show(data.message);document.getElementById(action==='Check In'?'checkInTime':'checkOutTime').textContent=data.time;if(action==='Check In')document.getElementById('checkOut').disabled=false;else button.disabled=true;selfieData=null;selfieFile.value='';preview.style.display='none';}catch(error){button.disabled=false;show(error.message,true);}}
 document.getElementById('checkIn').onclick=()=>mark('Check In');document.getElementById('checkOut').onclick=()=>mark('Check Out');
})();
</script>
