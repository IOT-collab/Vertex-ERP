@model VertexERP.Models.EmployeeFormViewModel
@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "Edit Employee" : "Add Employee";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/AddEmpHrm.css" rel="stylesheet" />

<div class="hrms-page">
    <div class="page-header"><div class="header-text"><h2>@(editing ? "Edit Employee Profile" : "Add New Employee Profile")</h2><p>Setup personal details, employment information and organizational mapping.</p></div></div>
    <div class="form-container-wrapper">
        <form class="employee-onboarding-form" asp-controller="Employee" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-grid">
                <div class="form-main-section">
                    <div class="section-divider"><span>Personal Specifications</span></div>
                    <div class="form-row triple-row">
                        <div class="form-group"><label asp-for="EmployeeCode"></label><input asp-for="EmployeeCode" readonly aria-readonly="true" /><span asp-validation-for="EmployeeCode" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" /><span asp-validation-for="FirstName" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" /><span asp-validation-for="LastName" class="field-validation"></span></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="PhoneNumber">Mobile Number</label><input asp-for="PhoneNumber" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)" /><span asp-validation-for="PhoneNumber" class="field-validation"></span></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group"><label asp-for="DateOfBirthText"></label><input asp-for="DateOfBirthText" type="text" inputmode="numeric" maxlength="10" placeholder="DD/MM/YYYY" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" /><span asp-validation-for="DateOfBirthText" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="Gender"></label><select asp-for="Gender"><option value="">Select gender</option><option>Male</option><option>Female</option><option>Other</option></select></div>
                    </div>

                    <div class="section-divider"><span>Address</span></div>
                    <div class="form-group"><label asp-for="Address"></label><input asp-for="Address" /><span asp-validation-for="Address" class="field-validation"></span></div>
                    <div class="form-row">
                        <div class="form-group"><label asp-for="City"></label><input asp-for="City" /></div>
                        <div class="form-group"><label asp-for="State"></label><input asp-for="State" /></div>
                    </div>
                </div>

                <div class="form-side-section">
                    <div class="config-card">
                        <h3>Organizational Mapping</h3>
                        <div class="form-group"><label asp-for="JoiningDate"></label><input asp-for="JoiningDate" type="date" /><span asp-validation-for="JoiningDate" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="Department"></label><input asp-for="Department" /><span asp-validation-for="Department" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="Designation"></label><input asp-for="Designation" /><span asp-validation-for="Designation" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="ReportingManagerId"></label><select asp-for="ReportingManagerId"><option value="">No reporting manager</option>@foreach (var manager in Model.Managers){<option value="@manager.Id">@manager.FullName (@manager.EmployeeCode)</option>}</select><span asp-validation-for="ReportingManagerId" class="field-validation"></span></div>
                        <div class="form-group"><label asp-for="EmploymentType"></label><select asp-for="EmploymentType"><option>Full Time</option><option>Part Time</option><option>Contract</option><option>Intern</option></select></div>
                        <div class="form-group"><label asp-for="EmployeeStatus"></label><select asp-for="EmployeeStatus"><option>Active</option><option>Probation</option><option>Notice Period</option><option>Inactive</option></select></div>
                    </div>
                    <div class="config-card option-card"><h3>Record Status</h3><label class="custom-checkbox"><input asp-for="IsActive" /><span class="checkmark"></span> Active employee</label></div>
                </div>
            </div>
            <div class="form-actions-footer"><a asp-controller="Employee" asp-action="Index" class="btn-cancel">Cancel</a><button type="submit" class="btn-submit">@(editing ? "Save Changes" : "Register Profile")</button></div>
        </form>
    </div>
</div>
