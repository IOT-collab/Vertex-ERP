@* Add namespace where PriorityEnum is defined (or update the namespace name if different) *@
@using Vertex_ERP.Models

@{
    ViewData["Title"] = "Assign & Monitor Tasks";
    Layout = "_Layout";
}
<link href="~/css/AssignTask.css" rel="stylesheet" />

<div class="task-assignment-container">


    <!-- Header Section -->
    <header class="task-header">
        <div class="header-left">
           
            <div class="header-content">
                <div class="header-icon-wrapper">
                    <div class="top-nav-bar">
                        <button type="button" class="btn-back" onclick="window.history.back()" title="Go Back">
                            <span class="back-icon">&#8592;</span>
                        </button>
                    </div>
                </div>
                <div class="header-text">
                    <h1>Task Management</h1>
                    <p>Assign, track, and monitor project tasks seamlessly across your team.</p>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-secondary" id="btnFilter">
                <i class="fas fa-filter"></i> <span>Filter</span>
            </button>
            <button type="button" class="btn btn-primary" id="btnOpenAssignModal">
                <i class="fas fa-plus"></i> <span>Assign Task</span>
            </button>
        </div>
    </header>

    <!-- Overview Stats Cards -->
    <section class="stats-grid" aria-label="Task Statistics">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-tasks"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(Model?.TotalTasks ?? 0)</span>
                <span class="stat-label">Total Tasks</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending">
                <i class="fas fa-spinner fa-spin-pulse"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(Model?.InProgressTasks ?? 0)</span>
                <span class="stat-label">In Progress</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon completed">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(Model?.CompletedTasks ?? 0)</span>
                <span class="stat-label">Completed</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon overdue">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(Model?.OverdueTasks ?? 0)</span>
                <span class="stat-label">Overdue</span>
            </div>
        </div>
    </section>

    <!-- Main Content Layout -->
    <main class="content-grid">
        <!-- Task Assignment Form Card -->
        <div class="card form-card">
            <div class="card-header">
                <h2>Assign New Task</h2>
            </div>
            <div class="card-body">
                <form id="assignTaskForm" method="post" asp-action="AssignTask">
                    <div class="form-group">
                        <label for="taskTitle">Task Title</label>
                        <input type="text" id="taskTitle" name="Title" class="form-control" placeholder="Enter task title..." required />
                    </div>

                    <div class="form-row">
                        <div class="form-group col">
                            <label for="projectName">Project</label>
                            <select id="projectName" name="ProjectId" class="form-control" required asp-items="@(ViewBag.Projects as IEnumerable<SelectListItem>)">
                                <option value="" disabled selected>Select Project</option>
                            </select>
                        </div>
                        <div class="form-group col">
                            <label for="assignee">Assign To</label>
                            <select id="assignee" name="AssignedTo" class="form-control" required asp-items="@(ViewBag.Members as IEnumerable<SelectListItem>)">
                                <option value="" disabled selected>Select Member</option>
                            </select>
                        </div>
                    </div>

                    <!-- Priority Select (Fixed Enum binding & explicit HTML options fallback) -->
                    <div class="form-group">
                        <label for="priority">Priority</label>
                        <select id="priority" name="Priority" class="form-control" required>
                            <option value="" disabled selected>Select Priority</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>

                    <!-- Start Date & Due Date Row -->
                    <div class="form-row">
                        <div class="form-group col">
                            <label for="startDate">Start Date</label>
                            <input type="date" id="startDate" name="StartDate" class="form-control" required />
                        </div>
                        <div class="form-group col">
                            <label for="dueDate">Due Date</label>
                            <input type="date" id="dueDate" name="DueDate" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" name="Description" class="form-control" rows="3" placeholder="Add detailed instructions..."></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="reset" class="btn btn-outline">Reset</button>
                        <button type="submit" class="btn btn-primary">Assign Task</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Task List / Monitor Section -->
        <div class="card list-card">
            <div class="card-header flex-between">
                <h2>Active Tasks</h2>
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="taskSearchInput" placeholder="Search tasks..." class="search-input" />
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="task-table">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Assigned To</th>
                                <th>Priority</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Tasks != null && Model.Tasks.Count > 0)
                            {
                                foreach (var item in Model.Tasks)
                                {
                                    <tr>
                                        <td data-label="Task">
                                            <div class="task-name">@item.Title</div>
                                            <span class="project-tag">@item.ProjectName</span>
                                        </td>
                                        <td data-label="Assigned To">
                                            <div class="user-info">
                                                <div class="avatar">@item.AssigneeInitials</div>
                                                <span>@item.AssigneeName</span>
                                            </div>
                                        </td>
                                        <td data-label="Priority">
                                            <span class="badge badge-@(item.Priority?.ToString().ToLower())">@item.Priority</span>
                                        </td>
                                        <td data-label="Due Date">@item.DueDate.ToString("dd MMM yyyy")</td>
                                        <td data-label="Status">
                                            <span class="status-pill status-@item.StatusClass">
                                                <i class="fas fa-circle"></i> @item.Status
                                            </span>
                                        </td>
                                        <td data-label="Action" class="text-right">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center empty-state">No tasks available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>