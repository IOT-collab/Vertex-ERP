@* Project Timeline *@
@{
    ViewData["Title"] = "Project Timeline";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectTimeline.css" />

<div class="timeline-wrapper">
    <!-- Top Action Bar -->
    <header class="top-bar">
        <div class="page-title">
            <button type="button" class="btn-back" onclick="window.history.back()" title="Go Back">
                <span class="back-icon">&#8592;</span>
            </button>
            <div class="title-icon">
                <i class="fas fa-stream"></i>
            </div>
            <div>
                <h1>Project Timeline</h1>
                <p>Track project roadmaps, phase updates, and multi-project milestones.</p>
            </div>
        </div>

        <div class="top-actions">
            <button class="btn btn-secondary" onclick="exportTimeline()">
                <i class="fas fa-download"></i> <span>Export</span>
            </button>
            <button class="btn btn-primary" onclick="openNewMilestoneModal()">
                <i class="fas fa-plus"></i> <span>New Milestone</span>
            </button>
        </div>
    </header>

    <!-- Multi-Project Selection Hero Bar -->
    <section class="project-selector-card">
        <div class="selector-left">
            <label for="projectSelect" class="selector-label">
                <i class="fas fa-folder-open"></i> Active Project
            </label>
            <div class="custom-select-wrapper">
                <select id="projectSelect" class="project-dropdown" onchange="onProjectChange(this.value)">
                    @if (Model?.Projects != null && Model.Projects.Any())
                    {
                        foreach (var project in Model.Projects)
                        {
                            <option value="@project.Id" selected="@(project.Id == Model.SelectedProjectId)">
                                @project.Name (@project.Code)
                            </option>
                        }
                    }
                    else
                    {
                        <option value="">No Active Projects Found</option>
                    }
                </select>
                <i class="fas fa-chevron-down select-arrow"></i>
            </div>
        </div>

        <!-- Dynamic Selected Project Metadata -->
        <div class="project-meta-pills">
            <div class="meta-pill">
                <span class="meta-title">Client / Dept</span>
                <span class="meta-value">@(Model?.CurrentProject?.ClientName ?? "—")</span>
            </div>
            <div class="meta-pill">
                <span class="meta-title">Project Health</span>
                <span class="meta-value @(Model?.CurrentProject?.HealthClass ?? "health-gray")">
                    <i class="fas fa-heartbeat"></i> @(Model?.CurrentProject?.HealthStatus ?? "N/A")
                </span>
            </div>
            <div class="meta-pill">
                <span class="meta-title">Timeline Range</span>
                <span class="meta-value">@(Model?.CurrentProject?.DateRangeFormatted ?? "N/A")</span>
            </div>
        </div>
    </section>

    <!-- Project Key Metrics -->
    <section class="metrics-row">
        <div class="metric-box">
            <div class="metric-header">
                <span>Overall Completion</span>
                <i class="fas fa-chart-line metric-icon icon-blue"></i>
            </div>
            <div class="metric-body">
                <span class="metric-number">@(Model?.CurrentProject?.OverallCompletionPercentage ?? 0)%</span>
                @if (Model?.CurrentProject?.WeeklyProgressTrend != null)
                {
                    <span class="trend-up"><i class="fas fa-arrow-up"></i> @Model.CurrentProject.WeeklyProgressTrend</span>
                }
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @(Model?.CurrentProject?.OverallCompletionPercentage ?? 0)%;"></div>
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Current Phase</span>
                <i class="fas fa-layer-group metric-icon icon-purple"></i>
            </div>
            <div class="metric-body">
                <span class="metric-title-text">@(Model?.CurrentProject?.CurrentPhaseName ?? "No Active Phase")</span>
            </div>
            <div class="metric-footer text-muted">
                <i class="far fa-calendar-alt"></i> @(Model?.CurrentProject?.CurrentPhaseEndStatus ?? "N/A")
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Milestones Status</span>
                <i class="fas fa-flag metric-icon icon-emerald"></i>
            </div>
            <div class="metric-body">
                <span class="metric-number">
                    @(Model?.CurrentProject?.CompletedMilestoneCount ?? 0)
                    <small>/ @(Model?.CurrentProject?.TotalMilestoneCount ?? 0)</small>
                </span>
                <span class="badge badge-emerald">@(Model?.CurrentProject?.RemainingMilestoneCount ?? 0) Remaining</span>
            </div>
            <div class="milestone-progress-bar">
                @if (Model?.CurrentProject?.MilestoneSteps != null)
                {
                    foreach (var stepState in Model.CurrentProject.MilestoneSteps)
                    {
                        <span class="step @stepState"></span>
                    }
                }
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Team Members</span>
                <i class="fas fa-users metric-icon icon-amber"></i>
            </div>
            <div class="avatar-group">
                @if (Model?.CurrentProject?.TeamMembers != null && Model.CurrentProject.TeamMembers.Any())
                {
                    foreach (var member in Model.CurrentProject.TeamMembers.Take(3))
                    {
                        <div class="avatar @member.ColorClass" title="@member.FullName">@member.Initials</div>
                    }
                    if (Model.CurrentProject.TeamMembers.Count > 3)
                    {
                        <div class="avatar avatar-more">+@(Model.CurrentProject.TeamMembers.Count - 3)</div>
                    }
                }
            </div>
            <div class="metric-footer text-muted">
                @(Model?.CurrentProject?.TeamMembers?.Count ?? 0) Active Contributors
            </div>
        </div>
    </section>

    <!-- Main Content Layout: Timeline Gantt + Detailed Roadmap -->
    <main class="timeline-main-grid">
        <!-- Gantt Visual Phase Map -->
        <div class="glass-card">
            <div class="card-header flex-between">
                <div>
                    <h2>Phase Overview Schedule</h2>
                    <p class="card-subtitle">Visual phase overlapping for selected project</p>
                </div>
                <div class="time-filter">
                    <button class="filter-btn active" onclick="setGanttView('months')">Months</button>
                    <button class="filter-btn" onclick="setGanttView('weeks')">Weeks</button>
                </div>
            </div>
            <div class="card-body">
                <div class="gantt-wrapper">
                    <!-- Dynamic Headers -->
                    <div class="gantt-months">
                        @if (Model?.CurrentProject?.TimelineHeaders != null)
                        {
                            foreach (var header in Model.CurrentProject.TimelineHeaders)
                            {
                                <span>@header</span>
                            }
                        }
                    </div>

                    <!-- Dynamic Phase Bars -->
                    <div class="gantt-rows">
                        @if (Model?.CurrentProject?.Phases != null && Model.CurrentProject.Phases.Any())
                        {
                            foreach (var phase in Model.CurrentProject.Phases)
                            {
                                <div class="gantt-row">
                                    <span class="phase-name">@phase.Name</span>
                                    <div class="gantt-track">
                                        <div class="gantt-bar @phase.StatusCssClass" style="left: @(phase.LeftPercentage)%; width: @(phase.WidthPercentage)%;">
                                            <span>@phase.StatusText</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">No timeline phases configured for this project.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Vertical Milestone Breakdown -->
        <div class="glass-card">
            <div class="card-header flex-between">
                <div>
                    <h2>Detailed Milestones</h2>
                    <p class="card-subtitle">Key project goals and deliverables</p>
                </div>
                <div class="search-sm">
                    <i class="fas fa-search"></i>
                    <input type="text" id="milestoneFilterInput" onkeyup="filterMilestones()" placeholder="Filter milestones..." />
                </div>
            </div>
            <div class="card-body">
                <div class="vertical-roadmap" id="milestoneList">
                    @if (Model?.CurrentProject?.Milestones != null && Model.CurrentProject.Milestones.Any())
                    {
                        foreach (var milestone in Model.CurrentProject.Milestones)
                        {
                            <div class="roadmap-card status-@milestone.Status.ToLower()" data-title="@milestone.Title">
                                <div class="roadmap-node @(milestone.Status == "Active" ? "active-node" : "")">
                                    @if (milestone.Status == "Completed")
                                    {
                                        <i class="fas fa-check"></i>
                                    }
                                    else if (milestone.Status == "Active")
                                    {
                                        <span class="pulse-dot"></span>
                                    }
                                </div>
                                <div class="roadmap-card-body">
                                    <div class="roadmap-top">
                                        <div>
                                            <h3>@milestone.Title</h3>
                                            <span class="date-badge"><i class="far fa-clock"></i> @milestone.DateRangeFormatted</span>
                                        </div>
                                        <span class="badge @milestone.BadgeCssClass">@milestone.Status</span>
                                    </div>
                                    <p>@milestone.Description</p>

                                    @if (milestone.ProgressPercentage.HasValue)
                                    {
                                        <div class="inline-progress">
                                            <div class="progress-labels">
                                                <span>Phase Tasks</span>
                                                <span>@milestone.ProgressPercentage% Done</span>
                                            </div>
                                            <div class="progress-track">
                                                <div class="progress-fill fill-blue" style="width: @(milestone.ProgressPercentage)%;"></div>
                                            </div>
                                        </div>
                                    }

                                    <div class="roadmap-footer">
                                        <div class="assignee">
                                            <div class="avatar-xs @milestone.AssigneeAvatarClass">@milestone.AssigneeInitials</div>
                                            @milestone.AssigneeName
                                        </div>
                                        <div class="tags">
                                            @if (milestone.Tags != null)
                                            {
                                                foreach (var tag in milestone.Tags)
                                                {
                                                    <span class="tag">@tag</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">No milestones found.</div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    function onProjectChange(projectId) {
        if (projectId) {
            var baseUrl = '@Url.Action("Timeline", "Project")';
            window.location.href = baseUrl + '?projectId=' + encodeURIComponent(projectId);
        }
    }

    function filterMilestones() {
        var input = document.getElementById('milestoneFilterInput').value.toLowerCase();
        var cards = document.querySelectorAll('#milestoneList .roadmap-card');

        cards.forEach(function(card) {
            var title = (card.getAttribute('data-title') || '').toLowerCase();
            if (title.includes(input)) {
                card.style.display = "";
            } else {
                card.style.display = "none";
            }
        });
    }

    function setGanttView(mode) {
        console.log("Switching Gantt view to:", mode);
    }

    function exportTimeline() {
        console.log("Exporting timeline data...");
    }

    function openNewMilestoneModal() {
        console.log("Opening New Milestone Modal...");
    }
</script>