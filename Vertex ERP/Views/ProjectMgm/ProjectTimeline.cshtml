@{
    ViewData["Title"] = "Project Timeline & Roadmap";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/ProjectTimeline.css" />

<div class="timeline-wrapper">
    <!-- Top Action Bar -->
    <header class="top-bar">
        <div class="page-title">
            <div class="title-icon">
                <i class="fas fa-stream"></i>
            </div>
            <div>
                <h1>Project Timeline</h1>
                <p>Track project roadmaps, phase updates, and multi-project milestones.</p>
            </div>
        </div>

        <div class="top-actions">
            <button class="btn btn-secondary">
                <i class="fas fa-download"></i> <span>Export</span>
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-plus"></i> <span>New Milestone</span>
            </button>
        </div>
    </header>

    <!-- Multi-Project Selection Hero Bar -->
    <section class="project-selector-card">
        <div class="selector-left">
            <label for="projectSelect" class="selector-label">
                <i class="fas fa-folder-open"></i> Active Project
            </label>
            <div class="custom-select-wrapper">
                <select id="projectSelect" class="project-dropdown" onchange="onProjectChange(this.value)">
                    <option value="1" selected>🚀 E-Commerce Platform Redesign (PROJ-2026-A)</option>
                    <option value="2">📱 Mobile Banking App v3.2 (PROJ-2026-B)</option>
                    <option value="3">☁️ Cloud Infrastructure Migration (PROJ-2026-C)</option>
                    <option value="4">🔒 Cyber Security Audit & Fixes (PROJ-2026-D)</option>
                </select>
                <i class="fas fa-chevron-down select-arrow"></i>
            </div>
        </div>

        <!-- Dynamic Selected Project Metadata -->
        <div class="project-meta-pills">
            <div class="meta-pill">
                <span class="meta-title">Client / Dept</span>
                <span class="meta-value">Retail Hub Ltd.</span>
            </div>
            <div class="meta-pill">
                <span class="meta-title">Project Health</span>
                <span class="meta-value health-green"><i class="fas fa-heartbeat"></i> On Track</span>
            </div>
            <div class="meta-pill">
                <span class="meta-title">Timeline Range</span>
                <span class="meta-value">01 Jun - 15 Sep 2026</span>
            </div>
        </div>
    </section>

    <!-- Project Key Metrics -->
    <section class="metrics-row">
        <div class="metric-box">
            <div class="metric-header">
                <span>Overall Completion</span>
                <i class="fas fa-chart-line metric-icon icon-blue"></i>
            </div>
            <div class="metric-body">
                <span class="metric-number">65%</span>
                <span class="trend-up"><i class="fas fa-arrow-up"></i> +8% this week</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: 65%;"></div>
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Current Phase</span>
                <i class="fas fa-layer-group metric-icon icon-purple"></i>
            </div>
            <div class="metric-body">
                <span class="metric-title-text">Phase 2: UI Design</span>
            </div>
            <div class="metric-footer text-muted">
                <i class="far fa-calendar-alt"></i> Ends in 6 Days (Jul 30, 2026)
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Milestones Status</span>
                <i class="fas fa-flag metric-icon icon-emerald"></i>
            </div>
            <div class="metric-body">
                <span class="metric-number">3 <small>/ 5</small></span>
                <span class="badge badge-emerald">2 Remaining</span>
            </div>
            <div class="milestone-progress-bar">
                <span class="step done"></span>
                <span class="step done"></span>
                <span class="step done"></span>
                <span class="step active"></span>
                <span class="step"></span>
            </div>
        </div>

        <div class="metric-box">
            <div class="metric-header">
                <span>Team Members</span>
                <i class="fas fa-users metric-icon icon-amber"></i>
            </div>
            <div class="avatar-group">
                <div class="avatar" title="Rahul Sharma">RS</div>
                <div class="avatar avatar-purple" title="Priya Patel">PP</div>
                <div class="avatar avatar-emerald" title="Amit Kumar">AK</div>
                <div class="avatar avatar-more">+4</div>
            </div>
            <div class="metric-footer text-muted">7 Active Contributors</div>
        </div>
    </section>

    <!-- Main Content Layout: Timeline Gantt + Detailed Roadmap -->
    <main class="timeline-main-grid">
        <!-- Gantt Visual Phase Map -->
        <div class="glass-card">
            <div class="card-header flex-between">
                <div>
                    <h2>Phase Overview Schedule</h2>
                    <p class="card-subtitle">Visual phase overlapping for selected project</p>
                </div>
                <div class="time-filter">
                    <button class="filter-btn active">Months</button>
                    <button class="filter-btn">Weeks</button>
                </div>
            </div>
            <div class="card-body">
                <div class="gantt-wrapper">
                    <!-- Months Header -->
                    <div class="gantt-months">
                        <span>June 2026</span>
                        <span>July 2026</span>
                        <span>August 2026</span>
                        <span>September 2026</span>
                    </div>

                    <!-- Phase Bars -->
                    <div class="gantt-rows">
                        <div class="gantt-row">
                            <span class="phase-name">1. Requirement & Scope</span>
                            <div class="gantt-track">
                                <div class="gantt-bar bar-done" style="left: 0%; width: 25%;">
                                    <span>Completed</span>
                                </div>
                            </div>
                        </div>

                        <div class="gantt-row">
                            <span class="phase-name">2. UI/UX Prototyping</span>
                            <div class="gantt-track">
                                <div class="gantt-bar bar-active" style="left: 20%; width: 30%;">
                                    <span>In Progress (85%)</span>
                                </div>
                            </div>
                        </div>

                        <div class="gantt-row">
                            <span class="phase-name">3. API & Backend Dev</span>
                            <div class="gantt-track">
                                <div class="gantt-bar bar-upcoming" style="left: 45%; width: 35%;">
                                    <span>Upcoming</span>
                                </div>
                            </div>
                        </div>

                        <div class="gantt-row">
                            <span class="phase-name">4. Testing & Deployment</span>
                            <div class="gantt-track">
                                <div class="gantt-bar bar-upcoming" style="left: 75%; width: 25%;">
                                    <span>Upcoming</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vertical Milestone Breakdown -->
        <div class="glass-card">
            <div class="card-header flex-between">
                <div>
                    <h2>Detailed Milestones</h2>
                    <p class="card-subtitle">Key project goals and deliverables</p>
                </div>
                <div class="search-sm">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Filter milestones..." />
                </div>
            </div>
            <div class="card-body">
                <div class="vertical-roadmap">

                    <!-- Milestone Card 1 -->
                    <div class="roadmap-card status-completed">
                        <div class="roadmap-node">
                            <i class="fas fa-check"></i>
                        </div>
                        <div class="roadmap-card-body">
                            <div class="roadmap-top">
                                <div>
                                    <h3>Scope Lock & Wireframes Approval</h3>
                                    <span class="date-badge"><i class="far fa-clock"></i> Jun 01 - Jun 15, 2026</span>
                                </div>
                                <span class="badge badge-emerald">Completed</span>
                            </div>
                            <p>Finalized SRS document, client wireframes approval, and sprint architecture design.</p>
                            <div class="roadmap-footer">
                                <div class="assignee"><div class="avatar-xs">RS</div> Rahul Sharma</div>
                                <div class="tags"><span class="tag">Planning</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Milestone Card 2 -->
                    <div class="roadmap-card status-active">
                        <div class="roadmap-node active-node">
                            <span class="pulse-dot"></span>
                        </div>
                        <div class="roadmap-card-body">
                            <div class="roadmap-top">
                                <div>
                                    <h3>Dashboard & Analytics UI Kit</h3>
                                    <span class="date-badge"><i class="far fa-clock"></i> Jun 16 - Jul 30, 2026</span>
                                </div>
                                <span class="badge badge-blue">In Progress</span>
                            </div>
                            <p>Building high-fidelity responsive dark/light UI components in Figma & C# Razor Razor Views.</p>

                            <div class="inline-progress">
                                <div class="progress-labels">
                                    <span>Phase Tasks</span>
                                    <span>85% Done</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill fill-blue" style="width: 85%;"></div>
                                </div>
                            </div>

                            <div class="roadmap-footer">
                                <div class="assignee"><div class="avatar-xs avatar-purple">PP</div> Priya Patel</div>
                                <div class="tags"><span class="tag">Frontend</span><span class="tag">UI/UX</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Milestone Card 3 -->
                    <div class="roadmap-card status-upcoming">
                        <div class="roadmap-node"></div>
                        <div class="roadmap-card-body">
                            <div class="roadmap-top">
                                <div>
                                    <h3>Payment Gateway & Security Integrations</h3>
                                    <span class="date-badge"><i class="far fa-clock"></i> Aug 01 - Aug 20, 2026</span>
                                </div>
                                <span class="badge badge-gray">Upcoming</span>
                            </div>
                            <p>Stripe & PayPal integration, OAuth2 authentication, and PCI DSS compliance check.</p>
                            <div class="roadmap-footer">
                                <div class="assignee"><div class="avatar-xs avatar-emerald">AK</div> Amit Kumar</div>
                                <div class="tags"><span class="tag">Backend</span><span class="tag">Security</span></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
</div>

<script>
    function onProjectChange(projectId) {
        console.log("Switched to Project ID:", projectId);
    }
</script>