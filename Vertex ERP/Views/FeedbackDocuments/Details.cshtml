@model VertexERP.Models.FeedbackDocumentDetailsViewModel
@{ Layout = "~/Views/Shared/_LayoutMaster.cshtml"; ViewData["Title"] = Model.Document.Title; }
<link href="~/css/FeedbackDocuments.css" rel="stylesheet" asp-append-version="true" />
<section class="fd-workspace">
    <header class="fd-hero"><div><span class="fd-eyebrow">@(Model.IsManagement ? "EMPLOYEE RESPONSE TRACKER" : "FORM & RESPONSE")</span><h1>@Model.Document.Title</h1><p>Published @Model.Document.PublishedAtUtc.AddMinutes(330).ToString("dd MMM yyyy · hh:mm tt") IST</p></div><a asp-action="Index" class="fd-secondary">All Forms</a></header>
    <nav class="fd-tabs" aria-label="Feedback views"><a asp-action="Index"><i class="fa-solid fa-folder-open" aria-hidden="true"></i><span>Published Forms</span></a>@if (Model.IsManagement) { <a asp-action="Responses" asp-route-id="@Model.Document.Id" class="selected" aria-current="page"><i class="fa-solid fa-file-circle-check" aria-hidden="true"></i><span>Employee Responses</span></a><a asp-controller="Feedback" asp-action="MessageInbox"><i class="fa-solid fa-comments" aria-hidden="true"></i><span>Written Feedback</span></a> }<a asp-controller="Feedback" asp-action="Message"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span>Send Feedback</span></a></nav>
    <partial name="~/Views/FeedbackDocuments/_Notices.cshtml" />
    <section class="fd-panel fd-source"><div><h2>Download the original form</h2>@if (Model.Document.Instructions != null) { <p class="fd-instructions">@Model.Document.Instructions</p> }<p class="fd-muted">Download the file, fill/sign or complete it, then upload the finished PDF or image below.</p></div><partial name="~/Views/FeedbackDocuments/_FileLinks.cshtml" model="Model.Document.Assets.Where(x => x.SubmissionId == null).ToList()" /></section>
    @if (Model.IsManagement) {
        <div class="fd-stats"><a asp-action="Details" asp-route-id="@Model.Document.Id" asp-route-status="all"><span>Total Employees</span><strong>@Model.TotalEmployees</strong></a><a asp-action="Details" asp-route-id="@Model.Document.Id" asp-route-status="submitted"><span>Submitted</span><strong>@Model.SubmittedCount</strong></a><a asp-action="Details" asp-route-id="@Model.Document.Id" asp-route-status="pending"><span>Pending</span><strong>@Model.PendingCount</strong></a></div>
        <section class="fd-panel">
            <div class="fd-section-title"><h2>Employee responses</h2><form asp-action="Responses" method="get"><label class="fd-sr-only" for="fd-document">Choose form</label><select name="id" id="fd-document" onchange="this.form.submit()">@foreach (var document in Model.Documents) { <option value="@document.Id" selected="@(document.Id == Model.Document.Id)">@document.Title</option> }</select><button type="submit" class="fd-secondary">Open Form</button></form></div>
            <form asp-action="Details" asp-route-id="@Model.Document.Id" method="get" class="fd-filter"><input type="hidden" name="id" value="@Model.Document.Id" /><input name="search" maxlength="150" value="@Model.Search" placeholder="Search employee, ID or designation..." aria-label="Search employee" /><select name="department" aria-label="Department"><option value="">All Departments</option>@foreach (var department in Model.Departments) { <option value="@department" selected="@(department == Model.Department)">@department</option> }</select><select name="status" aria-label="Submission status"><option value="all">All Statuses</option><option value="submitted" selected="@(Model.Status == "submitted")">Submitted</option><option value="pending" selected="@(Model.Status == "pending")">Pending</option></select><button type="submit" class="fd-primary">Filter</button><a asp-action="Details" asp-route-id="@Model.Document.Id" class="fd-secondary">Reset</a></form>
            <p class="fd-muted">Current employee details are shown. Previous submitters remain listed even if their profile becomes inactive.</p>
            <div class="fd-table-scroll"><table class="fd-table"><thead><tr><th>Employee</th><th>Department</th><th>Designation</th><th>Status</th><th>Submitted</th><th>Uploaded Files / Comment</th></tr></thead><tbody>
            @foreach (var row in Model.Employees) {
                <tr><td><strong data-no-localize>@row.Employee.FullName</strong><small data-no-localize>@row.Employee.EmployeeCode</small>@if (!row.Employee.IsActive) { <small>Inactive</small> }</td><td>@row.Employee.Department</td><td>@row.Employee.Designation</td><td><span class="fd-badge @(row.Submission != null ? "submitted" : "pending")">@(row.Submission != null ? "Submitted" : "Pending")</span></td><td>@if (row.Submission != null) { <span>@row.Submission.SubmittedAtUtc.AddMinutes(330).ToString("dd MMM yyyy")</span><small>@row.Submission.SubmittedAtUtc.AddMinutes(330).ToString("hh:mm tt") IST · Version @row.Submission.Revision</small> } else { <span>—</span> }</td><td>@if (row.Submission != null) { <partial name="~/Views/FeedbackDocuments/_FileLinks.cshtml" model="row.Submission.Assets.ToList()" />@if (row.Submission.Comment != null) { <p class="fd-comment">@row.Submission.Comment</p> } } else { <span class="fd-muted">Awaiting upload</span> }</td></tr>
            }
            @if (Model.Employees.Count == 0) { <tr><td colspan="6" class="fd-empty">No employees match these filters.</td></tr> }
            </tbody></table></div>
        </section>
    }
    @if (Model.CanSubmit) {
        <div class="fd-columns with-publish fd-response-columns">
            <section class="fd-panel"><h2>@(Model.OwnSubmission != null ? "Upload an updated response" : "Upload your completed form")</h2><p class="fd-muted">Your files and comment are visible only to you and HR/Admin. Earlier uploads are retained as versions.</p><form asp-action="Submit" asp-route-id="@Model.Document.Id" method="post" enctype="multipart/form-data" data-feedback-upload>
                <label class="fd-upload"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><strong>Select completed PDF or images</strong><input name="Files" type="file" multiple required accept=".pdf,.jpg,.jpeg,.png" /><small>Up to 5 files · 10 MB each · 25 MB combined</small></label><ul class="fd-selected-files" data-file-list></ul><p class="fd-file-error" data-file-error role="alert" hidden></p>
                <label>Comment (optional)<textarea name="Comment" rows="4" maxlength="2000" placeholder="Add a note for HR/Admin"></textarea></label><button class="fd-primary" type="submit">@(Model.OwnSubmission != null ? "Upload New Version" : "Submit Response")</button>
            </form></section>
            <section class="fd-panel"><h2>My submission</h2>@if (Model.OwnSubmission == null) { <div class="fd-empty"><i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i><strong>Not submitted yet</strong><p>Upload your completed files using the form beside this panel.</p></div> } else { <p><span class="fd-badge submitted">Submitted</span> <small class="fd-muted">@Model.OwnSubmission.SubmittedAtUtc.AddMinutes(330).ToString("dd MMM yyyy · hh:mm tt") IST</small></p><partial name="~/Views/FeedbackDocuments/_FileLinks.cshtml" model="Model.OwnSubmission.Assets.ToList()" />@if (Model.OwnSubmission.Comment != null) { <p class="fd-comment">@Model.OwnSubmission.Comment</p> } }</section>
        </div>
    }
</section>
<script src="~/js/feedback-documents.js" asp-append-version="true" defer></script>
