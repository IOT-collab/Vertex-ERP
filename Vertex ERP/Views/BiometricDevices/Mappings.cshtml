@model IReadOnlyList<VertexERP.Models.EmployeeDeviceMapping>
@{ var device = (VertexERP.Models.BiometricDevice)ViewBag.Device; var employees = (IReadOnlyList<VertexERP.Models.Employee>)ViewBag.Employees; var unmapped = (IReadOnlyList<VertexERP.Models.UnmappedDeviceUserViewModel>)ViewBag.UnmappedUserIds; ViewData["Title"] = "Employee Device Mapping"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/BiometricDevices.css" rel="stylesheet" asp-append-version="true" />
<div class="bio-page narrow">
<div class="bio-header"><div><span class="bio-kicker">@device.SerialNumber</span><h1>Employee Device Mapping</h1><p>Match the K40 Pro user ID with an existing ERP employee.</p></div><a asp-action="Index" class="bio-secondary">Back to devices</a></div>
@if (TempData["BiometricMessage"] is string message) { <div class="bio-alert success">@message</div> }
@if (TempData["BiometricError"] is string error) { <div class="bio-alert error">@error</div> }
<form asp-action="AddMapping" method="post" class="bio-map-form"><input type="hidden" name="DeviceId" value="@device.Id" /><label><span>Device User ID</span><input name="DeviceUserId" required placeholder="e.g. 15" /></label><label><span>ERP Employee</span><select name="EmployeeId" required><option value="">Select employee</option>@foreach(var employee in employees){<option value="@employee.Id">@employee.EmployeeCode - @employee.FullName</option>}</select></label><button class="bio-primary" type="submit">Save Mapping</button></form>
@if(unmapped.Count > 0){<h2>Unmapped punches received</h2><div class="bio-table-wrap"><table><thead><tr><th>Device User ID</th><th>Punches</th><th>Last punch</th><th>Action</th></tr></thead><tbody>@foreach(var item in unmapped){<tr><td><strong>@item.DeviceUserId</strong></td><td>@item.PunchCount</td><td>@item.LastPunch.ToString("dd MMM yyyy HH:mm")</td><td><button type="button" class="bio-link" onclick="document.querySelector('[name=DeviceUserId]').value='@item.DeviceUserId';document.querySelector('[name=EmployeeId]').focus();">Map this ID</button></td></tr>}</tbody></table></div>}
<h2>Active mappings</h2><div class="bio-table-wrap"><table><thead><tr><th>Device User ID</th><th>Employee ID</th><th>Employee Name</th><th>Department</th><th>Status</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="5" class="bio-empty">No employee mappings yet.</td></tr>}@foreach(var mapping in Model){<tr><td><strong>@mapping.DeviceUserId</strong></td><td>@mapping.Employee.EmployeeCode</td><td>@mapping.Employee.FullName</td><td>@mapping.Employee.Department</td><td><span class="bio-status online"><i></i>Active</span></td></tr>}</tbody></table></div>
</div>
