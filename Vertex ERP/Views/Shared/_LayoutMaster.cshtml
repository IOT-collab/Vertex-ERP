<!DOCTYPE html>
@inject VertexERP.Data.ApplicationDbContext LayoutDb
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Vertex ERP</title>
    <link href="~/css/Style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/css/common-ui.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/common-back-button.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/erp-buttons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/hr-modules.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="erp-shell @((User.IsInRole("Employee") || User.IsInRole("User")) ? "employee-self-service-only" : "")">
    @{
        var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
        var currentName = User.Identity?.Name ?? currentRole;
        var isEmployee = User.IsInRole("Employee") || User.IsInRole("User");
        var isManager = User.IsInRole("Manager");
        var isHr = User.IsInRole("HR");
        var pendingBankRequestCount = isHr ? LayoutDb.BankDetailUpdateRequests.Count(request => request.Status == "Pending") : 0;
        var homeUrl = isEmployee ? "/Main/EmployeeHome" : isManager ? "/Main/Manager" : "/Main/Dashboard";
    }

    <!-- Pure CSS Sidebar Drawer Controller Toggle -->
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-check" />

    <div class="layout">

        <!-- Mobile Drawer Overlay Screen -->
        <label for="sidebar-toggle" class="sidebar-overlay"></label>

        <!-- Sidebar Navigation Drawer -->
        <aside class="sidebar">
            <div class="logo">
                <a class="erp-logo-link" href="@homeUrl" aria-label="Go to Dashboard">
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                    <span>Vertex ERP</span>
                </a>
                    <label for="sidebar-toggle" class="sidebar-close-btn">&times;</label>
            </div>

            <ul class="sidebar-menu">
                @if (isEmployee)
                {
                    <li><a href="/Main/Employees"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><span>Dashboard</span></a></li>
                    <li><a href="/Main/EmployeeTasks"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>My Tasks</span></a></li>
                    <li><a href="/Main/EmployeeAttendance"><i class="fa-regular fa-clock" aria-hidden="true"></i><span>Attendance</span></a></li>
                    <li><a href="/Main/FieldAttendance"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>Mark Attendance</span></a></li>
                    <li><a href="/Main/EmployeeLeaves"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i><span>Leave Management</span></a></li>
                    <li><a href="/Main/EmployeeProfile"><i class="fa-regular fa-user" aria-hidden="true"></i><span>My Profile</span></a></li>
                    <li><a href="/Main/EmployeeNotifications"><i class="fa-regular fa-bell" aria-hidden="true"></i><span>Notifications</span></a></li>
                    <li><a href="/Main/EmployeeQueries"><i class="fa-regular fa-circle-question" aria-hidden="true"></i><span>Raise Query</span></a></li>
                    <li><a href="/Main/SalarySlips"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i><span>Salary Slip</span></a></li>
                    <li><a href="/Main/EmployeeAssets"><i class="fa-solid fa-laptop" aria-hidden="true"></i><span>Assets</span></a></li>
                    <li><a asp-controller="Expense" asp-action="Index"><i class="fa-solid fa-receipt" aria-hidden="true"></i><span>Expense Claims</span></a></li>
                    <li><a href="/Main/MyBankDetails"><i class="fa-solid fa-building-columns" aria-hidden="true"></i><span>My Bank Details</span></a></li>
                }
                else if (isManager)
                {
                    <li><a href="/Main/Manager"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Manager Dashboard</span></a></li>
                    <li><a href="/Main/Employees"><i class="fa-solid fa-users" aria-hidden="true"></i><span>Employees</span></a></li>
                    <li><a href="/Main/ManagerAttendance"><i class="fa-solid fa-users-viewfinder" aria-hidden="true"></i><span>Team Attendance</span></a></li>
                    <li><a href="/Main/LocationTracking"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><span>Site Employee Location</span></a></li>
                    <li><a href="/Main/ManagerLeaves"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i><span>Team Leave</span></a></li>
                    <li><a asp-controller="Expense" asp-action="Index"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i><span>Team Expenses</span></a></li>
                    <li><a href="/Main/ManagerQueries"><i class="fa-regular fa-circle-question" aria-hidden="true"></i><span>Queries</span></a></li>
                    <li><a href="/Main/TaskMgm"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>Task Management</span></a></li>
                    <li><a href="/Main/ManagerProjects"><i class="fa-solid fa-folder-open" aria-hidden="true"></i><span>Project Management</span></a></li>
                    <li><a href="/Main/OrderTracking"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><span>Shipment Tracking</span></a></li>
                    <li class="manager-self-label"><span>MY SELF SERVICE</span></li>
                    <li><a href="/Main/EmployeeAttendance"><i class="fa-regular fa-clock" aria-hidden="true"></i><span>My Attendance</span></a></li>
                    <li><a href="/Main/FieldAttendance"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>Mark Attendance</span></a></li>
                    <li><a href="/Main/EmployeeLeaves"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i><span>My Leave</span></a></li>
                    <li><a href="/Main/EmployeeProfile"><i class="fa-regular fa-user" aria-hidden="true"></i><span>My Profile</span></a></li>
                    <li><a href="/Main/SalarySlips"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i><span>Salary Slip</span></a></li>
                    <li><a asp-controller="Expense" asp-action="Index" asp-route-view="self"><i class="fa-solid fa-receipt" aria-hidden="true"></i><span>My Expense Claims</span></a></li>
                    <li><a href="/Main/EmployeeAssets"><i class="fa-solid fa-laptop" aria-hidden="true"></i><span>Assets</span></a></li><li><a href="/Main/MyBankDetails"><i class="fa-solid fa-building-columns" aria-hidden="true"></i><span>My Bank Details</span></a></li>
                }
                else
                {
                    <li><a href="/Main/Dashboard"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Dashboard</span></a></li>
                    <li><a href="/Main/Employees"><i class="fa-solid fa-users" aria-hidden="true"></i><span>Employees</span></a></li>
                    <li><a href="/Main/Attendence"><i class="fa-solid fa-clock" aria-hidden="true"></i><span>Attendance</span></a></li>
                    <li><a href="/Main/LocationTracking"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><span>Site Employee Location</span></a></li>
                    <li><a href="/Main/LeaveManagement"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i><span>Leave Management</span></a></li>
                    <li><a href="/Main/WorkflowManagement"><i class="fa-solid fa-code-pull-request" aria-hidden="true"></i><span>Leave & Queries</span></a></li>
@*                     <li><a href="/Main/DepartmentManagement"><i class="fa-solid fa-building" aria-hidden="true"></i><span>Department</span></a></li>
 *@                    <li><a href="/Main/Hrms"><i class="fa-solid fa-user-tie" aria-hidden="true"></i><span>HR Management</span></a></li>
                    <li><a href="/Main/Manager"><i class="fa-solid fa-people-roof" aria-hidden="true"></i><span>Manager</span></a></li>
                    <li><a href="/Main/OrderTracking"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><span>Shipment Tracking</span></a></li>
                    <li><a href="/Main/TaskMgm"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span>Task Management</span></a></li>
                    <li><a href="/Main/ProjectMgm"><i class="fa-solid fa-folder-open" aria-hidden="true"></i><span>Project Management</span></a></li>
                    <li><a href="/Main/AdminPanel"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Admin Panel</span></a></li>
                    <li><a href="/Main/UserSettings"><i class="fa-solid fa-user-gear" aria-hidden="true"></i><span>User Setting</span></a></li>
                    <li><a href="/Main/Reports"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span>Reports</span></a></li>
                    <li><a href="/Main/Settings"><i class="fa-solid fa-gear" aria-hidden="true"></i><span>Settings</span></a></li>
                    @if (isHr)
                    {
                        <li class="manager-self-label"><span>MY SELF SERVICE</span></li>
                        <li><a href="/Main/EmployeeAttendance"><i class="fa-regular fa-clock"></i><span>My Attendance</span></a></li>
                        <li><a href="/Main/EmployeeLeaves"><i class="fa-regular fa-calendar-check"></i><span>My Leave</span></a></li>
                        <li><a href="/Main/EmployeeProfile"><i class="fa-regular fa-user"></i><span>My Profile</span></a></li>
                        <li><a href="/Main/SalarySlips"><i class="fa-solid fa-file-invoice-dollar"></i><span>Salary Slip</span></a></li>
                        <li><a asp-controller="Expense" asp-action="Index"><i class="fa-solid fa-receipt" aria-hidden="true"></i><span>Expense Audit</span></a></li>
                        <li><a href="/Main/EmployeeAssets"><i class="fa-solid fa-laptop" aria-hidden="true"></i><span>Assets</span></a></li><li><a href="/Main/MyBankDetails"><i class="fa-solid fa-building-columns"></i><span>My Bank Details</span></a></li>
                        <li><a href="/Main/BankUpdateRequests"><i class="fa-solid fa-building-circle-check"></i><span>Bank Update Requests</span>@if(pendingBankRequestCount>0){<b style="margin-left:auto;background:#ef4444;color:#fff;border-radius:999px;padding:3px 7px;font-size:11px">@pendingBankRequestCount</b>}</a></li>
                    }
                }
            </ul>
        </aside>

        <!-- Main Dashboard Workspace Panel -->
        <main class="main-content">

            <!-- Global Action Application Topbar -->
            <header class="topbar">
                <div class="topbar-left">
                    <label for="sidebar-toggle" class="hamburger-menu-btn" title="Open navigation" aria-label="Open navigation">
                        <span></span>
                        <span></span>
                        <span></span>
                    </label>
                    <a class="topbar-brand" href="@homeUrl" aria-label="Go to Dashboard">
                        <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                        <span>Vertex ERP</span>
                    </a>
                </div>

                <div class="profile">
                    <span class="profile-text" title="Signed in as @currentName">Welcome @currentName</span>
                    <form asp-controller="Main" asp-action="Logout" method="post" style="display:inline">
                        <button class="logout-btn" type="submit" title="Logout">Logout</button>
                    </form>
                </div>
            </header>

            <!-- Embedded Nested Page Target Body Canvas Wrapper -->
            <div class="page-content">
                <partial name="_BackButton" />
                @RenderBody()
            </div>

        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/input-rules.js" asp-append-version="true"></script>
    <script>
        (() => {
            const attendanceSelectors = {
                '/Main/Attendence': '.attendance-panel-container',
                '/Main/EmployeeAttendance': '.employee-section',
                '/Main/EmployeeAssets': '.employee-section',
                '/Main/Hrms': '.hrms-page'
            };
            const selector = attendanceSelectors[window.location.pathname];
            const target = document.querySelector('[data-attendance-auto-refresh]') || (selector ? document.querySelector(selector) : null);
            if (!target) return;
            let refreshing = false;
            const refreshAttendanceInBackground = async () => {
                if (refreshing || document.hidden || document.activeElement?.matches('input, select, textarea')) return;
                refreshing = true;
                try {
                    const response = await fetch(window.location.href, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const nextDocument = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const nextTarget = nextDocument.querySelector('[data-attendance-auto-refresh]') || (selector ? nextDocument.querySelector(selector) : null);
                    if (nextTarget) target.innerHTML = nextTarget.innerHTML;
                } catch {
                    // A temporary connection problem must not disturb the current screen.
                } finally {
                    refreshing = false;
                }
            };
            window.setInterval(refreshAttendanceInBackground, 15000);
            document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshAttendanceInBackground(); });
        })();
    </script>
</body>
