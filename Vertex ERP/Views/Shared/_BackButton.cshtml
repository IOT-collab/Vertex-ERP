@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var topLevelMainPages = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Dashboard",
        "EmployeeHome",
        "Employees",
        "Attendence",
        "LeaveManagement",
        "DepartmentManagement",
        "Hrms",
        "TaskMgm",
        "ProjectMgm",
        "AdminPanel",
        "UserSettings",
        "Reports",
        "Settings"
    };
    var showBackButton = !string.Equals(controller, "Main", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(action)
        || !topLevelMainPages.Contains(action);
    var isDepartmentPage = string.Equals(controller, "Hr", StringComparison.OrdinalIgnoreCase)
        && action is "Department" or "AddDepartment" or "EditDepartment" or "DeleteDepartment" or "DepartmentDetails";
    var isEmployeePage = string.Equals(controller, "Employee", StringComparison.OrdinalIgnoreCase);
    var isEmployeeIndex = isEmployeePage && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    var isHrPage = string.Equals(controller, "Hr", StringComparison.OrdinalIgnoreCase);
    var backController = isDepartmentPage
        ? (string.Equals(action, "Department", StringComparison.OrdinalIgnoreCase) ? "Main" : "Hr")
        : isEmployeeIndex ? "Main"
        : isEmployeePage ? "Employee"
        : ViewData["BackController"]?.ToString();
    var backAction = isDepartmentPage
        ? (string.Equals(action, "Department", StringComparison.OrdinalIgnoreCase) ? "Hrms" : "Department")
        : isEmployeeIndex ? "Hrms"
        : isEmployeePage ? "Index"
        : ViewData["BackAction"]?.ToString();
    if (isHrPage && !isDepartmentPage)
    {
        if (action is "GenerateDocument" or "UploadDocument")
        {
            backController = "Hr";
            backAction = "EmpDocuments";
        }
        else if (action is "AddEmployeeBankDetails" or "AddEmployeeSalaryDetails")
        {
            backController = "Hr";
            backAction = "HrAddEmp";
        }
        else
        {
            backController = "Main";
            backAction = "Hrms";
        }
    }
    var hasExplicitBackRoute = !string.IsNullOrWhiteSpace(backController) && !string.IsNullOrWhiteSpace(backAction);
    var isActiveIssuesPage = string.Equals(controller, "Main", StringComparison.OrdinalIgnoreCase)
        && action is "WorkflowManagement" or "ManagerQueries";
    var isClosedIssuesPage = string.Equals(controller, "Main", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "ClosedIssues", StringComparison.OrdinalIgnoreCase);
}

@if (showBackButton)
{
    <nav class="common-back-nav" aria-label="Page navigation">
        @if (hasExplicitBackRoute)
        {
        <a
                class="common-back-button"
                asp-controller="@backController"
                asp-action="@backAction"
                title="Go Back"
                aria-label="Go Back">
            <svg class="common-back-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>Back</span>
        </a>
        }
        else
        {
        <button type="button"
                class="common-back-button"
                onclick="window.history.back()"
                title="Go Back"
                aria-label="Go Back">
            <svg class="common-back-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>Back</span>
        </button>
        }
        @if (isActiveIssuesPage)
        {
            <div class="workflow-nav-actions">
                <a asp-controller="Main" asp-action="ClosedIssues"><i class="fa-solid fa-box-archive"></i><span>Resolved / Closed Issues</span></a>
                @if (User.IsInRole("HR") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Main" asp-action="LeaveStatus" class="leave-status-link"><i class="fa-solid fa-calendar-check"></i><span>See Leave Status</span></a>
                }
            </div>
        }
        else if (isClosedIssuesPage)
        {
            <div class="workflow-nav-actions">
                <a asp-controller="Main" asp-action="@(User.IsInRole("Manager") ? "ManagerQueries" : "WorkflowManagement")"><i class="fa-solid fa-list-check"></i><span>Active Issues</span></a>
            </div>
        }
        @if (string.Equals(controller, "Hr", StringComparison.OrdinalIgnoreCase) && string.Equals(action, "HrAddEmp", StringComparison.OrdinalIgnoreCase))
        {
            <div class="employee-extra-actions">
                <a asp-controller="Hr" asp-action="AddEmployeeBankDetails"><i class="fa-solid fa-building-columns"></i><span>Add Bank Details</span></a>
                <a asp-controller="Hr" asp-action="AddEmployeeSalaryDetails"><i class="fa-solid fa-indian-rupee-sign"></i><span>Add Salary Details</span></a>
            </div>
        }
    </nav>
}
