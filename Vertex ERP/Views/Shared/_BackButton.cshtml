@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var topLevelGuestPages = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Dashboard",
        "Employees",
        "Attendence",
        "LeaveManagement",
        "DepartmentManagement",
        "Hrms",
        "TaskMgm",
        "ProjectMgm",
        "AdminPanel",
        "UserSettings",
        "Reports",
        "Settings"
    };
    var showBackButton = !string.Equals(controller, "Guest", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(action)
        || !topLevelGuestPages.Contains(action);
}

@if (showBackButton)
{
    <nav class="common-back-nav" aria-label="Page navigation">
        <button type="button"
                class="common-back-button"
                onclick="window.history.back()"
                title="Go Back"
                aria-label="Go Back">
            <svg class="common-back-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>Back</span>
        </button>
    </nav>
}
