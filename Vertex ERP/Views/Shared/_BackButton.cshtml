@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var topLevelMainPages = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Dashboard",
        "EmployeeHome",
        "Employees",
        "Attendence",
        "LeaveManagement",
        "DepartmentManagement",
        "Hrms",
        "TaskMgm",
        "ProjectMgm",
        "AdminPanel",
        "UserSettings",
        "Reports",
        "Settings"
    };
    var showBackButton = !string.Equals(controller, "Main", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(action)
        || !topLevelMainPages.Contains(action);
    var isDepartmentPage = string.Equals(controller, "Hr", StringComparison.OrdinalIgnoreCase)
        && action is "Department" or "AddDepartment" or "EditDepartment" or "DeleteDepartment" or "DepartmentDetails";
    var isEmployeePage = string.Equals(controller, "Employee", StringComparison.OrdinalIgnoreCase);
    var isEmployeeIndex = isEmployeePage && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    var backController = isDepartmentPage
        ? (string.Equals(action, "Department", StringComparison.OrdinalIgnoreCase) ? "Main" : "Hr")
        : isEmployeeIndex ? "Main"
        : isEmployeePage ? "Employee"
        : ViewData["BackController"]?.ToString();
    var backAction = isDepartmentPage
        ? (string.Equals(action, "Department", StringComparison.OrdinalIgnoreCase) ? "Hrms" : "Department")
        : isEmployeeIndex ? "Hrms"
        : isEmployeePage ? "Index"
        : ViewData["BackAction"]?.ToString();
    var hasExplicitBackRoute = !string.IsNullOrWhiteSpace(backController) && !string.IsNullOrWhiteSpace(backAction);
}

@if (showBackButton)
{
    <nav class="common-back-nav" aria-label="Page navigation">
        @if (hasExplicitBackRoute)
        {
        <a
                class="common-back-button"
                asp-controller="@backController"
                asp-action="@backAction"
                title="Go Back"
                aria-label="Go Back">
            <svg class="common-back-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>Back</span>
        </a>
        }
        else
        {
        <button type="button"
                class="common-back-button"
                onclick="window.history.back()"
                title="Go Back"
                aria-label="Go Back">
            <svg class="common-back-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            <span>Back</span>
        </button>
        }
    </nav>
}
