<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vertex_ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common-back-button.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vertex_ERP.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
      
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_BackButton" />
            @RenderBody()
            <link rel="stylesheet" href="~/css/common-ui.css" asp-append-version="true" />
        </main>
    </div>

    <footer class="border-top footer text-muted">
       @*  <div class="container">
            &copy; 2026 - Vertex_ERP - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div> *@
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
