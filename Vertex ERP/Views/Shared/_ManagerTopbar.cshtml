@model VertexERP.Models.ManagerDashboardViewModel
@using VertexERP.Services
@{ var name = Model.Viewer?.FullName ?? User.Identity?.Name ?? "Manager"; }
<div class="md-global-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><label class="md-sr-only" for="manager-global-search">Search employee, project or task</label><input id="manager-global-search" type="search" placeholder="Search employee, project, task..." autocomplete="off" aria-controls="manager-search-results" aria-expanded="false"/><div id="manager-search-results" class="md-search-results" aria-label="Search results" hidden></div></div>
<div class="md-topbar-actions">
 <details class="md-notifications"><summary aria-label="Notifications"><i class="fa-regular fa-bell" aria-hidden="true"></i>@if(Model.NotificationCount>0){<span class="md-notification-count">@Model.NotificationCount</span>}</summary><div class="md-menu md-notification-menu"><strong>Notifications <small>@Model.NotificationCount pending</small></strong>@if(Model.Notifications.Count==0){<p>No pending notifications</p>}else{@foreach(var item in Model.Notifications.Take(8)){<a href="@item.Url"><b>@item.Title</b><small>@item.Detail</small></a>}}</div></details>
 <button class="md-fullscreen" type="button" aria-label="Toggle fullscreen" data-manager-fullscreen><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
 <details class="md-account"><summary><span class="md-avatar"><span>@ManagerDashboardPresentation.Initials(name)</span>@if(!string.IsNullOrWhiteSpace(Model.Viewer?.PhotoPath)){<img src="@Model.Viewer.PhotoPath" alt="" onerror="this.hidden=true"/>}</span><span class="md-account-copy"><small>Welcome</small><strong data-no-localize>@name</strong><small>@(User.IsInRole("Manager") ? "Manager" : User.IsInRole("HR") ? "HR" : "Admin")</small></span><i class="fa-solid fa-angle-down" aria-hidden="true"></i></summary><div class="md-menu">@if(!User.IsInRole("Admin")){<a href="/Main/EmployeeProfile">My Profile</a><a href="/Main/EmployeeAttendance">My Attendance</a><a href="/Main/FieldAttendance">Mark Attendance</a><a href="/Main/EmployeeLeaves">My Leave</a><a href="/Main/EmployeeQueries">My Queries</a><a href="/Main/EmployeeNotifications">My Notifications</a><a href="/Main/SalarySlips">Salary Slip</a><a href="/Main/EmployeeAssets">My Assets</a><a href="/Main/MyBankDetails">My Bank Details</a><a href="/Expense/Index?view=self">My Expenses</a><a href="/Main/OrderTracking">Shipment Tracking</a>}<a href="/Theme">Theme</a><a href="/Language">Language</a><a href="/Feedback">Feedback</a><form asp-controller="Main" asp-action="Logout" method="post"><button type="submit">Logout</button></form></div></details>
</div>
