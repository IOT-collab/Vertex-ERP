@model VertexERP.Models.EmployeeAttendanceViewModel
<div class="employee-summary"><article><small>Total Days</small><strong>@Model.Days.Count</strong></article><article><small>Present</small><strong>@Model.AttendedDays</strong><small>Includes late arrivals</small></article><article><small>Absent</small><strong>@Model.Absent</strong></article><article><small>Leave</small><strong>@Model.Leave</strong></article><article><small>Holiday</small><strong>@Model.Holidays</strong></article><article><small>Late</small><strong>@Model.Late</strong></article></div>
<div class="employee-panel attendance-history-panel"><table class="employee-table attendance-history"><thead><tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Working Time</th><th>Overtime</th><th>Punches</th><th>Source</th><th>Status</th><th>Site details</th></tr></thead><tbody>
@foreach(var day in Model.Days){
<tr><td data-label="Date">@day.Date.ToString("ddd, dd MMM yyyy")</td><td data-label="Check In">@(day.CheckIn?.ToString("hh:mm:ss tt")??"--")</td><td data-label="Check Out">@(day.CheckOut?.ToString("hh:mm:ss tt")??"--")</td><td data-label="Working Time">@(day.CheckOut.HasValue?VertexERP.Services.AttendanceRules.FormatHours(day.WorkingHours):"--")</td><td data-label="Overtime">@(day.CheckOut.HasValue?VertexERP.Services.AttendanceRules.FormatHours(day.Overtime):"--")</td><td data-label="Punches">@day.PunchCount</td><td data-label="Source">@day.Source</td><td data-label="Status"><span class="employee-badge @day.Status.ToLowerInvariant()">@day.Status</span>@if(day.Status=="Holiday"){<small>@VertexERP.Services.AttendanceRules.HolidayName(day.Date)</small>}</td><td data-no-localize data-label="Site details">@(string.IsNullOrEmpty(day.SiteDetails)?"--":day.SiteDetails)</td></tr>
}
@if(Model.Days.Count==0){<tr><td colspan="9" class="employee-empty">No attendance records match these filters.</td></tr>}
</tbody></table></div>
