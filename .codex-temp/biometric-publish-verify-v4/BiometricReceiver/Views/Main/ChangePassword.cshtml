@model VertexERP.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<section class="employee-section">
    <header><div><h1>Change Password</h1><p>Create a private password before continuing.</p></div></header>
    <form asp-action="ChangePassword" method="post" class="employee-panel profile-edit-form">
        <div asp-validation-summary="ModelOnly" class="absent"></div>
        <div class="profile-edit-grid">
            <label>Current Password<input asp-for="CurrentPassword" autocomplete="current-password"/><span asp-validation-for="CurrentPassword"></span></label>
            <label>New Password<input asp-for="NewPassword" autocomplete="new-password"/><span asp-validation-for="NewPassword"></span></label>
            <label>Confirm New Password<input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></label>
        </div>
        <p>Minimum 10 characters with uppercase, lowercase, number and special character.</p>
        <button type="submit" class="btn btn-primary">Change Password</button>
    </form>
</section>
