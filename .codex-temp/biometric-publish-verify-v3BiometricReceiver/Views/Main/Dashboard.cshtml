@*
    ASP.NET Core MVC ERP Master Dashboard View
*@

@model VertexERP.Models.DashboardViewModel
@{
    ViewData["Title"] = "ERP Master Dashboard";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/Dashboard.css" rel="stylesheet" asp-append-version="true" />

<div class="dashboard">

    <!-- =========================
         HEADER
    ========================== -->
    <header class="page-header">

        <div class="header-text">
            <span class="system-badge">Enterprise Resource Planning</span>

            <h2>Enterprise Overview</h2>

            <p>
                Welcome back.
                Here is your operational summary for today.
            </p>
        </div>

        <div class="header-actions">

            <!-- Search -->
            <div class="search-bar">
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>

                <input type="text" id="dashboardEmployeeSearch"
                       placeholder="Search employees..." />

                <span class="search-shortcut">⌘</span>
            </div>

            <!-- Current Date -->
            <div class="date-box">

                <span class="calendar-icon"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i></span>

                <div>
                    <strong>
                        @DateTime.Now.ToString("dddd")
                    </strong>

                    <span>
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                </div>

            </div>

            <!-- AI Voice -->
            <button class="btn-ai-mic"
                    id="aiHeaderMic"
                    type="button"
                    title="Ask Vertex AI by voice">

                <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                <span class="mic-dot"></span>

            </button>

            <!-- Notifications -->
            <button class="btn-icon-bell"
                    type="button"
                    title="Notifications">

                <i class="fa-solid fa-bell" aria-hidden="true"></i>
                <span class="dot"></span>

            </button>

            <!-- User Avatar -->
            <div class="user-avatar"
                 title="User">

                <i class="fa-solid fa-user" aria-hidden="true"></i>

            </div>

        </div>

    </header>


    <!-- =========================
         KPI CARDS
    ========================== -->

    <section class="card-row">

        <!-- Total Workforce -->
        <div class="dashboard-card status-blue">

            <div class="card-meta">

                <span>Total Workforce</span>

                <div class="card-icon blue-icon">
                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2>@Model.TotalWorkforce</h2>

                <span class="trend up">@Model.ActiveWorkforce active</span>

            </div>

            <div class="card-footer-info">Saved employee records</div>

        </div>


        <!-- Present Today -->
        <div class="dashboard-card status-green">

            <div class="card-meta">

                <span>Present Today</span>

                <div class="card-icon green-icon">
                    <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2>@Model.PresentToday</h2>

                <span class="trend neutral">Today</span>

            </div>

            <div class="card-footer-info">@Model.AbsentToday currently absent</div>

        </div>


        <!-- Pending Approvals -->
        <div class="dashboard-card status-orange">

            <div class="card-meta">

                <span>Open Tasks</span>

                <div class="card-icon orange-icon">
                    <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2>@Model.OpenTasks</h2>

                <span class="trend warning">@Model.OverdueTasks overdue</span>

            </div>

            <div class="card-footer-info">@Model.CompletedTasks completed</div>

        </div>


        <!-- Inventory Items -->
        <div class="dashboard-card status-purple">

            <div class="card-meta">

                <span>Departments</span>

                <div class="card-icon purple-icon">
                    <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
                </div>

            </div>

            <div class="card-body-metrics">

                <!-- Dynamic Value -->
                <h2>@Model.Departments.Count</h2>

                <span class="trend neutral">Active teams</span>

            </div>

            <div class="card-footer-info">Workforce distribution</div>

        </div>

    </section>


    <!-- =========================
         ANALYTICS
    ========================== -->

    <section class="analytics-row">


        <!-- Workforce Trend -->
        <div class="analytics-card analytics-wide">

            <div class="box-header">

                <div>

                    <h3><i class="fa-solid fa-chart-line section-icon" aria-hidden="true"></i> Workforce Trend</h3>

                    <p class="sub-text">
                        Attendance performance across the current week
                    </p>

                </div>

                <span class="badge-count">
                    Live Trend
                </span>

            </div>


            <div class="line-chart"
                 aria-label="Weekly attendance trend graph">

                <div class="dashboard-week-grid">
                    @foreach (var day in Model.WeeklyAttendance)
                    {
                        var height = Model.TotalWorkforce == 0 ? 4 : Math.Max(4, day.Count * 100 / Model.TotalWorkforce);
                        <div class="dashboard-week-item"><strong>@day.Count</strong><span style="height:@height%"></span><small>@day.Label</small></div>
                    }
                </div>

                <div class="chart-labels">

                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>

                </div>

            </div>

        </div>


        <!-- Department Load -->
        <div class="analytics-card task-health-link" role="link" tabindex="0" onclick="window.location.href='@Url.Action("TaskMgm", "Main")'" onkeydown="if(event.key==='Enter'||event.key===' '){window.location.href='@Url.Action("TaskMgm", "Main")'}">

            <div class="box-header">

                <div>

                    <h3><i class="fa-solid fa-chart-column section-icon" aria-hidden="true"></i> Department Load</h3>

                    <p class="sub-text">
                        Open activity by team
                    </p>

                </div>

            </div>


            <div class="bar-chart"
                 aria-label="Department workload bar chart">

                @foreach (var department in Model.Departments)
                {
                    var height = Model.TotalWorkforce == 0 ? 4 : Math.Max(4, department.Count * 100 / Model.TotalWorkforce);
                    <div class="bar-item" style="--bar-color:#3b82f6;--bar-height:@height%"><span class="bar-value">@department.Count</span><span class="bar-fill"></span><small title="@department.Name">@department.Name</small></div>
                }

            </div>

        </div>


        <!-- Approval Health -->
        <div class="analytics-card">

            <div class="box-header">

                <div>

                    <h3><i class="fa-solid fa-chart-pie section-icon" aria-hidden="true"></i> Task Health</h3>

                    <p class="sub-text">
                        Average progress across all tasks
                    </p>

                </div>

            </div>


            <div class="radial-chart">

                @{ var completion = Model.TaskProgressPercentage; }
                <div class="radial-ring" style="--progress:@completion">
                    <span>@completion%</span>
                </div>


                <div class="radial-details">

                    <div>

                        <strong>@Model.CompletedTasks</strong>

                        <span>
                            Closed
                        </span>

                    </div>


                    <div>

                        <strong>@Model.OpenTasks</strong>

                        <span>
                            Open
                        </span>

                    </div>


                    <div>

                        <strong>@Model.OverdueTasks</strong>

                        <span>
                            Overdue
                        </span>

                    </div>

                </div>

                <div class="task-health-open">Open Task Management <i class="fa-solid fa-arrow-right"></i></div>

            </div>

        </div>

    </section>


    <!-- =========================
         MAIN CONTENT
    ========================== -->

    <section class="content-row">


        <!-- =====================
             EMPLOYEE DIRECTORY
        ====================== -->

        <div class="table-card-wrapper">

            <div class="table-box">


                <div class="box-header">

                    <div>

                        <h3>
                            <i class="fa-solid fa-address-book section-icon" aria-hidden="true"></i> Recent Active Directory
                        </h3>

                        <p class="sub-text">
                            Real-time status of cross-departmental personnel
                        </p>

                    </div>


                    <div class="table-controls">

                        <select class="select-filter" id="dashboardDepartmentFilter">

                            <option value="">
                                All Departments
                            </option>
                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Name">@department.Name</option>
                            }

                        </select>


                        <span class="badge-count">@Model.RecentEmployees.Count records</span>

                    </div>

                </div>


                <div class="table-responsive-container">

                    <table class="modern-table">


                        <thead>

                            <tr>

                                <th>
                                    Employee ID
                                </th>

                                <th>
                                    Employee Details
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var employee in Model.RecentEmployees)
                            {
                                <tr class="dashboard-employee-row" data-search="@employee.EmployeeId.ToLower() @employee.FullName.ToLower() @employee.Email.ToLower()" data-department="@employee.Department">
                                    <td class="id-col">@employee.EmployeeId</td>
                                    <td><div class="user-meta"><span class="avatar-placeholder">@employee.FullName.Substring(0, 1).ToUpper()</span><div><strong>@employee.FullName</strong><small>@employee.Email</small></div></div></td>
                                    <td><span class="dept-tag">@employee.Department</span></td>
                                    <td>@employee.Designation</td>
                                    <td><span class="status @(employee.IsActive ? "status-active" : "status-absent")">@(employee.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><a asp-controller="Main" asp-action="Employees" asp-route-id="@employee.Id" class="btn-action">View</a></td>
                                </tr>
                            }

                        </tbody>


                    </table>

                </div>

            </div>

        </div>


        <!-- =====================
             ATTENDANCE SIDE PANEL
        ====================== -->

        <div class="side-panel">


            <!-- Attendance Split -->
            <div class="attendance-box">


                <div class="box-header">

                    <h3>
                        <i class="fa-solid fa-clock section-icon" aria-hidden="true"></i> Attendance Split
                    </h3>

                    <span class="sub-text">
                        Today
                    </span>

                </div>


                <!-- Attendance Progress -->
                <div class="progress-stacked">

                    @if (Model.TotalWorkforce > 0)
                    {
                        <span class="progress-bar bg-green" style="width:@(Model.PresentToday * 100 / Model.TotalWorkforce)%"></span>
                        <span class="progress-bar bg-blue" style="width:@(Model.LateToday * 100 / Model.TotalWorkforce)%"></span>
                        <span class="progress-bar bg-red" style="width:@(Model.AbsentToday * 100 / Model.TotalWorkforce)%"></span>
                    }

                </div>


                <div class="attendance-list">


                    <!-- Present -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator green"></span>

                            Present

                        </span>

                        <strong class="metric-val">@Model.PresentToday</strong>

                    </div>


                    <!-- Late -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator blue"></span>

                            Late Entry

                        </span>

                        <strong class="metric-val">@Model.LateToday</strong>

                    </div>


                    <!-- Leave -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator orange"></span>

                            On Leave

                        </span>

                        <strong class="metric-val">0</strong>

                    </div>


                    <!-- Absent -->
                    <div class="attendance-item">

                        <span class="label-group">

                            <span class="indicator red"></span>

                            Absent

                        </span>

                        <strong class="metric-val">@Model.AbsentToday</strong>

                    </div>


                </div>

            </div>


            <!-- =====================
                 PRIORITY ALERTS
            ====================== -->

            <div class="alerts-box">

                <h3>
                    <i class="fa-solid fa-triangle-exclamation section-icon" aria-hidden="true"></i> Priority Alerts
                </h3>


                <div class="alert-list">

                    @if (Model.OverdueTasks > 0) { <div class="alert-item"><strong>@Model.OverdueTasks overdue task(s)</strong><p class="sub-text">Require manager attention.</p></div> }
                    @if (Model.AbsentToday > 0) { <div class="alert-item"><strong>@Model.AbsentToday absent employee(s)</strong><p class="sub-text">No attendance recorded today.</p></div> }
                    @if (Model.OverdueTasks == 0 && Model.AbsentToday == 0) { <div class="alert-item"><strong>No priority alerts</strong><p class="sub-text">Everything looks on track.</p></div> }

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         BOTTOM MANAGEMENT
    ========================== -->

    <section class="bottom-row">


        <!-- =====================
             SYSTEM AUDIT LOG
        ====================== -->

        <div class="activity-box">


            <div class="box-header">

                <h3>
                    <i class="fa-solid fa-file-shield section-icon" aria-hidden="true"></i> System Audit & Logs
                </h3>

                <a href="#"
                   class="link-more">

                    View All Logs →

                </a>

            </div>


            <div class="timeline-container">

                @foreach (var item in Model.RecentActivity)
                {
                    <div class="alert-item"><strong>@item.Title</strong><p class="sub-text">@item.Detail · @item.OccurredAt.ToString("dd MMM, hh:mm tt")</p></div>
                }

            </div>

        </div>


        <!-- =====================
             QUICK OPERATIONS
        ====================== -->

        <div class="quick-box">

            <h3>
                <i class="fa-solid fa-bolt section-icon" aria-hidden="true"></i> Instant ERP Operations
            </h3>

            <p class="sub-text">
                Frequent enterprise shortcuts
            </p>


            <div class="action-flex">


                <button type="button"
                        class="btn-neo-primary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                    </span>

                    Create Employee

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-stopwatch" aria-hidden="true"></i>
                    </span>

                    Log Attendance

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                    </span>

                    Raise PO Request

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                    </span>

                    Rebuild Payroll

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                    </span>

                    Generate Report

                </button>


                <button type="button"
                        class="btn-neo-secondary">

                    <span class="btn-icon">
                        <i class="fa-solid fa-download" aria-hidden="true"></i>
                    </span>

                    Export Schema

                </button>


            </div>

        </div>

    </section>


    <!-- =========================
         VERTEX AI ASSISTANT
    ========================== -->

    <section class="ai-assistant"
             aria-label="Vertex AI Assistant">


        <button type="button"
                class="ai-toggle"
                id="aiToggle"
                title="Open Vertex AI Assistant">

            <span class="ai-pulse"></span>

            <strong>
                AI
            </strong>

        </button>


        <div class="ai-panel"
             id="aiPanel">


            <div class="ai-panel-header">

                <div>

                    <span class="system-badge">
                        Voice Assistant
                    </span>

                    <h3>
                        Vertex AI
                    </h3>

                    <p class="sub-text">
                        Ask for today's report, users,
                        attendance, or calendar status.
                    </p>

                </div>


                <button type="button"
                        class="ai-close"
                        id="aiClose"
                        title="Close assistant">

                    ×

                </button>

            </div>


            <div class="ai-messages"
                 id="aiMessages">

                <!-- AI responses appear here -->

            </div>


            <div class="ai-controls">


                <button type="button"
                        class="ai-mic"
                        id="aiMic"
                        title="Speak to assistant">

                    <i class="fa-solid fa-microphone" aria-hidden="true"></i>

                </button>


                <input type="text"
                       id="aiInput"
                       placeholder="Ask Vertex AI..." />


                <button type="button"
                        class="ai-send"
                        id="aiSend">

                    Send

                </button>


            </div>

        </div>

    </section>

</div>


<!-- =========================
     VERTEX AI SCRIPT
========================== -->

<script>

    (() => {

        const aiToggle =
            document.getElementById("aiToggle");

        const aiPanel =
            document.getElementById("aiPanel");

        const aiClose =
            document.getElementById("aiClose");

        const aiInput =
            document.getElementById("aiInput");

        const aiSend =
            document.getElementById("aiSend");

        const aiMic =
            document.getElementById("aiMic");

        const aiHeaderMic =
            document.getElementById("aiHeaderMic");

        const aiMessages =
            document.getElementById("aiMessages");


        const SpeechRecognition =
            window.SpeechRecognition ||
            window.webkitSpeechRecognition;


        const recognition =
            SpeechRecognition
                ? new SpeechRecognition()
                : null;


        if (recognition) {

            recognition.lang = "en-IN";

            recognition.interimResults = false;

            recognition.continuous = false;

        }


        let isListening = false;


        // =====================
        // STOP AUDIO
        // =====================

        const stopAssistantAudio = () => {

            if ("speechSynthesis" in window) {

                window.speechSynthesis.cancel();

            }


            if (recognition && isListening) {

                try {

                    recognition.abort();

                }
                catch {

                    recognition.stop();

                }

            }


            isListening = false;


            if (aiMic)
                aiMic.classList.remove("listening");

            if (aiHeaderMic)
                aiHeaderMic.classList.remove("listening");

        };


        // =====================
        // ADD MESSAGE
        // =====================

        const addMessage = (text, type) => {

            if (!aiMessages)
                return;


            const message =
                document.createElement("div");


            message.className =
                `ai-message ${type}`;


            message.textContent = text;


            aiMessages.appendChild(message);


            aiMessages.scrollTop =
                aiMessages.scrollHeight;

        };


        // =====================
        // SPEAK
        // =====================

        const speak = (text) => {

            if (!aiPanel ||
                !aiPanel.classList.contains("open") ||
                !("speechSynthesis" in window)) {

                return;

            }


            window.speechSynthesis.cancel();


            const utterance =
                new SpeechSynthesisUtterance(text);


            const voices =
                window.speechSynthesis.getVoices();


            utterance.voice =

                voices.find(
                    voice =>
                        voice.lang === "en-US"
                )

                ||

                voices.find(
                    voice =>
                        voice.lang === "en-GB"
                )

                ||

                voices.find(
                    voice =>
                        voice.lang?.startsWith("en")
                );


            utterance.lang =
                utterance.voice?.lang || "en-US";


            utterance.rate = 0.95;

            utterance.pitch = 1;


            window.speechSynthesis.speak(
                utterance
            );

        };


        // =====================
        // ASK ASSISTANT
        // =====================

        const askAssistant = async () => {

            if (!aiInput)
                return;


            const question =
                aiInput.value.trim();


            if (!question)
                return;


            addMessage(
                question,
                "user"
            );


            aiInput.value = "";


            try {

                const response =
                    await fetch(
                        "/Main/AskAssistant",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    message: question
                                })
                        }
                    );


                const data =
                    await response.json();


                addMessage(
                    data.reply,
                    "assistant"
                );


                if (
                    aiPanel &&
                    aiPanel.classList.contains("open")
                ) {

                    speak(data.reply);

                }

            }
            catch {

                const fallback =
                    "Assistant service is not responding right now.";


                addMessage(
                    fallback,
                    "assistant"
                );


                if (
                    aiPanel &&
                    aiPanel.classList.contains("open")
                ) {

                    speak(fallback);

                }

            }

        };


        // =====================
        // OPEN / CLOSE AI
        // =====================

        if (aiToggle) {

            aiToggle.addEventListener(
                "click",
                () => {

                    aiPanel?.classList.toggle("open");


                    if (
                        aiPanel &&
                        !aiPanel.classList.contains("open")
                    ) {

                        stopAssistantAudio();

                    }

                }
            );

        }


        if (aiClose) {

            aiClose.addEventListener(
                "click",
                () => {

                    aiPanel?.classList.remove("open");

                    stopAssistantAudio();

                }
            );

        }


        if (aiSend) {

            aiSend.addEventListener(
                "click",
                askAssistant
            );

        }


        if (aiInput) {

            aiInput.addEventListener(
                "keydown",
                event => {

                    if (event.key === "Enter") {

                        askAssistant();

                    }

                }
            );

        }


        // =====================
        // VOICE INPUT
        // =====================

        const startListening = () => {

            aiPanel?.classList.add("open");


            if (!recognition) {

                const message =
                    "Voice input is not supported in this browser. Please type your question.";


                addMessage(
                    message,
                    "assistant"
                );


                speak(message);

                return;

            }


            if (isListening)
                return;


            try {

                isListening = true;


                aiMic?.classList.add(
                    "listening"
                );


                aiHeaderMic?.classList.add(
                    "listening"
                );


                recognition.start();

            }
            catch {

                isListening = false;


                aiMic?.classList.remove(
                    "listening"
                );


                aiHeaderMic?.classList.remove(
                    "listening"
                );

            }

        };


        if (aiMic) {

            aiMic.addEventListener(
                "click",
                startListening
            );

        }


        if (aiHeaderMic) {

            aiHeaderMic.addEventListener(
                "click",
                startListening
            );

        }


        if (recognition) {


            recognition.onresult =
                event => {

                    const transcript =
                        event.results[0][0]
                            .transcript;


                    if (aiInput) {

                        aiInput.value =
                            transcript;

                    }


                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );


                    askAssistant();

                };


            recognition.onerror =
                () => {

                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );


                    const message =
                        "I could not hear the voice input. Please try again or type your question.";


                    addMessage(
                        message,
                        "assistant"
                    );


                    speak(message);

                };


            recognition.onend =
                () => {

                    isListening = false;


                    aiMic?.classList.remove(
                        "listening"
                    );


                    aiHeaderMic?.classList.remove(
                        "listening"
                    );

                };

        }

    })();

</script>
<script>
    (() => {
        const search = document.getElementById('dashboardEmployeeSearch');
        const department = document.getElementById('dashboardDepartmentFilter');
        const rows = [...document.querySelectorAll('.dashboard-employee-row')];
        const filterRows = () => {
            const term = (search?.value || '').trim().toLowerCase();
            const selected = department?.value || '';
            rows.forEach(row => row.hidden = !((!term || row.dataset.search.includes(term)) && (!selected || row.dataset.department === selected)));
        };
        search?.addEventListener('input', filterRows);
        department?.addEventListener('change', filterRows);
    })();
</script>
