@model VertexERP.Models.EmployeeTasksViewModel
@{ ViewData["Title"]="My Tasks"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>My Tasks</h1><p>Tasks assigned to @Model.Employee.FullName</p></div></header><div class="employee-summary"><article><small>Total Tasks</small><strong>@Model.Tasks.Count</strong></article><article><small>Upcoming 30 Days</small><strong>@Model.Upcoming30Days</strong></article><article><small>In Progress</small><strong>@Model.InProgress</strong></article><article><small>Completed</small><strong>@Model.Completed</strong></article></div><div class="employee-panel">@if(Model.Tasks.Count==0){<div class="employee-empty">No tasks assigned.</div>}else{<table class="employee-table"><thead><tr><th>Task</th><th>Assigned By</th><th>Priority</th><th>Due Date</th><th>Status</th></tr></thead><tbody>@foreach(var task in Model.Tasks){<tr><td><strong>@task.Title</strong><small>@task.Description</small></td><td>@task.Manager.FullName</td><td>@task.Priority</td><td>@task.DueDate.ToString("dd MMM yyyy")</td><td><span class="employee-badge @task.Status.ToLowerInvariant().Replace(" ","-")">@task.Status</span></td></tr>}</tbody></table>}</div></section>
