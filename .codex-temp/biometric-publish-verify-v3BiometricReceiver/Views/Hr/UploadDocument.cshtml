@model VertexERP.Models.EmployeeDocumentUploadViewModel
@{ ViewData["Title"]="Upload Employee Document"; Layout="_Layout"; }
<style>
.upload-page{--blue:#3b82f6;--panel:#111f36;--panel2:#0f1b30;--line:#2b3d5d;--text:#f1f5f9;--muted:#aab8cf;width:min(1080px,100%);margin:22px auto;padding:clamp(18px,3vw,32px);background:#0f1a2e!important;border:1px solid var(--line);border-radius:20px;color:var(--text)!important}.upload-page *{box-sizing:border-box}.upload-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px}.upload-head h1{margin:0 0 6px;color:#fff!important;font-size:clamp(26px,3vw,34px)}.upload-head p{margin:0;color:var(--muted)!important}.upload-back{color:#7db3ff!important;text-decoration:none;font-weight:700}.employee-search{padding:20px;background:var(--panel)!important;border:1px solid var(--line);border-radius:15px}.employee-search h2,.upload-form h2{margin:0 0 15px;color:#fff!important;font-size:18px}.search-box{position:relative}.search-box>i{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#60a5fa;pointer-events:none}.search-box input{width:100%;padding:13px 14px 13px 44px!important;border:1px solid #3a4f70!important;border-radius:10px;background:var(--panel2)!important;color:#fff!important}.employee-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-height:260px;overflow:auto;margin-top:12px}.employee-option{display:flex;align-items:center;gap:12px;padding:13px;border:1px solid var(--line);border-radius:11px;background:var(--panel2);cursor:pointer}.employee-option:hover,.employee-option.selected{border-color:var(--blue);background:#132b50}.employee-option input{position:absolute;opacity:0}.employee-avatar{width:42px;height:42px;display:grid;place-items:center;flex:0 0 auto;border-radius:50%;background:#1d4ed8;color:#fff}.employee-option strong,.employee-option small{display:block}.employee-option strong{color:#fff}.employee-option small{margin-top:3px;color:var(--muted)}.selected-employee{display:none;margin-top:15px;padding:13px;border-left:4px solid #22c55e;background:#12372f;color:#d1fae5}.selected-employee.show{display:block}.upload-form{margin-top:18px;padding:20px;background:var(--panel)!important;border:1px solid var(--line);border-radius:15px}.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.upload-grid .wide{grid-column:1/-1}.upload-form label{display:flex;flex-direction:column;gap:7px;color:#e8f0fb!important;font-size:13px;font-weight:700}.upload-form input,.upload-form select,.upload-form textarea{width:100%;padding:12px 13px!important;border:1px solid #3a4f70!important;border-radius:10px;background:var(--panel2)!important;color:#fff!important}.upload-form option{background:var(--panel2);color:#fff}.file-drop{padding:25px!important;border:2px dashed #4a6b99!important;text-align:center}.upload-hint{color:var(--muted)!important;font-size:12px}.upload-submit{margin-top:18px;padding:13px 20px;border:0;border-radius:10px;background:var(--blue);color:#fff;font-weight:800;cursor:pointer}.field-validation-error{color:#fda4af}.validation-summary-errors{padding:12px;background:#4c1d2b;color:#fecdd3;border-radius:10px}
@@media(max-width:700px){.upload-page{margin:10px auto}.upload-head{flex-direction:column-reverse}.employee-results,.upload-grid{grid-template-columns:1fr}.upload-grid .wide{grid-column:auto}.upload-submit{width:100%}}
</style>
<main class="upload-page"><header class="upload-head"><div><h1>Upload Employee Documents</h1><p>Search and confirm the employee first, then upload documents directly to that employee's secure record.</p></div><a asp-action="EmpDocuments" class="upload-back"><i class="fa-solid fa-arrow-left"></i> Documents</a></header>
<form asp-action="UploadDocument" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly"></div>
 <section class="employee-search"><h2><i class="fa-solid fa-user-check"></i> 1. Select employee</h2><div class="search-box"><i class="fa-solid fa-magnifying-glass"></i><input id="employeeSearch" type="search" placeholder="Search by employee name, ID, department or designation" autocomplete="off" /></div><div class="employee-results" id="employeeResults">@foreach(var employee in Model.Employees){var searchText=(employee.EmployeeCode+" "+employee.Name+" "+employee.Department+" "+employee.Designation).ToLowerInvariant();<label class="employee-option" data-search="@searchText"><input asp-for="EmployeeId" type="radio" value="@employee.Id"/><span class="employee-avatar">@employee.Name.FirstOrDefault()</span><span><strong>@employee.Name</strong><small>@employee.EmployeeCode · @employee.Designation · @employee.Department</small></span></label>}</div><span asp-validation-for="EmployeeId"></span><div id="selectedEmployee" class="selected-employee"></div></section>
 <section class="upload-form"><h2><i class="fa-solid fa-cloud-arrow-up"></i> 2. Document details</h2><div class="upload-grid"><label>Document type<select asp-for="DocumentType"><option value="">Choose type</option><option>Aadhaar Card</option><option>PAN Card</option><option>10th Certificate</option><option>12th Certificate</option><option>Graduation</option><option>Post Graduation</option><option>Employee Photo</option><option>Previous Company Documents</option><option>UAN Passbook</option><option>Other</option></select><span asp-validation-for="DocumentType"></span></label><label>Document title<input asp-for="DocumentName" placeholder="e.g. Aadhaar Card - Front and Back"/><span asp-validation-for="DocumentName"></span></label><label>Expiry date (optional)<input asp-for="ExpiryDate" type="date"/></label><label class="wide">Choose file<input asp-for="File" class="file-drop" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"/><span class="upload-hint">PDF, JPG, PNG, DOC or DOCX · Maximum 15 MB</span><span asp-validation-for="File"></span></label><label class="wide">Notes (optional)<textarea asp-for="Notes" rows="3" placeholder="Verification notes, document number reference, etc."></textarea></label></div><button type="submit" class="upload-submit"><i class="fa-solid fa-shield-halved"></i> Upload to Selected Employee</button></section>
</form></main>
<script>
(() => { const search=document.getElementById('employeeSearch'), options=[...document.querySelectorAll('.employee-option')], selected=document.getElementById('selectedEmployee'); search.addEventListener('input',()=>{const query=search.value.trim().toLowerCase();options.forEach(option=>option.hidden=!option.dataset.search.includes(query));});options.forEach(option=>option.addEventListener('change',()=>{options.forEach(item=>item.classList.remove('selected'));option.classList.add('selected');selected.textContent='Selected: '+option.querySelector('strong').textContent+' — '+option.querySelector('small').textContent;selected.classList.add('show');})); const checked=document.querySelector('.employee-option input:checked');if(checked)checked.closest('.employee-option').dispatchEvent(new Event('change')); })();
</script>
