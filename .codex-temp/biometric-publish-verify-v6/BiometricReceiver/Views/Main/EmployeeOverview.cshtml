@model VertexERP.Models.WorkforceOverviewViewModel
@{ ViewData["Title"]="Employee Overview"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/RoleEmployeeDashboard.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-portal"><header class="portal-title"><div><h1>Employee Overview</h1><p>Employee attendance and current work assignments</p></div></header><div class="workforce-stats"><div class="portal-card"><i class="fa-solid fa-users purple"></i><span><small>Total Employees</small><strong>@Model.Employees.Count</strong></span></div><div class="portal-card"><i class="fa-solid fa-user-check green"></i><span><small>Present Today</small><strong>@Model.Present</strong></span></div><div class="portal-card"><i class="fa-solid fa-user-xmark red"></i><span><small>Absent Today</small><strong>@Model.Absent</strong></span></div><div class="portal-card"><i class="fa-solid fa-list-check blue"></i><span><small>Active Work</small><strong>@Model.Tasks.Count(task=>!task.Status.Equals("Completed",StringComparison.OrdinalIgnoreCase))</strong></span></div></div><article class="portal-card workforce-table"><div class="portal-card-title"><h3>All Employee Details</h3></div><div class="portal-table-wrap"><table><thead><tr><th>Employee</th><th>ID</th><th>Department</th><th>Designation</th><th>Today's Status</th><th>Current Project / Work</th><th>Task Status</th></tr></thead><tbody>@foreach(var employee in Model.Employees){var currentTask=Model.Tasks.FirstOrDefault(task=>task.AssigneeId==employee.Id&&!task.Status.Equals("Completed",StringComparison.OrdinalIgnoreCase));<tr><td><div class="overview-person">@if(!string.IsNullOrWhiteSpace(employee.PhotoPath)){<img src="@employee.PhotoPath" alt="@employee.FullName"/>}else{<span><i class="fa-solid fa-user"></i></span>}<div><b>@employee.FullName</b><small>@employee.Email</small></div></div></td><td>@employee.EmployeeCode</td><td>@employee.Department</td><td>@employee.Designation</td><td><em class="@(Model.PresentEmployeeIds.Contains(employee.Id)?"present":"absent")">@(Model.PresentEmployeeIds.Contains(employee.Id)?"Present":"Absent")</em></td><td>@(currentTask?.Title ?? "No active work assigned")</td><td>@(currentTask?.Status ?? "--")</td></tr>}</tbody></table></div></article></section>
