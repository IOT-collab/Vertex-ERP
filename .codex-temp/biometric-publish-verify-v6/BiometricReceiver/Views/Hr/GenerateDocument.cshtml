@model VertexERP.Models.EmployeeDocumentFormViewModel
@using System.Text.Json
@{ ViewData["Title"]="Generate Employee Document"; Layout="_Layout"; var employeesJson=JsonSerializer.Serialize(Model.Employees); }
<style>
.doc-builder{--blue:#3b82f6;--ink:#f1f5f9;--muted:#aab8cf;--line:#2b3d5d;width:min(1060px,100%);margin:24px auto;padding:clamp(18px,3vw,34px);background:#0f1a2e!important;color:var(--ink)!important;border:1px solid var(--line);border-radius:20px}.doc-builder *{box-sizing:border-box}.builder-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:24px}.builder-head h1{margin:0 0 6px;color:#fff!important;font-size:clamp(25px,3vw,34px)}.builder-head p,.helper{margin:0;color:var(--muted)!important}.back-link{display:inline-flex;align-items:center;gap:7px;color:#9fc5ff!important;font-weight:700;text-decoration:none}.builder-form{padding:clamp(18px,3vw,30px);background:#111f36!important;border:1px solid var(--line);border-radius:16px}.form-section{margin-bottom:28px}.form-section h2{display:flex;gap:9px;align-items:center;margin:0 0 16px;color:#fff!important;font-size:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.wide{grid-column:1/-1}.builder-form label{display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:700;color:#e8f0fb!important}.builder-form input,.builder-form select,.builder-form textarea{width:100%;padding:12px 13px;border:1px solid #3a4f70!important;border-radius:10px;background:#0f1b30!important;color:#fff!important;font:inherit}.builder-form option{background:#0f1b30;color:#fff}.document-types{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.doc-type{position:relative}.doc-type input{position:absolute;opacity:0}.doc-type label{height:100%;min-height:116px;padding:18px;border:2px solid var(--line);border-radius:13px;cursor:pointer;background:#0f1b30!important}.doc-type i{font-size:23px;color:#60a5fa}.doc-type strong{display:block;margin-top:8px;color:#fff!important}.doc-type span{display:block;margin-top:5px;color:var(--muted)!important;font-size:12px;font-weight:400;line-height:1.4}.doc-type input:checked+label{border-color:var(--blue);background:#132b50!important;box-shadow:0 0 0 3px #3b82f620}.document-fields[hidden],.conditional-field[hidden]{display:none!important}.builder-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--line);padding-top:20px}.generate-button{border:0;border-radius:10px;padding:13px 20px;background:var(--blue);color:#fff;font-weight:800;cursor:pointer}.validation-summary-errors{margin-bottom:15px;padding:12px;border-radius:10px;background:#4c1d2b;color:#fecdd3}.field-error{color:#fda4af;font-size:12px}
@@media(max-width:720px){.doc-builder{margin:10px auto}.builder-head{flex-direction:column-reverse}.form-grid,.document-types{grid-template-columns:1fr}.wide{grid-column:auto}.builder-actions,.generate-button{width:100%}}
</style>
<main class="doc-builder"><header class="builder-head"><div><h1>Generate Employee Document</h1><p>Select the document type first, then complete only its required fields.</p></div><a asp-action="EmpDocuments" class="back-link"><i class="fa-solid fa-arrow-left"></i> Documents</a></header>
<form asp-action="GenerateDocument" method="post" class="builder-form"><div asp-validation-summary="ModelOnly"></div>
<section class="form-section"><h2><i class="fa-solid fa-file-signature"></i> 1. Document type</h2><div class="document-types">
<div class="doc-type"><input asp-for="DocumentType" type="radio" value="Offer Letter" id="offer"/><label for="offer"><i class="fa-solid fa-handshake"></i><strong>Offer Letter</strong><span>Three-page appointment letter with compensation and company terms.</span></label></div>
<div class="doc-type"><input asp-for="DocumentType" type="radio" value="Increment / Promotion Letter" id="increment"/><label for="increment"><i class="fa-solid fa-arrow-trend-up"></i><strong>Increment / Promotion</strong><span>New role and compensation revision details.</span></label></div>
<div class="doc-type"><input asp-for="DocumentType" type="radio" value="Relieving Letter" id="relieving"/><label for="relieving"><i class="fa-solid fa-person-walking-arrow-right"></i><strong>Relieving Letter</strong><span>Last working day, resignation and clearance confirmation.</span></label></div>
<div class="doc-type"><input asp-for="DocumentType" type="radio" value="Experience Letter" id="experience"/><label for="experience"><i class="fa-solid fa-award"></i><strong>Experience Letter</strong><span>Employment tenure, role and professional conduct confirmation.</span></label></div>
</div></section>
<section class="form-section"><h2><i class="fa-solid fa-user-tie"></i> 2. Employee details</h2><div class="form-grid"><label class="wide">Select employee<select asp-for="EmployeeId" id="employeeSelect" required><option value="">Choose employee</option>@foreach(var employee in Model.Employees){<option value="@employee.Id">@employee.EmployeeCode - @employee.Name</option>}</select><span asp-validation-for="EmployeeId" class="field-error"></span></label><label>Employee name<input asp-for="EmployeeName" id="employeeName"/><span asp-validation-for="EmployeeName" class="field-error"></span></label><label>Email address<input asp-for="Email" id="email"/><span asp-validation-for="Email" class="field-error"></span></label><label>Mobile number<input asp-for="Mobile" id="mobile" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)"/><span asp-validation-for="Mobile" class="field-error"></span></label><label>Designation<input asp-for="Designation" id="designation"/><span asp-validation-for="Designation" class="field-error"></span></label><label>Department<input asp-for="Department" id="department"/></label><label>Reporting manager<input asp-for="ManagerName" id="managerName"/><span asp-validation-for="ManagerName" class="field-error"></span></label><label class="conditional-field offer-only">PAN number<input asp-for="PanNumber" placeholder="ABCDE1234F"/><span asp-validation-for="PanNumber" class="field-error"></span></label><label class="conditional-field offer-only">Work location<input asp-for="WorkLocation" placeholder="Office / site location"/><span asp-validation-for="WorkLocation" class="field-error"></span></label></div></section>
<section class="form-section document-fields" data-types="Offer Letter"><h2><i class="fa-solid fa-briefcase"></i> 3. Offer and compensation details</h2><p class="helper">All salary heads from the payslip are included in the generated offer letter. Enter 0 where a component does not apply.</p><div class="form-grid"><label>Joining date<input asp-for="EffectiveDate" type="date"/></label><label>Probation period<input asp-for="ProbationPeriod" placeholder="e.g. 6 months"/></label><label>Annual CTC<input asp-for="AnnualCtc" placeholder="e.g. INR 6,00,000 per annum"/><span asp-validation-for="AnnualCtc" class="field-error"></span></label><label>Monthly gross salary<input asp-for="MonthlyGross" placeholder="e.g. INR 50,000"/></label><label>Bank name<input asp-for="BankName" placeholder="e.g. State Bank of India"/></label><label>Bank account number<input asp-for="BankAccountNumber" inputmode="numeric" maxlength="18" pattern="[0-9]{8,18}" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,18)" placeholder="8 to 18-digit account number"/></label><label>PF number<input asp-for="PfNumber" placeholder="Optional"/></label><label>PF UAN<input asp-for="PfUan" placeholder="Optional"/></label></div><h2 style="margin-top:25px"><i class="fa-solid fa-indian-rupee-sign"></i> Monthly salary structure</h2><div class="form-grid"><label>Basic salary<input asp-for="BasicSalary" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/><span asp-validation-for="BasicSalary" class="field-error"></span></label><label>HRA<input asp-for="HouseRentAllowance" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label>Conveyance allowance<input asp-for="ConveyanceAllowance" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label>Special allowance<input asp-for="SpecialAllowance" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label></div><h2 style="margin-top:25px"><i class="fa-solid fa-receipt"></i> Deductions</h2><div class="form-grid"><label>Provident fund (PF)<input asp-for="ProvidentFund" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label>Professional tax<input asp-for="ProfessionalTax" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label>TDS<input asp-for="Tds" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label>Other deductions<input asp-for="OtherDeductions" type="text" inputmode="decimal" data-salary-input placeholder="0.00"/></label><label class="wide">Total salary<input id="totalSalary" type="text" readonly value="INR 0.00"/><small class="helper">(Basic salary + HRA + conveyance allowance + special allowance) − (PF + professional tax + TDS + other deductions)</small></label><label class="wide">Offer-specific notes<textarea asp-for="AdditionalNotes" rows="3" placeholder="Optional joining instructions or special terms"></textarea></label></div></section>
<section class="form-section document-fields" data-types="Increment / Promotion Letter"><h2><i class="fa-solid fa-arrow-trend-up"></i> 3. Increment / promotion details</h2><div class="form-grid"><label>Effective date<input asp-for="EffectiveDate" type="date"/></label><label>Increment type<select asp-for="IncrementType"><option value="">Select type</option><option>Salary Increment</option><option>Promotion</option><option>Promotion with Salary Revision</option></select></label><label>New designation<input asp-for="NewDesignation" placeholder="New role / position"/></label><label>Current compensation<input asp-for="CurrentCompensation" placeholder="Current CTC or monthly salary"/></label><label>Revised compensation<input asp-for="RevisedCompensation" placeholder="Revised CTC or monthly salary"/><span asp-validation-for="RevisedCompensation" class="field-error"></span></label><label>Increment percentage<input asp-for="IncrementPercentage" placeholder="e.g. 15%"/></label><label class="wide">Reason / notes<textarea asp-for="PromotionReason" rows="3" placeholder="Performance, revised role responsibilities, etc."></textarea></label></div></section>
<section class="form-section document-fields" data-types="Relieving Letter"><h2><i class="fa-solid fa-right-from-bracket"></i> 3. Relieving details</h2><div class="form-grid"><label>Resignation date<input asp-for="ResignationDate" type="date"/></label><label>Last working date<input asp-for="EffectiveDate" type="date"/></label><label>Clearance status<select asp-for="ClearanceStatus"><option value="">Select clearance status</option><option>Completed</option><option>Pending clearance</option><option>Completed subject to final settlement</option></select><span asp-validation-for="ClearanceStatus" class="field-error"></span></label><label>Joining date<input asp-for="JoiningDate" class="joining-date" type="date"/></label><label class="wide">Handover / settlement notes<textarea asp-for="AdditionalNotes" rows="3" placeholder="Optional asset handover, settlement or clearance note"></textarea></label></div></section>
<section class="form-section document-fields" data-types="Experience Letter"><h2><i class="fa-solid fa-award"></i> 3. Experience details</h2><div class="form-grid"><label>Joining date<input asp-for="JoiningDate" class="joining-date" type="date"/></label><label>Experience through date<input asp-for="EffectiveDate" type="date"/></label><label class="wide">Additional notes<textarea asp-for="AdditionalNotes" rows="3" placeholder="Optional achievements or service note"></textarea></label></div></section>
<div class="builder-actions"><button type="submit" class="generate-button"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate PDF Document</button></div></form></main>
<script>(()=>{const employees=@Html.Raw(employeesJson),select=document.getElementById('employeeSelect'),fields={EmployeeName:'employeeName',Mobile:'mobile',Email:'email',Designation:'designation',Department:'department',ManagerName:'managerName'},types=[...document.querySelectorAll('input[name="DocumentType"]')],groups=[...document.querySelectorAll('.document-fields')],salaryInputs=[...document.querySelectorAll('[data-salary-input]')],totalSalary=document.getElementById('totalSalary');const setType=()=>{const selected=types.find(input=>input.checked)?.value||'Offer Letter';groups.forEach(group=>group.hidden=!group.dataset.types.split('|').includes(selected));document.querySelectorAll('.offer-only').forEach(field=>field.hidden=selected!=='Offer Letter')};const amount=id=>Number.parseFloat(document.getElementById(id)?.value)||0;const updateTotalSalary=()=>{const earnings=amount('BasicSalary')+amount('HouseRentAllowance')+amount('ConveyanceAllowance')+amount('SpecialAllowance');const deductions=amount('ProvidentFund')+amount('ProfessionalTax')+amount('Tds')+amount('OtherDeductions');if(totalSalary)totalSalary.value=`INR ${(earnings-deductions).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})}`};salaryInputs.forEach(input=>input.addEventListener('input',()=>{input.value=input.value.replace(/[^0-9.]/g,'').replace(/(\..*)\./g,'$1').replace(/(\.\d{2}).*/,'$1');updateTotalSalary()}));types.forEach(input=>input.addEventListener('change',setType));setType();updateTotalSalary();select.addEventListener('change',()=>{const employee=employees.find(item=>item.Id===Number(select.value));if(!employee)return;Object.entries(fields).forEach(([key,id])=>document.getElementById(id).value=employee[key]??'');document.querySelectorAll('.joining-date').forEach(field=>field.value=employee.JoiningDate??'')})})();</script>
