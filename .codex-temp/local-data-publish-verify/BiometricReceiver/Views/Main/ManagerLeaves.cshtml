@model VertexERP.Models.ManagerSectionViewModel
@{ ViewData["Title"]="Team Leave"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/ManagerSections.css" rel="stylesheet" asp-append-version="true" /><link href="~/css/WorkflowUi.css" rel="stylesheet" asp-append-version="true" />
<section class="manager-section"><header><h1>Team Leave</h1><p>Review and approve leave applications from your reporting employees</p></header>@if(TempData["WorkflowMessage"]!=null){<div class="workflow-alert">@TempData["WorkflowMessage"]</div>}<div class="section-stats"><div><i class="fa-solid fa-calendar-days"></i><span><small>Total Requests</small><b>@Model.LeaveRequests.Count</b></span></div><div><i class="fa-regular fa-clock orange"></i><span><small>Pending</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Pending")</b></span></div><div><i class="fa-regular fa-circle-check green"></i><span><small>Approved</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Approved")</b></span></div><div><i class="fa-regular fa-circle-xmark red"></i><span><small>Rejected</small><b>@Model.LeaveRequests.Count(x=>x.Status=="Rejected")</b></span></div></div><article class="section-card"><h3>Leave Requests</h3><div class="section-table"><table><thead><tr><th>Employee</th><th>Leave</th><th>Dates</th><th>Reason</th><th>Status / Action</th></tr></thead><tbody>@if(Model.LeaveRequests.Count==0){<tr><td colspan="5" class="no-data">No leave applications received.</td></tr>}else{@foreach(var item in Model.LeaveRequests){<tr><td><b>@item.Employee.FullName</b><small>@item.Employee.EmployeeCode</small></td><td>@item.LeaveType</td><td>@item.FromDate.ToString("dd MMM") - @item.ToDate.ToString("dd MMM yyyy")</td><td>@item.Reason</td><td>@if(item.Status=="Pending"){<form asp-action="DecideTeamLeave" method="post" class="inline-actions"><input type="hidden" name="id" value="@item.Id"/><button name="decision" value="Approved" class="workflow-btn primary">Approve</button><button name="decision" value="Rejected" class="workflow-btn danger">Reject</button></form>}else{<em class="@item.Status.ToLowerInvariant()">@item.Status</em>}</td></tr>}}</tbody></table></div></article></section>
