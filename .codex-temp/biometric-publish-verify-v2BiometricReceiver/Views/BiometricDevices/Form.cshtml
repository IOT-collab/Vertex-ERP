@model VertexERP.Models.BiometricDeviceFormViewModel
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Edit Biometric Device" : "Add Biometric Device"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/BiometricDevices.css" rel="stylesheet" asp-append-version="true" />
<div class="bio-page narrow"><div class="bio-header"><div><span class="bio-kicker">DEVICE MANAGEMENT</span><h1>@ViewData["Title"]</h1><p>Device network values are stored per device and are never hardcoded.</p></div><a asp-action="Index" class="bio-secondary">Back to devices</a></div>
<form asp-action="@(editing ? "Edit" : "Create")" method="post" class="bio-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="bio-validation"></div>
<div class="bio-form-grid"><label><span>Device Name *</span><input asp-for="Name" placeholder="Noida Office K40 Pro" /><em asp-validation-for="Name"></em></label><label><span>Serial Number *</span><input asp-for="SerialNumber" autocomplete="off" /><em asp-validation-for="SerialNumber"></em></label><label><span>Model *</span><input asp-for="Model" /><em asp-validation-for="Model"></em></label><label><span>Branch Code</span><input asp-for="BranchCode" placeholder="NOIDA-HO" /></label><label><span>Server Address</span><input asp-for="ServerAddress" placeholder="Domain or public IP" /></label><label><span>Server Port *</span><input asp-for="ServerPort" type="number" /></label><label><span>Communication Mode</span><select asp-for="CommunicationMode"><option value="ADMS">ADMS Push</option></select></label><label><span>Firmware Version</span><input asp-for="FirmwareVersion" placeholder="8.0.4.3" /></label><label class="bio-wide"><span>Notes</span><textarea asp-for="Notes" rows="3"></textarea></label><label class="bio-checkbox"><input asp-for="IsActive" /><span>Device is active and allowed to push attendance</span></label></div>
<div class="bio-form-actions"><a asp-action="Index" class="bio-secondary">Cancel</a><button class="bio-primary" type="submit">@(editing ? "Save Changes" : "Add Device")</button></div></form></div>
