@{
    ViewData["Title"] = "HR Reports & Analytics";
}
<link href="~/css/hrmreports.css" rel="stylesheet" />

<div class="rpt-container">
    <!-- Header Section -->
    <div class="rpt-header">
        <div class="rpt-header-main">
            <div>
                <h1 class="rpt-title">HR Analytics & Reports</h1>
                <p class="rpt-subtitle">Comprehensive reports for Employees, Managers, Attendance, and Expenses</p>
            </div>
        </div>

        <div class="rpt-header-actions">
            <button class="rpt-btn-primary" onclick="triggerDownloadModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                <span>Export Report</span>
            </button>
        </div>
    </div>

    <!-- Analytics Cards -->
    <div class="rpt-grid-stats">
        <div class="rpt-stat-card">
            <div class="rpt-stat-top">
                <div>
                    <span class="rpt-stat-label">Total Staff Reports</span>
                    <h3 class="rpt-stat-value" id="statTotalStaff">--</h3>
                </div>
                <div class="rpt-icon-box icon-blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                </div>
            </div>
            <span class="rpt-stat-sub text-emerald" id="statActiveDepts">-- Active Departments</span>
        </div>

        <div class="rpt-stat-card">
            <div class="rpt-stat-top">
                <div>
                    <span class="rpt-stat-label">Manager Level Reports</span>
                    <h3 class="rpt-stat-value" id="statTotalManagers">--</h3>
                </div>
                <div class="rpt-icon-box icon-purple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                </div>
            </div>
            <span class="rpt-stat-sub text-emerald">Team Coverage</span>
        </div>

        <div class="rpt-stat-card">
            <div class="rpt-stat-top">
                <div>
                    <span class="rpt-stat-label">Avg Attendance Rate</span>
                    <h3 class="rpt-stat-value" id="statAvgAttendance">--%</h3>
                </div>
                <div class="rpt-icon-box icon-green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                </div>
            </div>
            <span class="rpt-stat-sub text-emerald">Current Cycle</span>
        </div>

        <div class="rpt-stat-card">
            <div class="rpt-stat-top">
                <div>
                    <span class="rpt-stat-label">Pending Claims</span>
                    <h3 class="rpt-stat-value" id="statPendingClaims">--</h3>
                </div>
                <div class="rpt-icon-box icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                </div>
            </div>
            <span class="rpt-stat-sub text-amber">Requires Review</span>
        </div>
    </div>

    <!-- Quick Report Templates Grid -->
    <div class="rpt-templates-grid">
        <div class="rpt-tpl-card">
            <div class="rpt-tpl-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
            </div>
            <div class="rpt-tpl-info">
                <h4>Employee Master Report</h4>
                <p>Full staff details, designations, and join dates</p>
            </div>
            <button class="rpt-btn-download" onclick="downloadSingleReport('Employee Master Report')">Download</button>
        </div>

        <div class="rpt-tpl-card">
            <div class="rpt-tpl-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /></svg>
            </div>
            <div class="rpt-tpl-info">
                <h4>Manager Performance Report</h4>
                <p>Team size, approvals, and productivity KPIs</p>
            </div>
            <button class="rpt-btn-download" onclick="downloadSingleReport('Manager Performance Report')">Download</button>
        </div>

        <div class="rpt-tpl-card">
            <div class="rpt-tpl-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
            </div>
            <div class="rpt-tpl-info">
                <h4>Expense & Claim Audit</h4>
                <p>Hotel, travel, cab, and meal reimbursement summary</p>
            </div>
            <button class="rpt-btn-download" onclick="downloadSingleReport('Expense Audit Report')">Download</button>
        </div>
    </div>

    <!-- Main Content Panel -->
    <div class="rpt-main-panel">
        <div class="rpt-controls">
            <div class="rpt-search-box">
                <svg class="rpt-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="rptSearchInput" placeholder="Search by name, role or ID..." onkeyup="filterReportsTable()" />
            </div>

            <div class="rpt-filters">
                <select class="rpt-select" id="roleFilter" onchange="filterReportsTable()">
                    <option value="All">All Roles</option>
                    <option value="Manager">Managers Only</option>
                    <option value="Employee">Employees Only</option>
                </select>

                <select class="rpt-select" id="deptFilter" onchange="filterReportsTable()">
                    <option value="All">All Departments</option>
                    <!-- Dynamically populated or bound via backend model -->
                </select>
            </div>
        </div>

        <!-- Comprehensive Report Table -->
        <div class="rpt-table-responsive">
            <table class="rpt-table" id="reportsTable">
                <thead>
                    <tr>
                        <th>Personnel</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Attendance</th>
                        <th>Claims Total</th>
                        <th>Performance Score</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody id="reportsTableBody">
                    <!-- Dynamic content injected via backend or AJAX fetch -->
                    <tr class="rpt-empty-row">
                        <td colspan="7" style="text-align: center; color: #64748b; padding: 32px;">No data available</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Export Modal -->
<div class="rpt-modal-overlay" id="downloadModal">
    <div class="rpt-modal">
        <div class="rpt-modal-header">
            <h2>Export Custom HR Report</h2>
            <button class="rpt-modal-close" onclick="closeDownloadModal()" aria-label="Close modal">&times;</button>
        </div>
        <div class="rpt-modal-body">
            <div class="rpt-form-group">
                <label>Target Audience</label>
                <select class="rpt-input" id="exportTarget">
                    <option value="All">All Employees & Managers</option>
                    <option value="Managers">Managers Only</option>
                    <option value="Employees">Employees Only</option>
                </select>
            </div>

            <div class="rpt-form-row">
                <div class="rpt-form-group">
                    <label>From Date</label>
                    <input type="date" class="rpt-input" id="exportFromDate" />
                </div>
                <div class="rpt-form-group">
                    <label>To Date</label>
                    <input type="date" class="rpt-input" id="exportToDate" />
                </div>
            </div>

            <div class="rpt-form-group">
                <label>Export Format</label>
                <div class="rpt-format-options">
                    <label class="format-chip">
                        <input type="radio" name="format" value="pdf" checked />
                        <span>PDF Document</span>
                    </label>
                    <label class="format-chip">
                        <input type="radio" name="format" value="excel" />
                        <span>Excel (.xlsx)</span>
                    </label>
                    <label class="format-chip">
                        <input type="radio" name="format" value="csv" />
                        <span>CSV File</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="rpt-modal-footer">
            <button type="button" class="rpt-btn-secondary" onclick="closeDownloadModal()">Cancel</button>
            <button type="button" class="rpt-btn-primary" onclick="processDownload()">Download Report</button>
        </div>
    </div>
</div>

<script>
    function triggerDownloadModal() {
        document.getElementById("downloadModal").style.display = "flex";
    }

    function closeDownloadModal() {
        document.getElementById("downloadModal").style.display = "none";
    }

    function processDownload() {
        // Implement export trigger logic here
        closeDownloadModal();
    }

    function downloadSingleReport(title) {
        // Implement template download logic here
    }

    function downloadRowReport(name) {
        // Implement individual row report download logic here
    }

    function filterReportsTable() {
        const searchVal = document.getElementById("rptSearchInput").value.toUpperCase();
        const roleVal = document.getElementById("roleFilter").value.toUpperCase();
        const deptVal = document.getElementById("deptFilter").value.toUpperCase();

        const table = document.getElementById("reportsTable");
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            if (tr[i].classList.contains('rpt-empty-row')) continue;
            const rowText = tr[i].textContent || tr[i].innerText;
            const matchesSearch = rowText.toUpperCase().indexOf(searchVal) > -1;
            const matchesRole = roleVal === "ALL" || rowText.toUpperCase().indexOf(roleVal) > -1;
            const matchesDept = deptVal === "ALL" || rowText.toUpperCase().indexOf(deptVal) > -1;

            if (matchesSearch && matchesRole && matchesDept) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>
