@model VertexERP.Models.ManualAttendanceViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Mark Manual Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var employeesJson = JsonSerializer.Serialize(Model.Employees.Select(e => new { id = e.Id, name = e.FullName, code = e.EmployeeCode, department = e.Department }));
}
<link href="~/css/addattendence.css" rel="stylesheet" asp-append-version="true" />

<section class="manual-attendance-page">
    <header class="manual-hero">
        <div><span class="manual-kicker"><i class="fa-solid fa-user-check"></i> AUTHORIZED MANUAL ENTRY</span><h1>Mark Missing Attendance</h1><p>Use this form when an employee could not record a biometric punch.</p></div>
        <span class="access-chip"><i class="fa-solid @(Model.IsManagerView ? "fa-people-group" : "fa-building")"></i> @(Model.IsManagerView ? "Your Department Only" : "All Departments")</span>
    </header>

    <div class="manual-notice"><i class="fa-solid fa-circle-info"></i><div><strong>Approval control</strong><span>Managers can mark attendance only for employees in their own department. HR and Admin can mark attendance for all departments.</span></div></div>

    <form asp-action="AddAttendance" asp-controller="Main" method="post" class="manual-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="manual-step"><span>1</span><div><h2>Select Employee</h2><p>Choose the department first, then select an employee from that department.</p></div></div>
        <div class="manual-grid two">
            <label><span>Department <b>*</b></span><select asp-for="Department" id="Department" required><option value="">Select Department</option>@foreach(var department in Model.Departments){<option value="@department">@department</option>}</select><em asp-validation-for="Department"></em></label>
            <label><span>Employee <b>*</b></span><select asp-for="EmployeeId" id="EmployeeId" required disabled><option value="">Select Department First</option></select><em asp-validation-for="EmployeeId"></em></label>
        </div>

        <div class="manual-step"><span>2</span><div><h2>Attendance Timing</h2><p>Enter the attendance date and actual check-in/check-out time.</p></div></div>
        <div class="manual-grid three">
            <label><span>Attendance Date <b>*</b></span><input asp-for="AttendanceDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" required/><em asp-validation-for="AttendanceDate"></em></label>
            <label><span>Check-In Time <b>*</b> <small>(24-hour HH:MM)</small></span><input asp-for="CheckInTime" type="text" inputmode="numeric" maxlength="5" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="09:40" class="hhmm-input" required/><em asp-validation-for="CheckInTime"></em></label>
            <label><span>Check-Out Time <small>(24-hour HH:MM)</small></span><input asp-for="CheckOutTime" type="text" inputmode="numeric" maxlength="5" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="18:10" class="hhmm-input"/><em asp-validation-for="CheckOutTime"></em></label>
        </div>

        <div class="manual-step"><span>3</span><div><h2>Reason & Confirmation</h2><p>Add a clear reason for the missing biometric punch.</p></div></div>
        <label class="remarks-field"><span>Reason / Remarks</span><textarea asp-for="Remarks" rows="4" maxlength="300" placeholder="Example: Biometric device was offline during employee arrival..."></textarea></label>
        <div class="manual-confirm"><i class="fa-solid fa-shield-halved"></i><span>This entry will be recorded as an authorized manual attendance entry with the name of the logged-in HR, Admin, or Manager.</span></div>
        <div asp-validation-summary="All" class="submit-errors"></div>
        <footer><a asp-action="Attendence" class="manual-cancel">Cancel</a><button type="submit" id="submitAttendance"><i class="fa-solid fa-check"></i> Approve & Mark Attendance</button></footer>
    </form>
</section>

<script>
(() => {
    const employees = @Html.Raw(employeesJson);
    const department = document.getElementById('Department');
    const employee = document.getElementById('EmployeeId');
    const selectedEmployee = '@(Model.EmployeeId?.ToString() ?? "")';
    function refreshEmployees() {
        const value = department.value.toLowerCase();
        employee.innerHTML = '<option value="">Select Employee</option>';
        employees.filter(item => item.department.toLowerCase() === value).forEach(item => {
            const option = document.createElement('option'); option.value = item.id; option.textContent = `${item.code} - ${item.name}`;
            if (String(item.id) === selectedEmployee) option.selected = true; employee.appendChild(option);
        });
        employee.disabled = !department.value;
    }
    department.addEventListener('change', refreshEmployees); refreshEmployees();
    document.querySelectorAll('.hhmm-input').forEach(input => input.addEventListener('input', () => {
        const digits = input.value.replace(/\D/g, '').slice(0, 4);
        input.value = digits.length > 2 ? `${digits.slice(0, 2)}:${digits.slice(2)}` : digits;
    }));
    const form = document.querySelector('.manual-form');
    form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
            event.preventDefault(); form.reportValidity();
            const invalid = form.querySelector(':invalid');
            if (invalid) invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        const button = document.getElementById('submitAttendance');
        button.disabled = true;
        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving Attendance...';
    });
    const errorBox = document.querySelector('.submit-errors');
    if (errorBox && errorBox.textContent.trim()) errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
})();
</script>
