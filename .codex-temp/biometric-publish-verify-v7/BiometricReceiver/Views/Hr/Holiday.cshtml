@{
    ViewData["Title"] = "Holiday Calendar";
}
<link href="~/css/holiday.css" rel="stylesheet" />

<div class="hc-container">
    <!-- Top Header -->
    <div class="hc-header">
        <div class="hc-header-main">
            <div>
                <h1 class="hc-title">Holiday Calendar</h1>
                <p class="hc-subtitle">List of official company holidays and upcoming observational leaves</p>
            </div>
        </div>

        <div class="hc-header-actions">
            <select class="hc-select" id="holidayYearSelect" aria-label="Select Year" onchange="loadYearHolidays()">
                <option value="2026" selected>2026</option>
                <option value="2027">2027</option>
            </select>
            <button class="hc-btn-primary" onclick="openAddHolidayModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                <span>Add Holiday</span>
            </button>
        </div>
    </div>

    <!-- Stats Cards Grid -->
    <div class="hc-grid-stats">
        <div class="hc-card hc-card-featured">
            <div class="hc-card-body">
                <div>
                    <span class="hc-card-label">Next Holiday</span>
                    <h3 class="hc-card-title" id="nextHolidayTitle">--</h3>
                    <span class="hc-card-sub" id="nextHolidayDateContainer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
                        <span id="nextHolidayDate">Loading...</span>
                    </span>
                </div>
                <div class="hc-icon-badge icon-blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /><path d="M8 14h.01" /><path d="M12 14h.01" /><path d="M16 14h.01" /></svg>
                </div>
            </div>
            <div class="hc-card-footer text-emerald" id="nextHolidayCountdown">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                <span id="nextHolidayCountdownText">Calculated dynamically</span>
            </div>
        </div>

        <div class="hc-card">
            <div class="hc-card-body">
                <div>
                    <span class="hc-card-label">Total Holidays</span>
                    <h3 class="hc-card-title" id="statTotalHolidays">0 Days</h3>
                </div>
                <div class="hc-icon-badge icon-purple">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                </div>
            </div>
            <div class="hc-card-footer" id="statYearLabel">For Year 2026</div>
        </div>

        <div class="hc-card">
            <div class="hc-card-body">
                <div>
                    <span class="hc-card-label">Mandatory Holidays</span>
                    <h3 class="hc-card-title" id="statMandatoryHolidays">0 Days</h3>
                </div>
                <div class="hc-icon-badge icon-green">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </div>
            </div>
            <div class="hc-card-footer text-emerald">Fixed Company Offs</div>
        </div>

        <div class="hc-card">
            <div class="hc-card-body">
                <div>
                    <span class="hc-card-label">Restricted / Optional</span>
                    <h3 class="hc-card-title" id="statOptionalHolidays">0 Days</h3>
                </div>
                <div class="hc-icon-badge icon-amber">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                </div>
            </div>
            <div class="hc-card-footer text-amber">Optional Selection</div>
        </div>
    </div>

    <!-- Main Section -->
    <div class="hc-panel">
        <!-- Search & Filters -->
        <div class="hc-controls">
            <div class="hc-search-box">
                <svg class="hc-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="holidaySearchInput" placeholder="Search holiday or day..." onkeyup="filterHolidays()" aria-label="Search holidays" />
            </div>

            <select class="hc-select" id="holidayTypeSelect" onchange="filterHolidays()" aria-label="Filter by holiday type">
                <option value="All">All Types</option>
                <option value="Mandatory">Mandatory</option>
                <option value="Optional">Optional / Restricted</option>
            </select>
        </div>

        <!-- Table View -->
        <div class="hc-table-wrapper">
            <table class="hc-table" id="holidayTable">
                <thead>
                    <tr>
                        <th>Date & Day</th>
                        <th>Holiday Name</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody id="holidayTableBody">
                    <tr class="hc-empty-row">
                        <td colspan="5" style="text-align: center; color: #64748b; padding: 32px;">No holidays found for the selected configuration.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let holidayDataList = [];

    function initHolidayCalendar(serverData) {
        holidayDataList = serverData || [];
        renderHolidays(holidayDataList);
        updateDashboardStats(holidayDataList);
    }

    function renderHolidays(data) {
        const tbody = document.getElementById("holidayTableBody");
        tbody.innerHTML = "";

        if (!data || data.length === 0) {
            tbody.innerHTML = `<tr class="hc-empty-row"><td colspan="5" style="text-align: center; color: #64748b; padding: 32px;">No records available.</td></tr>`;
            return;
        }

        data.forEach(item => {
            const isNext = item.status === "Next Holiday";
            const rowClass = isNext ? "hc-table-row row-active" : "hc-table-row";
            const boxClass = isNext ? "hc-date-box active-box" : "hc-date-box";
            const dayTextClass = isNext ? "hc-day-text text-blue" : "hc-day-text";
            const pillClass = item.type.toLowerCase().includes("mand") ? "hc-pill pill-blue" : "hc-pill pill-amber";

            let statusColorClass = "status-blue";
            if (item.status === "Passed") statusColorClass = "status-gray";
            if (item.status === "Next Holiday") statusColorClass = "status-emerald";

            const tr = document.createElement("tr");
            tr.className = rowClass;
            tr.innerHTML = `
                <td>
                    <div class="hc-date-group">
                        <div class="${boxClass}">
                            <span class="hc-d-number">${item.dayNum}</span>
                            <span class="hc-d-month">${item.monthStr}</span>
                        </div>
                        <span class="${dayTextClass}">${item.weekDay}</span>
                    </div>
                </td>
                <td><span class="hc-name-text">${item.name}</span></td>
                <td><span class="${pillClass}">${item.type}</span></td>
                <td><span class="hc-status ${statusColorClass}">${item.status}</span></td>
                <td><span class="hc-desc-text">${item.description}</span></td>
            `;
            tbody.appendChild(tr);
        });
    }

    function updateDashboardStats(data) {
        const total = data.length;
        const mandatory = data.filter(d => d.type.toLowerCase().includes("mand")).length;
        const optional = total - mandatory;

        document.getElementById("statTotalHolidays").innerText = `${total} Days`;
        document.getElementById("statMandatoryHolidays").innerText = `${mandatory} Days`;
        document.getElementById("statOptionalHolidays").innerText = `${optional} Days`;

        const nextHoliday = data.find(d => d.status === "Next Holiday");
        if (nextHoliday) {
            document.getElementById("nextHolidayTitle").innerText = nextHoliday.name;
            document.getElementById("nextHolidayDate").innerText = `${nextHoliday.dayNum} ${nextHoliday.monthStr} 2026 (${nextHoliday.weekDay})`;
            document.getElementById("nextHolidayCountdownText").innerText = nextHoliday.countdownText || "Upcoming";
        }
    }

    function filterHolidays() {
        const searchValue = document.getElementById("holidaySearchInput").value.toUpperCase();
        const typeValue = document.getElementById("holidayTypeSelect").value.toUpperCase();
        const table = document.getElementById("holidayTable");
        const rows = table.getElementsByTagName("tr");

        for (let i = 1; i < rows.length; i++) {
            let rowText = rows[i].textContent || rows[i].innerText;
            let matchesSearch = rowText.toUpperCase().indexOf(searchValue) > -1;
            let matchesType = (typeValue === "ALL") || rowText.toUpperCase().indexOf(typeValue) > -1;

            if (matchesSearch && matchesType) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    }

    function loadYearHolidays() {
        const selectedYear = document.getElementById("holidayYearSelect").value;
        document.getElementById("statYearLabel").innerText = `For Year ${selectedYear}`;
    }

    function openAddHolidayModal() {
        // Modal trigger logic here
    }
</script>
