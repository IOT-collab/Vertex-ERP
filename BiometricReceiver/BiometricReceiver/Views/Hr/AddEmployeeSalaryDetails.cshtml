@model VertexERP.Models.EmployeeSalaryDraft
@{ ViewData["Title"] = "Add Salary Details"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/HrAddEmp.css" rel="stylesheet" asp-append-version="true" />
<div class="add-employee-page">
    <div class="page-header"><div class="header-content"><h2>Add Salary Details</h2><p>Configure earnings and deductions for the new employee.</p></div></div>
    <form class="employee-form" asp-action="AddEmployeeSalaryDetails" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="field-validation"></div>
        <div class="form-card"><div class="card-header"><h3>Salary Details</h3><p>These figures will be used in the employee's monthly salary slip.</p></div>
            <div class="form-grid">
                <div class="form-group"><label>Basic Salary</label><input asp-for="BasicSalary" type="text" inputmode="decimal" /></div><div class="form-group"><label>House Rent Allowance</label><input asp-for="HouseRentAllowance" type="text" inputmode="decimal" /></div><div class="form-group"><label>Conveyance Allowance</label><input asp-for="ConveyanceAllowance" type="text" inputmode="decimal" /></div>
                <div class="form-group"><label>Special Allowance</label><input asp-for="SpecialAllowance" type="text" inputmode="decimal" /></div><div class="form-group"><label>Provident Fund Deduction</label><input asp-for="ProvidentFund" type="text" inputmode="decimal" /></div><div class="form-group"><label>Professional Tax</label><input asp-for="ProfessionalTax" type="text" inputmode="decimal" /></div>
                <div class="form-group"><label>TDS</label><input asp-for="Tds" type="text" inputmode="decimal" /></div><div class="form-group"><label>Other Deductions</label><input asp-for="OtherDeductions" type="text" inputmode="decimal" /></div><div class="form-group"><label>PF Number</label><input asp-for="PfNumber" /></div><div class="form-group"><label>PF UAN</label><input asp-for="PfUan" /></div><div class="form-group"><label>Effective From</label><input asp-for="SalaryEffectiveFrom" type="date" /></div>
            </div>
        </div>
        <div class="form-actions"><a asp-action="HrAddEmp" class="btn-cancel">Cancel</a><button type="submit" class="btn-save">Save Salary Details</button></div>
    </form>
</div>
