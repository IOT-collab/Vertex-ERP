@model VertexERP.Models.LeaveRequest
@if (Model.FromDate < DateOnly.FromDateTime(VertexERP.Services.FieldAttendanceClock.IndiaTime(new DateTimeOffset(DateTime.SpecifyKind(Model.AppliedAtUtc, DateTimeKind.Utc)))))
{
    <small>Back-date leave</small>
}
@if (Model.ManagerDecision != null)
{
    <small>Manager: @Model.ManagerDecision Â· @Model.ManagerDecidedByName Â· @Model.ManagerDecidedAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small>
    @if (!string.IsNullOrWhiteSpace(Model.ManagerDecisionNote)) { <small>@Model.ManagerDecisionNote</small> }
}
@if (Model.DecidedAtUtc.HasValue)
{
    <small>@Model.ApprovalLevel: @Model.Status Â· @Model.DecidedAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small>
    @if (!string.IsNullOrWhiteSpace(Model.DecisionNote)) { <small>@Model.DecisionNote</small> }
}
