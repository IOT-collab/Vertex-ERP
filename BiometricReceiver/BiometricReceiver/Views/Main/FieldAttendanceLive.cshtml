@model VertexERP.Models.FieldAttendanceViewModel
@{
    ViewData["Title"] = "Mark Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    string LocationText(decimal? latitude, decimal? longitude, decimal? accuracy) =>
        latitude.HasValue && longitude.HasValue
            ? $"{latitude:F6}, {longitude:F6}" + (accuracy.HasValue ? $"  •  ±{accuracy:F0} m" : string.Empty)
            : "Location not recorded";
}
<style>
    .field-attendance{width:min(1120px,100%);margin:clamp(12px,3vw,34px) auto;padding:clamp(18px,3vw,34px);background:#111c31;border:1px solid #2b3d5d;border-radius:18px;color:#edf4ff;overflow:hidden}
    .field-attendance *{box-sizing:border-box}.field-heading{margin-bottom:22px}.field-heading h1{margin:0 0 7px;font-size:clamp(25px,3vw,34px)}.field-heading p{margin:0;color:#aebed8;line-height:1.55}
    .field-actions,.field-records{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}.field-actions{margin-bottom:16px}
    .field-button{min-height:68px;border:0;border-radius:12px;padding:16px;background:#2866dd;color:#fff;font:700 17px inherit;cursor:pointer;transition:transform .18s,filter .18s}.field-button:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-1px)}.field-button.out{background:#0f9f73}.field-button:disabled{opacity:.45;cursor:not-allowed}
    .field-record{min-width:0;padding:18px;background:#172641;border:1px solid #263b5e;border-radius:13px}.field-record-header{display:flex;align-items:center;gap:12px;margin-bottom:14px}.field-record-icon{width:42px;height:42px;display:grid;place-items:center;flex:0 0 auto;border-radius:10px;background:#dbeafe;color:#2563eb}.field-record.out .field-record-icon{background:#d1fae5;color:#059669}.field-record small{display:block;color:#aabbd5}.field-record time{display:block;margin-top:3px;font-size:20px;font-weight:800}.field-location{display:flex;align-items:flex-start;gap:9px;padding-top:12px;border-top:1px solid #304564;color:#c6d7f0;line-height:1.45}.field-location i{margin-top:3px;color:#69a8ff}.field-location span{min-width:0;overflow-wrap:anywhere}
    .field-ready{display:none;margin-top:18px;padding:16px;background:#172641;border-radius:12px}.field-ready.open{display:block}.field-ready p{margin:0 0 12px;color:#c6d7f0}.field-submit{min-height:46px;padding:11px 18px;font-size:15px}
    .field-selfie{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:20px;padding:16px;border:1px dashed #4b6b99;border-radius:12px}.field-selfie-button{min-height:46px;padding:10px 14px;font-size:14px}.field-selfie-note{color:#c6d7f0}.field-preview{display:none;width:100px;height:100px;object-fit:cover;border-radius:10px}
    .field-message{min-height:24px;margin:16px 0 0;color:#bcd2f2}.field-message.error{color:#ffaaa9}
    .field-camera{display:none;position:fixed;inset:0;z-index:9999;background:#020817e8;place-items:center;padding:16px}.field-camera.open{display:grid}.field-camera-box{width:min(500px,100%);max-height:calc(100vh - 32px);overflow:auto;padding:18px;background:#111c31;border:1px solid #2b3d5d;border-radius:15px}.field-camera video{width:100%;max-height:55vh;object-fit:cover;background:#000;border-radius:10px}.field-camera button{margin:12px 8px 0 0;padding:11px 14px;border:0;border-radius:8px;font-weight:700;cursor:pointer}.field-take{background:#2866dd;color:#fff}
    @@media(max-width:700px){.field-attendance{border-radius:14px}.field-actions,.field-records{grid-template-columns:1fr}.field-button{min-height:58px}.field-record time{font-size:18px}}
    @@media(max-width:420px){.field-attendance{margin:8px auto;padding:15px}.field-heading p{font-size:13px}.field-selfie{align-items:stretch}.field-selfie-button{width:100%}.field-preview{width:100%;height:auto;max-height:240px}}
</style>

<section class="field-attendance">
    <header class="field-heading"><h1>Field Attendance</h1><p>Site check-in and check-out save your current GPS location with the server time. Selfie is optional.</p></header>
    <div class="field-actions">
        <button id="in" type="button" class="field-button" @(Model.HasCheckedIn ? "disabled" : "")>Check In</button>
        <button id="out" type="button" class="field-button out" @(!Model.HasCheckedIn || Model.HasCheckedOut ? "disabled" : "")>Check Out</button>
    </div>
    <div class="field-records">
        <article class="field-record"><div class="field-record-header"><span class="field-record-icon"><i class="fa-solid fa-right-to-bracket"></i></span><div><small>Check In</small><time id="inTime">@(Model.CheckInTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</time></div></div><div class="field-location"><i class="fa-solid fa-location-dot"></i><span id="inLocation">@LocationText(Model.CheckInLatitude, Model.CheckInLongitude, Model.CheckInAccuracyMetres)</span></div></article>
        <article class="field-record out"><div class="field-record-header"><span class="field-record-icon"><i class="fa-solid fa-right-from-bracket"></i></span><div><small>Check Out</small><time id="outTime">@(Model.CheckOutTime?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not recorded")</time></div></div><div class="field-location"><i class="fa-solid fa-location-dot"></i><span id="outLocation">@LocationText(Model.CheckOutLatitude, Model.CheckOutLongitude, Model.CheckOutAccuracyMetres)</span></div></article>
    </div>
    <div id="ready" class="field-ready"><p id="readyText"></p><button id="submit" type="button" class="field-button field-submit">Submit</button></div>
    <div class="field-selfie"><button id="openCam" type="button" class="field-button field-selfie-button">Open Live Camera</button><span id="selfieNote" class="field-selfie-note">Optional selfie for the selected action.</span><img id="preview" class="field-preview" alt="Captured selfie"></div>
    <p id="msg" class="field-message" role="status" aria-live="polite"></p>
    @Html.AntiForgeryToken()
</section>
<div id="cam" class="field-camera" role="dialog" aria-modal="true" aria-label="Capture live selfie"><div class="field-camera-box"><h2>Capture live selfie</h2><video id="video" autoplay playsinline muted></video><canvas id="canvas" hidden></canvas><button id="take" type="button" class="field-take">Capture photo</button><button id="cancel" type="button">Cancel</button></div></div>

<script>
(() => {
    const msg = document.getElementById('msg'), cam = document.getElementById('cam'), video = document.getElementById('video'), canvas = document.getElementById('canvas'), preview = document.getElementById('preview'), ready = document.getElementById('ready'), submit = document.getElementById('submit');
    let stream, selfie = null, pendingAction = null, pendingLocation = null;
    const say = (text, error = false) => { msg.textContent = text; msg.className = error ? 'field-message error' : 'field-message'; };
    const actionButton = action => document.getElementById(action === 'Check In' ? 'in' : 'out');
    const stopCamera = () => { if (stream) stream.getTracks().forEach(track => track.stop()); stream = null; video.srcObject = null; cam.classList.remove('open'); };
    const clearPending = () => { pendingAction = null; pendingLocation = null; ready.classList.remove('open'); submit.disabled = false; };
    const getLocation = () => new Promise((resolve, reject) => {
        if (!navigator.geolocation) return reject(new Error('This device does not support location services.'));
        let best = null, finished = false, watchId = null, timer = null;
        const finish = (callback, value) => { if (finished) return; finished = true; if (watchId !== null) navigator.geolocation.clearWatch(watchId); if (timer !== null) clearTimeout(timer); callback(value); };
        watchId = navigator.geolocation.watchPosition(position => {
            if (!best || position.coords.accuracy < best.coords.accuracy) best = position;
            say(`GPS accuracy: ±${Math.round(position.coords.accuracy)} m. Waiting for precise location within 50 m...`);
            if (position.coords.accuracy <= 50) finish(resolve, position);
        }, error => finish(reject, new Error(error.code === 1 ? 'Location permission is blocked. Turn on GPS/precise location and allow browser access.' : 'Unable to get precise GPS location. Turn on GPS and try again.')), { enableHighAccuracy: true, timeout: 30000, maximumAge: 0 });
        timer = setTimeout(() => finish(reject, new Error(best ? `GPS accuracy is only ±${Math.round(best.coords.accuracy)} m. Attendance needs accuracy within 50 m. Move outdoors or near a window and retry.` : 'No GPS position received. Turn on GPS/precise location and retry.')), 32000);
    });
    async function selectAction(action) {
        clearPending(); selfie = null; preview.style.display = 'none'; document.getElementById('selfieNote').textContent = 'Optional selfie for the selected action.';
        const button = actionButton(action); button.disabled = true; say('Getting your current GPS location...');
        try {
            const position = await getLocation();
            pendingAction = action; pendingLocation = { latitude: position.coords.latitude, longitude: position.coords.longitude, accuracyMetres: position.coords.accuracy, capturedAtUtc: new Date(position.timestamp).toISOString() };
            document.getElementById('readyText').textContent = `Location captured (${position.coords.latitude.toFixed(6)}, ${position.coords.longitude.toFixed(6)} • ±${Math.round(position.coords.accuracy)} m). Submit ${action} to save it.`;
            submit.textContent = `Submit ${action}`; ready.classList.add('open'); say('GPS location captured. Review and submit your attendance.');
        } catch (error) { button.disabled = false; say(error.message, true); }
    }
    document.getElementById('openCam').onclick = async () => {
        if (!pendingAction) { say('First select Check In or Check Out so the selfie is attached to that action.', true); return; }
        try { stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false }); video.srcObject = stream; cam.classList.add('open'); } catch { say('Camera permission is required to capture a selfie.', true); }
    };
    document.getElementById('cancel').onclick = stopCamera;
    document.getElementById('take').onclick = () => {
        if (!video.videoWidth) { say('Camera is still starting. Please try again.', true); return; }
        canvas.width = video.videoWidth; canvas.height = video.videoHeight; canvas.getContext('2d').drawImage(video, 0, 0); selfie = canvas.toDataURL('image/jpeg', .85); preview.src = selfie; preview.style.display = 'block'; document.getElementById('selfieNote').textContent = 'Selfie captured and ready to submit.'; stopCamera(); say(`Selfie captured. Click ${submit.textContent} to finish.`);
    };
    submit.onclick = async () => {
        if (!pendingAction || !pendingLocation) { say('Select an attendance action and capture location first.', true); return; }
        if ((Date.now() - Date.parse(pendingLocation.capturedAtUtc)) > 120000) { clearPending(); say('GPS reading expired. Select the action again to capture a fresh precise location.', true); return; }
        submit.disabled = true; say('Saving attendance...');
        try {
            const response = await fetch('@Url.Action("SubmitFieldAttendance", "Main")', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: JSON.stringify({ action: pendingAction, ...pendingLocation, selfieDataUrl: selfie }) });
            const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.message || 'Could not save attendance.');
            const prefix = pendingAction === 'Check In' ? 'in' : 'out'; document.getElementById(`${prefix}Time`).textContent = data.time; document.getElementById(`${prefix}Location`).textContent = `${data.latitude}, ${data.longitude}  •  ±${data.accuracyMetres} m`;
            say(data.message); actionButton(pendingAction).disabled = true; if (pendingAction === 'Check In') document.getElementById('out').disabled = false; clearPending(); selfie = null; preview.style.display = 'none'; document.getElementById('selfieNote').textContent = 'Optional selfie for the selected action.';
        } catch (error) { submit.disabled = false; say(error.message, true); }
    };
    document.getElementById('in').onclick = () => selectAction('Check In'); document.getElementById('out').onclick = () => selectAction('Check Out'); window.addEventListener('beforeunload', stopCamera);
})();
</script>
