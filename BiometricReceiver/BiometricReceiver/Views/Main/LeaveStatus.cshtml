@model VertexERP.Models.LeaveStatusViewModel
@{
    ViewData["Title"] = "Leave Status History";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}
<link href="~/css/WorkflowIssues.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/LeaveStatus.css" rel="stylesheet" asp-append-version="true" />

<section class="issues-page leave-history-page">
    <header class="issues-hero"><div><span class="eyebrow"><i class="fa-solid fa-calendar-check"></i> LEAVE DECISION HISTORY</span><h1>Leave Status</h1><p>Complete details of pending, approved, rejected and cancelled leave requests across all departments.</p></div><span class="scope-chip"><i class="fa-solid fa-building"></i> HR & Admin · All Departments</span></header>
    <div class="issue-stats"><article><span>Total Requests</span><strong>@Model.Requests.Count</strong><i class="fa-solid fa-list-check"></i></article><article><span>Approved</span><strong>@Model.ApprovedCount</strong><i class="fa-solid fa-circle-check resolved-icon"></i></article><article><span>Rejected</span><strong>@Model.RejectedCount</strong><i class="fa-solid fa-circle-xmark rejected-icon"></i></article></div>
    <form method="get" class="issue-filters"><label><i class="fa-solid fa-magnifying-glass"></i><input name="search" value="@Model.Search" placeholder="Employee, code, leave type or reason..." /></label><select name="department"><option value="">All Departments</option>@foreach(var item in Model.Departments){<option value="@item" selected="@(item == Model.Department)">@item</option>}</select><select name="status"><option value="">All Statuses</option><option value="Pending" selected="@(Model.Status == "Pending")">Pending</option><option value="Approved" selected="@(Model.Status == "Approved")">Approved</option><option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option><option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option></select><button type="submit"><i class="fa-solid fa-filter"></i> Apply Filters</button></form>
    <div class="issue-list">
    @if(Model.Requests.Count == 0){<div class="issues-empty"><i class="fa-regular fa-calendar-xmark"></i><h3>No leave requests found</h3><p>All leave requests will automatically appear here.</p></div>}
    else{@foreach(var leave in Model.Requests){<article class="leave-history-card"><div class="ticket-top"><div><span class="ticket-number">Leave Request #@leave.Id · @leave.LeaveType</span><h2>@leave.Employee.FullName</h2><p class="employee-line">@leave.Employee.EmployeeCode · @leave.Employee.Designation · @leave.Employee.Department</p></div><span class="status-pill @leave.Status.ToLowerInvariant()"><i class="fa-solid @(leave.Status == "Approved" ? "fa-circle-check" : "fa-circle-xmark")"></i> @leave.DisplayStatus</span></div><div class="leave-detail-grid"><div><small>Leave Period</small><strong>@leave.FromDate.ToString("dd MMM yyyy") – @leave.ToDate.ToString("dd MMM yyyy")</strong><span>@(leave.LeaveType == "Short Leave" ? "Up to 2 hours" : (leave.IsHalfDay ? 0.5m : leave.ToDate.DayNumber - leave.FromDate.DayNumber + 1).ToString() + " day(s)")</span></div><div><small>Applied On</small><strong>@leave.AppliedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</strong><span>@leave.AppliedAtUtc.ToLocalTime().ToString("hh:mm tt")</span></div><div><small>Assigned Manager</small><strong>@(leave.AssignedApproverEmployee?.FullName ?? "HR / Admin")</strong><span>@leave.ApprovalLevel approval</span></div><div><small>Decision By</small><strong>@(leave.DecidedByUser?.FullName ?? "Not recorded")</strong><span>@(leave.DecidedAtUtc?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Date not recorded")</span></div></div><div class="leave-text-grid"><div><small>Reason Provided by Employee</small><p>@leave.Reason</p></div><div class="decision-note"><small>Final Decision Note</small><p>@(string.IsNullOrWhiteSpace(leave.DecisionNote) ? "No decision note provided." : leave.DecisionNote)</p></div></div><partial name="_LeaveDecisionDetails" model="leave" />@if(leave.Status == "Approved" && (!(leave.IsHalfDay || leave.IsExtraFacility) || User.IsInRole("HR"))){<form asp-action="CancelApprovedLeave" method="post"><input type="hidden" name="id" value="@leave.Id"/><label>Cancellation reason <input name="note" maxlength="500" required/></label><button type="submit">Cancel approved leave &amp; restore balance</button></form>}</article>}}
    </div>
</section>
