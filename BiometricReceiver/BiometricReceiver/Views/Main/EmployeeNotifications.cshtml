@model VertexERP.Models.EmployeeNotificationsViewModel
@{ ViewData["Title"]="Notifications"; ViewData["BackController"]="Main"; ViewData["BackAction"]="Employees"; Layout="~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/EmployeeActions.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section"><header><div><h1>Notifications</h1><p>Task assignments, leave and query updates for @Model.Employee.FullName</p></div></header><div class="employee-panel">@if(Model.Items.Count==0){<div class="employee-empty">No notifications available.</div>}else{<div class="notification-list">@foreach(var item in Model.Items){<article class="notification-item"><i class="fa-solid @(item.Type=="Task"?"fa-list-check":item.Type=="Query"?"fa-circle-question":"fa-plane-departure")"></i><div><strong>@item.Title</strong><small>@item.Detail</small></div><time>@item.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</time><form asp-action="DeleteNotification" method="post" onsubmit="return confirm('Delete this notification?');"><input type="hidden" name="type" value="@item.Type"/><input type="hidden" name="sourceId" value="@item.SourceId"/><button class="employee-delete icon-only" type="submit" title="Delete notification"><i class="fa-solid fa-trash"></i></button></form></article>}</div>}</div></section>
