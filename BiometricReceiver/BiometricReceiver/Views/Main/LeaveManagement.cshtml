@{
    ViewData["Title"] = "Leave Management";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<link href="~/css/LeaveMgm.css" rel="stylesheet" asp-append-version="true" />

<div class="leave-page">
    @if (TempData["LeaveMessage"] != null) { <div class="alert alert-success">@TempData["LeaveMessage"]</div> }
    @if (TempData["LeaveError"] != null) { <div class="alert alert-danger">@TempData["LeaveError"]</div> }

    <!-- ================= HEADER ================= -->
    <div class="page-header">

        <div class="header-left">

            <div class="header-content">
                <h2>Leave Management</h2>
                <p>Manage employee leave requests, balances and holidays.</p>
            </div>

        </div>

        <button type="button" class="btn-primary">
            <span class="plus-icon">+</span>
            Apply Leave
        </button>

    </div>


    <!-- ================= STATISTICS ================= -->
    <!-- Values will come from Controller / Database -->

    <div class="stats-grid">

        <div class="stat-card">
            <span class="stat-label">Total Leaves</span>
            <h3>--</h3>
        </div>

        <div class="stat-card">
            <span class="stat-label">Pending Requests</span>
            <h3>--</h3>
        </div>

        <div class="stat-card">
            <span class="stat-label">Approved</span>
            <h3>--</h3>
        </div>

        <div class="stat-card">
            <span class="stat-label">Rejected</span>
            <h3>--</h3>
        </div>

    </div>


    <!-- ================= APPLY LEAVE ================= -->

    <form class="card" asp-controller="Main" asp-action="ApplyLeave" method="post">

        <div class="card-title">
            <h3>Apply Leave</h3>
        </div>

        <div class="form-grid">

            <div class="form-group">
                <label>Leave Type</label>

                <select name="leaveType" required>
                    <option value="">Select Leave Type</option>
                    <option value="Casual Leave">Casual Leave</option>
                    <option value="Sick Leave">Sick Leave</option>
                    <option value="Earned Leave">Earned Leave</option>
                    <option value="Unpaid Leave">Unpaid Leave</option>
                </select>
            </div>


            <div class="form-group">
                <label>From Date</label>
                <input type="date" name="fromDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>


            <div class="form-group">
                <label>To Date</label>
                <input type="date" name="toDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>


            <div class="form-group">
                <label>Total Days</label>

                <input type="number"
                       placeholder="Total Days"
                       readonly />
            </div>

        </div>


        <div class="form-group full-width">

            <label>Reason</label>

            <textarea rows="4" name="reason" required
                      placeholder="Enter reason for leave"></textarea>

        </div>


        <div class="form-actions">

            <button type="submit" class="btn-primary">
                Submit Leave
            </button>

        </div>

    </form>


    <!-- ================= LEAVE REQUESTS ================= -->

    <div class="card">

        <div class="table-header">

            <div>
                <h3>Leave Requests</h3>
            </div>

            <div class="search-box">

                <span class="search-icon">⌕</span>

                <input type="text"
                       placeholder="Search employee..." />

            </div>

        </div>


        <div class="table-responsive">

            <table>

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <!-- Leave request data will come from database -->
                </tbody>

            </table>

        </div>

        <!-- Empty State -->
        <div class="empty-state">
            No leave requests available.
        </div>

    </div>


    <!-- ================= BOTTOM SECTION ================= -->

    <div class="bottom-grid">


        <!-- Leave Balance -->

        <div class="card bottom-card">

            <div class="card-title">
                <h3>Leave Balance</h3>
            </div>

            <div class="empty-state small-empty">
                Leave balance data not available.
            </div>

        </div>


        <!-- Holiday Calendar -->

        <div class="card bottom-card">

            <div class="card-title">
                <h3>Holiday Calendar</h3>
            </div>

            <div class="empty-state small-empty">
                No holidays available.
            </div>

        </div>

    </div>

</div>
