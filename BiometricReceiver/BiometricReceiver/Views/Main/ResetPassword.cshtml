@model VertexERP.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Reset Password - Vertex ERP</title><link href="~/css/Login.css" rel="stylesheet" asp-append-version="true"/></head>
<body><main class="login-shell"><section class="login-card"><div class="login-heading"><span class="eyebrow">Password Recovery</span><h1>Create new password</h1><p>Choose a strong password with at least 10 characters.</p></div><form asp-action="ResetPassword" method="post" class="login-form"><input asp-for="Email" type="hidden"/><div asp-validation-summary="ModelOnly" class="login-alert"></div><div class="form-group"><label asp-for="NewPassword"></label><div class="input-shell"><span class="input-icon">***</span><input asp-for="NewPassword" autocomplete="new-password"/></div><span asp-validation-for="NewPassword"></span></div><div class="form-group"><label asp-for="ConfirmPassword"></label><div class="input-shell"><span class="input-icon">***</span><input asp-for="ConfirmPassword" autocomplete="new-password"/></div><span asp-validation-for="ConfirmPassword"></span></div><button type="submit" class="login-button">Reset password <span aria-hidden="true">-&gt;</span></button></form></section></main></body></html>
