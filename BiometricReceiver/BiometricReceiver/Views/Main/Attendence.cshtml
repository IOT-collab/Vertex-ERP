@model VertexERP.Models.AttendancePageViewModel
@{
    ViewData["Title"] = "Attendance";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
    var filterDateValue = Model.FilterDate.ToString("yyyy-MM-dd");
}
<link href="~/css/Attendence.css" rel="stylesheet" asp-append-version="true" />
<div class="attendance-panel-container">
    <div class="page-header">
        <div class="header-left"><div class="header-text"><h2>Attendance Management</h2><p>Track biometric checkpoints, daily attendance, late arrivals, and working hours.</p></div></div>
        <div class="header-actions">
            <button type="button" class="btn-add btn-export" onclick="openAttendanceExport()"><i class="fa-solid fa-file-excel"></i> Download Excel</button>
            <a asp-controller="Main" asp-action="AddAttendance" class="btn-add">+ Mark Attendance</a>
        </div>
    </div>
    <div class="dashboard-cards">
        <a asp-action="Attendence" asp-route-searchQuery="@Model.SearchQuery" asp-route-department="@Model.Department" asp-route-filterDate="@filterDateValue" asp-route-status="Present" class="card present @(Model.Status == "Present" ? "active-filter" : "")"><h3>@Model.PresentCount</h3><span>Present</span><small>Click to filter</small></a>
        <a asp-action="Attendence" asp-route-searchQuery="@Model.SearchQuery" asp-route-department="@Model.Department" asp-route-filterDate="@filterDateValue" asp-route-status="Absent" class="card absent @(Model.Status == "Absent" ? "active-filter" : "")"><h3>@Model.AbsentCount</h3><span>Absent</span><small>Click to filter</small></a>
        <div class="card leave"><h3>@Model.LeaveCount</h3><span>On Leave</span></div>
        <a asp-action="Attendence" asp-route-searchQuery="@Model.SearchQuery" asp-route-department="@Model.Department" asp-route-filterDate="@filterDateValue" asp-route-status="Late" class="card late @(Model.Status == "Late" ? "active-filter" : "")"><h3>@Model.LateCount</h3><span>Late Arrivals</span><small>Click to filter</small></a>
    </div>
    <form asp-action="Attendence" asp-controller="Main" method="get">
        <div class="filter-box">
            <div class="filter-field"><input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Search Employee..."></div>
            <div class="filter-field"><select name="department"><option value="">All Departments</option>@foreach (var item in Model.Departments){<option value="@item" selected="@(item == Model.Department)">@item</option>}</select></div>
            <div class="filter-field"><input type="date" name="filterDate" value="@filterDateValue"></div>
            <div class="filter-field"><select name="status"><option value="">All Statuses</option><option value="Present" selected="@(Model.Status == "Present")">Present</option><option value="Late" selected="@(Model.Status == "Late")">Late</option><option value="Absent" selected="@(Model.Status == "Absent")">Absent</option><option value="Unmapped" selected="@(Model.Status == "Unmapped")">Unmapped</option></select></div>
            <div class="filter-field action-field"><button type="submit" class="btn-search">Apply Filter</button></div>
        </div>
    </form>
    <div class="table-box">
        <table>
            <thead><tr><th>Emp ID</th><th>Employee Name</th><th>Department</th><th>Date</th><th>Check In</th><th>Check Out</th><th>Late Days</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @if (Model.Records.Count > 0)
            {
                @foreach (var item in Model.Records)
                {
                    <tr><td>@item.EmpId</td><td>@item.EmployeeName</td><td>@item.Department</td><td>@item.Date.ToString("yyyy-MM-dd")</td><td>@(item.CheckIn?.ToString("hh:mm tt") ?? "—")</td><td>@(item.CheckOut?.ToString("hh:mm tt") ?? "—")</td><td><span class="txt-late">@(item.Status == "Late" ? 1 : 0)</span></td><td><span class="status @(item.Status.ToLowerInvariant())-status">@item.Status</span></td><td><span title="Working hours: @item.WorkingHours.ToString(@"hh\:mm")">@item.PunchCount punches</span></td></tr>
                }
            }
            else
            {
                <tr><td colspan="9" style="text-align:center;color:#64748b;padding:24px;">No attendance records found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="attendance-export-modal" id="attendanceExportModal" role="dialog" aria-modal="true" aria-labelledby="attendanceExportTitle">
 <div class="attendance-export-card"><header><div><h3 id="attendanceExportTitle">Download Attendance</h3><p>Choose a particular day or complete month.</p></div><button type="button" onclick="closeAttendanceExport()" aria-label="Close">&times;</button></header>
 <form asp-controller="Main" asp-action="ExportAttendance" method="get">
  <input type="hidden" name="searchQuery" value="@Model.SearchQuery"/><input type="hidden" name="department" value="@Model.Department"/><input type="hidden" name="status" value="@Model.Status"/>
  <div class="export-period-options"><label><input type="radio" name="exportPeriod" value="day" checked onchange="setExportPeriod('day')"/><span><i class="fa-regular fa-calendar-day"></i><b>Particular Day</b><small>One selected date</small></span></label><label><input type="radio" name="exportPeriod" value="month" onchange="setExportPeriod('month')"/><span><i class="fa-regular fa-calendar-days"></i><b>Complete Month</b><small>Day-wise monthly report</small></span></label></div>
  <label class="export-date-field" id="exportDayField"><span>Select date</span><input type="date" name="filterDate" value="@filterDateValue" max="@DateTime.Today.ToString("yyyy-MM-dd")"/></label>
  <label class="export-date-field hidden" id="exportMonthField"><span>Select month</span><input type="month" name="exportMonth" value="@Model.FilterDate.ToString("yyyy-MM")" max="@DateTime.Today.ToString("yyyy-MM")" disabled/></label>
  <div class="export-note"><i class="fa-solid fa-circle-info"></i><span>Complete Month report includes every active employee for every date, grouped employee-wise. Day export follows the current filters.</span></div>
  <footer><button type="button" class="export-cancel" onclick="closeAttendanceExport()">Cancel</button><button type="submit" class="export-download"><i class="fa-solid fa-download"></i> Download</button></footer>
 </form></div>
</div>
<script>
 const attendanceExportModal=document.getElementById('attendanceExportModal');
 function openAttendanceExport(){attendanceExportModal.classList.add('open');}
 function closeAttendanceExport(){attendanceExportModal.classList.remove('open');}
 function setExportPeriod(period){const monthly=period==='month';document.getElementById('exportDayField').classList.toggle('hidden',monthly);document.getElementById('exportMonthField').classList.toggle('hidden',!monthly);document.querySelector('#exportDayField input').disabled=monthly;document.querySelector('#exportMonthField input').disabled=!monthly;}
 attendanceExportModal.addEventListener('click',event=>{if(event.target===attendanceExportModal)closeAttendanceExport();});document.addEventListener('keydown',event=>{if(event.key==='Escape')closeAttendanceExport();});
</script>
