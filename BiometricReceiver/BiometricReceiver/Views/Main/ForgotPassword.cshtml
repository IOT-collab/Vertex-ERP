@model VertexERP.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Forgot Password - Vertex ERP</title><link href="~/css/Login.css" rel="stylesheet" asp-append-version="true"/></head>
<body><main class="login-shell"><section class="login-card"><div class="login-heading"><span class="eyebrow">Password Recovery</span><h1>Forgot password?</h1><p>Enter the same email address that HR used when registering your employee profile.</p></div><form asp-action="ForgotPassword" method="post" class="login-form"><div asp-validation-summary="ModelOnly" class="login-alert"></div><div class="form-group"><label asp-for="Email"></label><div class="input-shell"><span class="input-icon">&#64;</span><input asp-for="Email" autocomplete="email" placeholder="name&#64;company.com"/></div><span asp-validation-for="Email"></span></div><button type="submit" class="login-button">Send OTP <span aria-hidden="true">-&gt;</span></button></form><p class="login-footnote"><a asp-action="Login">Back to login</a></p></section></main></body></html>
