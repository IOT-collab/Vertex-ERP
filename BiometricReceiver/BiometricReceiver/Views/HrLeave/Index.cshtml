@model VertexERP.Models.HrLeavePage
@{ Layout="~/Views/Shared/_LayoutMaster.cshtml"; ViewData["Title"]="Apply Leave on Behalf"; }
<link href="~/css/FeedbackDocuments.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/hr-leave.css" rel="stylesheet" asp-append-version="true" />
<section class="fd-workspace hl-workspace">
<header class="fd-hero"><div><span class="fd-eyebrow">HR LEAVE DESK</span><h1>Apply Leave on Behalf</h1><p>@(Model.CanSubmit?"Record an employee's informed absence and send it to their reporting manager.":"View leave applications submitted by HR. Admin access is view only.")</p></div><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i></header>
<nav class="fd-tabs" aria-label="Leave pages"><a asp-controller="Main" asp-action="WorkflowManagement"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Leave Approvals &amp; Queries</a><a asp-controller="Main" asp-action="LeaveStatus"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> All Leave Status</a></nav>
@if(TempData["HrLeaveMessage"] is string message){<p class="fd-notice success" role="status">@message</p>}
<div class="hl-flow"><span><b>1</b> HR applies</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span><b>2</b> Manager reviews</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i><span><b>3</b> HR final decision</span><span class="hl-read-only">Admin: view only</span></div>
@if(Model.CanSubmit){
<section class="fd-panel hl-form-panel"><div><h2>Employee leave details</h2><p class="fd-muted">Use this when the employee has informed HR but could not apply. Past dates are allowed. Regular leave balance is deducted only after final approval; pending requests reserve availability.</p></div>
<form asp-controller="HrLeave" asp-action="Apply" method="post" id="hr-leave-form">
<div asp-validation-summary="All" class="hl-errors" role="alert"></div>
<div class="hl-form-grid"><label>Employee<select asp-for="Input.EmployeeId" name="EmployeeId" id="hl-employee" required><option value="">Select active employee</option>@foreach(var employee in Model.Employees){<option value="@employee.Id" selected="@(employee.Id==Model.Input.EmployeeId)" data-manager="@(employee.ManagerName??"Not assigned")">@employee.Name · @employee.Code · @employee.Department</option>}</select></label><label>Leave type<select name="LeaveType" id="hl-type">@foreach(var type in new[]{"EL","CL","ML","EW","Half Day","Short Leave"}){<option value="@type" selected="@(type==Model.Input.LeaveType)">@type</option>}</select></label><label>From date<input type="date" name="FromDate" id="hl-from" value="@Model.Input.FromDate?.ToString("yyyy-MM-dd")" min="2000-01-01" max="2100-12-31" required/></label><label>To date<input type="date" name="ToDate" id="hl-to" value="@Model.Input.ToDate?.ToString("yyyy-MM-dd")" min="2000-01-01" max="2100-12-31" required/></label><label id="hl-session" hidden>Half day session<select name="HalfDaySession"><option value="First" selected="@(Model.Input.HalfDaySession=="First")">1st Half</option><option value="Second" selected="@(Model.Input.HalfDaySession=="Second")">2nd Half</option></select></label><label data-hl-short hidden>Short leave from<input type="time" name="ShortLeaveFrom" value="@Model.Input.ShortLeaveFrom?.ToString("HH:mm")"/></label><label data-hl-short hidden>Short leave to<input type="time" name="ShortLeaveTo" value="@Model.Input.ShortLeaveTo?.ToString("HH:mm")"/></label></div>
<p class="hl-manager" id="hl-manager" role="status">Select an employee to see the reporting manager.</p>
<p class="fd-muted" id="hl-facility" hidden>Extra paid facility: up to 2 Half Days and 2 Short Leaves per month. Each Short Leave is at most 2 hours. No EL/CL/ML/EW deduction.</p>
<label>Employee's reason / information received<textarea name="Reason" maxlength="500" rows="4" required placeholder="Record the reason shared by the employee">@Model.Input.Reason</textarea></label>
<button type="submit" class="fd-primary"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Submit to Reporting Manager</button>
</form></section>}
<section class="fd-panel hl-history"><h2>Recent HR-submitted leave applications</h2><p class="fd-muted">Latest 100 applications. Use All Leave Status to search the complete history.</p>
@if(Model.Requests.Count==0){<div class="fd-empty"><i class="fa-regular fa-calendar" aria-hidden="true"></i><h3>No applications yet</h3></div>}else{<div class="fd-table-scroll"><table class="fd-table"><thead><tr><th>Employee</th><th>Leave</th><th>Reporting manager</th><th>Status &amp; source</th></tr></thead><tbody>@foreach(var request in Model.Requests){<tr><td><strong>@request.Employee.FullName</strong><small>@request.Employee.EmployeeCode · @request.Employee.Department</small></td><td><strong>@request.LeaveType</strong><small>@request.FromDate.ToString("dd MMM yyyy") – @request.ToDate.ToString("dd MMM yyyy")</small><p class="fd-comment">@request.Reason</p></td><td>@request.AssignedApproverEmployee?.FullName</td><td><span class="fd-badge">@request.DisplayStatus</span><partial name="~/Views/Shared/_LeaveDecisionDetails.cshtml" model="request" /></td></tr>}</tbody></table></div>}
</section></section>
<script src="~/js/hr-leave.js" asp-append-version="true" defer></script>
