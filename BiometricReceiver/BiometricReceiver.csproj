<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>VertexERP-LocalDevelopment</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vertex ERP\Vertex ERP.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- A prior publish could leave a nested receiver bundle in the
		     project directory. It is generated output, never source content. -->
		<None Remove="BiometricReceiver\**\*" />
		<Content Remove="BiometricReceiver\**\*" />

		<None Include="biometric_puller.py"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />

		<None Include="remoteattendance.json"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />

		<None Include="Install-BiometricReceiver-Service.ps1"
			  CopyToOutputDirectory="PreserveNewest"
			  CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Settings.job">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>
