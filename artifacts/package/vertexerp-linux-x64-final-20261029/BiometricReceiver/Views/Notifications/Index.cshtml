@model VertexERP.Models.NotificationInboxViewModel
@{ Layout = "~/Views/Shared/_LayoutMaster.cshtml"; ViewData["Title"] = "Notifications"; }
<section class="ni-workspace">
    @if (TempData["NotificationMessage"] is string notice) { <p class="ni-empty" role="status">@notice</p> }
    <header class="ni-hero"><div><span class="ni-eyebrow">YOUR NOTIFICATION INBOX</span><h1>Notifications <span class="ni-total">@Model.UnreadCount unread</span></h1><p>Assignments, responses, approvals and updates for your account.</p></div><form asp-action="MarkRead" method="post"><input type="hidden" name="all" value="true"/><button class="ni-button" type="submit" disabled="@(Model.UnreadCount == 0)"><i class="fa-solid fa-check-double" aria-hidden="true"></i> Mark all as read</button></form></header>
    <form asp-action="Index" method="get" class="ni-filter"><label>Category<select name="category"><option value="">All categories</option>@foreach(var category in new[]{"Tasks","Leave","Queries","Expenses","Reports","Feedback","Assets","Documents","Salary","Bank Requests"}) { <option selected="@(category == Model.Category)" value="@category">@category</option> }</select></label><label>Show<select name="unread"><option value="false" selected="@(!Model.UnreadOnly)">All notifications</option><option value="true" selected="@Model.UnreadOnly">Unread only</option></select></label><button class="ni-button" type="submit">Apply</button><a asp-action="Index">Reset</a></form>
    <div class="ni-list" aria-label="Notifications">
    @if(Model.Items.Count == 0) { <div class="ni-empty"><i class="fa-regular fa-bell" aria-hidden="true"></i><h2>You're all caught up</h2><p>No notifications match this view.</p></div> }
    @foreach(var item in Model.Items) {
        <article class="ni-item @(item.IsRead ? "read" : "unread")"><span class="ni-icon"><i class="fa-solid @(item.Category switch { "Leave" => "fa-plane-departure", "Queries" => "fa-comments", "Expenses" => "fa-receipt", "Assets" => "fa-laptop", "Feedback" => "fa-file-circle-check", _ => "fa-file-lines" })" aria-hidden="true"></i></span><div class="ni-content"><span class="ni-category">@item.Category · @(item.IsRead ? "Read" : "New")</span><h2>@item.Title</h2><p>@item.Detail</p><time datetime="@item.AtUtc.ToString("O")">@item.AtUtc.AddMinutes(330).ToString("dd MMM yyyy · hh:mm tt") IST</time></div><div class="ni-actions"><form asp-action="Open" method="post"><input type="hidden" name="key" value="@item.Key"/><button type="submit" class="ni-button">Open <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></form><form asp-action="MarkRead" method="post"><input type="hidden" name="key" value="@item.Key"/><input type="hidden" name="unread" value="@item.IsRead.ToString().ToLowerInvariant()"/><button type="submit" class="ni-read">@(item.IsRead ? "Mark unread" : "Mark read")</button></form></div></article>
    }
    </div>
    @if(Model.TotalPages > 1) { <nav class="ni-pagination" aria-label="Notification pages">@if(Model.Page > 1){<a asp-action="Index" asp-route-category="@Model.Category" asp-route-unread="@Model.UnreadOnly" asp-route-page="@(Model.Page-1)">Previous</a>}<span>Page @Model.Page of @Model.TotalPages</span>@if(Model.Page < Model.TotalPages){<a asp-action="Index" asp-route-category="@Model.Category" asp-route-unread="@Model.UnreadOnly" asp-route-page="@(Model.Page+1)">Next</a>}</nav> }
</section>
