@model VertexERP.Models.EmployeeAttendanceViewModel
@{ ViewData["Title"] = "My Attendance"; Layout = "~/Views/Shared/_LayoutMaster.cshtml"; }
<link href="~/css/EmployeeSections.css" rel="stylesheet" asp-append-version="true" />
<section class="employee-section">
<header><div><h1>My Attendance</h1><p data-no-localize>@Model.Employee.FullName (@Model.Employee.EmployeeCode)</p><p data-no-localize>@Model.Employee.Department · @Model.Employee.Designation</p></div><a class="btn btn-secondary" asp-action="EmployeeProfile">View Complete Profile</a></header>
<p><span>Shift Hours</span>: @Model.Employee.ShiftStartTime.ToString("hh:mm tt") – @Model.Employee.ShiftEndTime.ToString("hh:mm tt")</p>
<form method="get" asp-action="EmployeeAttendance" class="attendance-filters employee-panel">
<label>From Date<input type="date" name="fromDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" required /></label>
<label>To Date<input type="date" name="toDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" required /></label>
<label>Status<select name="status"><option value="">All Statuses</option>@foreach(var value in new[]{"Present","Late","Absent","Leave","Holiday"}){<option value="@value" selected="@(Model.StatusFilter==value)">@value</option>}</select></label>
<label>Source<select name="source"><option value="">All Sources</option>@foreach(var value in new[]{"Punch","Field Attendance"}){<option value="@value" selected="@(Model.SourceFilter==value)">@value</option>}</select></label>
<button class="btn btn-primary" type="submit">Apply Filters</button><a class="btn btn-secondary" asp-action="EmployeeAttendance">Reset</a>
</form>
<p id="attendance-refresh-status" role="status">Live · refreshes every 15 seconds</p>
<div id="employee-attendance-content"><partial name="_EmployeeAttendanceContent" model="Model" /></div>
</section>
<script src="~/js/employee-attendance-history.js" asp-append-version="true" defer></script>
