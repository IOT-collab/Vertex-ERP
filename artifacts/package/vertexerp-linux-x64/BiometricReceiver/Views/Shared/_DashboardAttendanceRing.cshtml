@model VertexERP.Models.DashboardViewModel
@using System.Globalization
@{
    // Present includes late arrivals; the donut needs mutually exclusive slices.
    var latePresent = Math.Clamp(Model.LateToday, 0, Model.PresentToday);
    var segments = new[] { ("#20d695", Model.PresentToday - latePresent), ("#199aff", latePresent), ("#ffb52e", Model.OnLeaveToday), ("#ff435a", Model.AbsentToday) };
    var sum = Math.Max(1, segments.Sum(segment => segment.Item2));
    double offset = 0;
}
<div class="attendance-donut" role="img" aria-label="Today's attendance split">
    <svg viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="60" r="49" fill="none" stroke="var(--studio-border)" stroke-width="13" />
        @foreach (var segment in segments)
        {
            var length = segment.Item2 * 100d / sum;
            <circle cx="60" cy="60" r="49" fill="none" stroke="@segment.Item1" stroke-width="13" pathLength="100" stroke-dasharray="@(length.ToString("0.###", CultureInfo.InvariantCulture)) 100" stroke-dashoffset="@((-offset).ToString("0.###", CultureInfo.InvariantCulture))" transform="rotate(-90 60 60)" />
            offset += length;
        }
    </svg>
    <div><strong>@Model.AttendanceRosterCount</strong><small>Total</small></div>
</div>
